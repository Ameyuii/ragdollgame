        public void ToggleAllUI()
        {
            allUIVisible = !allUIVisible;
            SetAllUIVisibility(allUIVisible);
            
            Debug.Log($"🎛️ Toggle CHỈ UI: {(allUIVisible ? "BẬT" : "TẮT")} - Characters KHÔNG bị ảnh hưởng");
        }

