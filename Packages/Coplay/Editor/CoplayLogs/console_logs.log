using UnityEngine.UI;

public class TestTeamUI
{
    public static void Execute()
    {
        Debug.Log("=== TESTING TEAM UI FUNCTIONALITY ===");
        
        // Find TeamSelectionHandler
        TeamSelectionHandler teamHandler = Object.FindObjectOfType<TeamSelectionHandler>();
        BattleGameManager gameManager = Object.FindObjectOfType<BattleGameManager>();
        
        if (teamHandler == null || gameManager == null)
        {
            Debug.LogError("Required components not found!");
            return;
        }
        
        Debug.Log($"Current state - TeamHandler: {teamHandler.selectedTeam}, GameManager: {gameManager.selectedTeam}");
        
        // Test switching between teams
        Debug.Log("Testing team switch to Team 1...");
        teamHandler.SelectTeam(1);
        Debug.Log($"After Team 1 - TeamHandler: {teamHandler.selectedTeam}, GameManager: {gameManager.selectedTeam}");
        
        Debug.Log("Testing team switch to Team 3...");
        teamHandler.SelectTeam(3);
        Debug.Log($"After Team 3 - TeamHandler: {teamHandler.selectedTeam}, GameManager: {gameManager.selectedTeam}");
        
        Debug.Log("Testing team switch to Team 4...");
        teamHandler.SelectTeam(4);
        Debug.Log($"After Team 4 - TeamHandler: {teamHandler.selectedTeam}, GameManager: {gameManager.selectedTeam}");
        
        // Test invalid team
        Debug.Log("Testing invalid team (Team 5)...");
        teamHandler.SelectTeam(5);
        Debug.Log($"After invalid - TeamHandler: {teamHandler.selectedTeam}, GameManager: {gameManager.selectedTeam}");
        
        // Reset to Team 1
        Debug.Log("Resetting to Team 1...");
        teamHandler.SelectTeam(1);
        Debug.Log($"Final state - TeamHandler: {teamHandler.selectedTeam}, GameManager: {gameManager.selectedTeam}");
        
        // Check UI text updates
        Text dropdownText = GameObject.Find("TeamDropdownButton/Text")?.GetComponent<Text>();
        Text selectedText = GameObject.Find("SelectedTeamDisplay/Text")?.GetComponent<Text>();
        
        if (dropdownText != null)
            Debug.Log($"Dropdown text: '{dropdownText.text}'");
        
        if (selectedText != null)
            Debug.Log($"Selected display text: '{selectedText.text}'");
        
        Debug.Log("=== TEST COMPLETE ===");
    }
}
