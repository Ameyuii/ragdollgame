                if (rb != mainRigidbody)
                {
                    rb.isKinematic = !ragdollEnabled;
                    
                    if (ragdollEnabled)
                    {
                        // Setup physics properties for better ragdoll behavior
                        rb.useGravity = true;
                        rb.linearDamping = 2f; // Air resistance
                        rb.angularDamping = 5f; // Rotational resistance
                        rb.mass = 1f; // Reasonable mass
                        
                        // Limit velocity to prevent excessive flying
                        if (rb.linearVelocity.magnitude > 10f)
                        {
                            rb.linearVelocity = rb.linearVelocity.normalized * 10f;
                        }
                    }
                    else
                    {
                        // Reset physics when disabling ragdoll
                        rb.linearVelocity = Vector3.zero;
                        rb.angularVelocity = Vector3.zero;
                        rb.linearDamping = 0f;
                        rb.angularDamping = 0.05f;
                    }
                }
            }
        }
        
        if (ragdollColliders != null)
        {
            foreach (Collider col in ragdollColliders)
            {
                if (col != mainCollider)
                {
                    col.enabled = ragdollEnabled;
                }
            }
        }
    }
    
    void Die()
    {
        isDead = true;
        
        // Trigger death animation
        if (animator != null)
        {
            animator.SetTrigger("Death");
            animator.SetBool("IsAlive", false);
        }
        
        // Delay ragdoll activation to let death animation play
        StartCoroutine(DelayedRagdollActivation());
        
        // Notify GameManager
        if (GameManager.Instance != null)
        {
            GameManager.Instance.OnCharacterDied(this);
        }
        
        // Destroy after some time
        Destroy(gameObject, 10f);
    }
    
