            rect.offsetMin = Vector2.zero;
            rect.offsetMax = Vector2.zero;
            
            // Add background
            Image bg = controlsPanel.GetComponent<Image>();
            bg.color = new Color(0.1f, 0.1f, 0.1f, 0.8f);
        }
    }
    
