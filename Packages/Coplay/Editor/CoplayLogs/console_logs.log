    void SetRagdollState(bool ragdollEnabled)
    {
        isRagdoll = ragdollEnabled;
        
        if (animator != null)
            animator.enabled = !ragdollEnabled;
        
        if (mainRigidbody != null)
            mainRigidbody.isKinematic = ragdollEnabled;
        
        if (mainCollider != null)
            mainCollider.enabled = !ragdollEnabled;
        
        // Enable/disable ragdoll rigidbodies and colliders
        if (ragdollRigidbodies != null)
        {
            foreach (Rigidbody rb in ragdollRigidbodies)
