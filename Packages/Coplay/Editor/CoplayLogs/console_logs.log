[INFO] Func: write_to_file Args: path: Assets/Scripts/CharacterSystem/DatabaseSetup.cs, content: using UnityEngine;

/// <summary>
/// Simple database setup theo thiết kế tài liệu - Phase 1
/// </summary>
public class DatabaseSetup : MonoBehaviour
{
    public static void Execute()
    {
        CreateDatabases();
    }

    [ContextMenu("Create Databases")]
    public static void CreateDatabases()
    {
        // Tạo Character Database
        CharacterDatabase charDB = ScriptableObject.CreateInstance<CharacterDatabase>();
        
        // Thêm categories mặc định theo thiết kế
        charDB.categories.Add(new CharacterCategory("warrior", "Warriors", "Strong melee fighters"));
        charDB.categories.Add(new CharacterCategory("archer", "Archers", "Ranged attackers"));
        charDB.categories.Add(new CharacterCategory("mage", "Mages", "Magic users"));

        // Tạo Game Database
        GameDatabase gameDB = ScriptableObject.CreateInstance<GameDatabase>();
        gameDB.characterDatabase = charDB;
        gameDB.enableNewSystem = false; // Bắt đầu với legacy để không làm hỏng UI hiện tại

        #if UNITY_EDITOR
        // Lưu databases
        UnityEditor.AssetDatabase.CreateAsset(charDB, "Assets/Resources/CharacterDatabase.asset");
        UnityEditor.AssetDatabase.CreateAsset(gameDB, "Assets/Resources/GameDatabase.asset");
        UnityEditor.AssetDatabase.SaveAssets();

        Debug.Log("✅ Databases created successfully!");
        Debug.Log("- CharacterDatabase: 3 categories");
        Debug.Log("- GameDatabase: New system disabled (maintains UI compatibility)");
        #endif
    }
}
