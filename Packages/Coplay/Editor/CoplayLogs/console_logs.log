[INFO] Func: write_to_file Args: path: Assets/Scripts/TestDragDropWithTeam.cs, content: using UnityEngine;

public class TestDragDropWithTeam
{
    public static void Execute()
    {
        Debug.Log("=== TESTING DRAG DROP WITH TEAM SELECTION ===");
        
        TeamSelectionHandler teamHandler = Object.FindObjectOfType<TeamSelectionHandler>();
        BattleGameManager gameManager = Object.FindObjectOfType<BattleGameManager>();
        MapStateManager mapManager = MapStateManager.Instance;
        
        if (teamHandler == null || gameManager == null || mapManager == null)
        {
            Debug.LogError("Required components not found!");
            return;
        }
        
        // Test 1: Switch to Team 1 and spawn character
        Debug.Log("Test 1: Switch to Team 1 and spawn character");
        teamHandler.SelectTeam(1);
        Debug.Log($"Current team: {gameManager.selectedTeam}");
        
        // Simulate spawn at position
        Vector3 spawnPos1 = new Vector3(2, 0, 2);
        GameObject prefab = Resources.Load<GameObject>("CompleteCharacter");
        if (prefab != null)
        {
            string instanceId1 = mapManager.AddCharacterInstance("CompleteCharacter", spawnPos1, gameManager.selectedTeam, prefab);
            Debug.Log($"Spawned character {instanceId1} for team {gameManager.selectedTeam}");
        }
        
        // Test 2: Switch to Team 2 and spawn character
        Debug.Log("Test 2: Switch to Team 2 and spawn character");
        teamHandler.SelectTeam(2);
        Debug.Log($"Current team: {gameManager.selectedTeam}");
        
        Vector3 spawnPos2 = new Vector3(-2, 0, 2);
        if (prefab != null)
        {
            string instanceId2 = mapManager.AddCharacterInstance("CompleteCharacter", spawnPos2, gameManager.selectedTeam, prefab);
            Debug.Log($"Spawned character {instanceId2} for team {gameManager.selectedTeam}");
        }
        
        // Test 3: Switch back to Team 1 - should still work
        Debug.Log("Test 3: Switch back to Team 1 after spawning");
        teamHandler.SelectTeam(1);
        Debug.Log($"Team selection after spawning: {gameManager.selectedTeam}");
        
        // Check if UI still updates
        UnityEngine.UI.Text dropdownText = GameObject.Find("TeamDropdownButton/Text")?.GetComponent<UnityEngine.UI.Text>();
        if (dropdownText != null)
            Debug.Log($"UI Text after spawning: '{dropdownText.text}'");
        
        // List all spawned characters
        Debug.Log("Current map state:");
        foreach (var instance in mapManager.characterInstances)
        {
            Debug.Log($"  - {instance.instanceID}: {instance.characterType} at {instance.position} for team {instance.teamId}");
        }
        
        Debug.Log("=== DRAG DROP WITH TEAM TEST COMPLETE ===");
    }
}
