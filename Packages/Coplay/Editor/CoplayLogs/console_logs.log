public class StartRagdollBattle : MonoBehaviour
{
    public static void Execute()
    {
        // Find GameManager and start battle
        GameManager gameManager = FindObjectOfType<GameManager>();
        if (gameManager != null)
        {
            Debug.Log("Starting Ragdoll Battle!");
            gameManager.StartBattle();
            
            // Wait a moment then show battle status
            Debug.Log("Battle started! Characters should be spawning and fighting!");
            Debug.Log("Blue team vs Red team - watch the ragdoll physics in action!");
        }
        else
        {
            Debug.LogError("GameManager not found!");
        }
    }
}
