public class TestCharacterCreation : MonoBehaviour
{
    [Header("Test Settings")]
    public bool autoCreateOnStart = true;

    void Start()
    {
        if (autoCreateOnStart)
        {
            CreateTestDatabase();
        }
    }

    public static void Execute()
    {
        TestCharacterCreation creator = new TestCharacterCreation();
        creator.CreateTestDatabase();
    }

    public void CreateTestDatabase()
    {
        // Create Character Database
        NewCharacterDatabase database = ScriptableObject.CreateInstance<NewCharacterDatabase>();

        // Add default categories
        database.categories.Add(new CharacterCategory("warrior", "Warriors", "Strong melee fighters"));
        database.categories.Add(new CharacterCategory("archer", "Archers", "Ranged attackers"));
        database.categories.Add(new CharacterCategory("mage", "Mages", "Magic users"));

        // Create a test character definition
        CharacterDefinition testWarrior = CreateTestCharacterDefinition();
        database.characters.Add(testWarrior);

        // Create Game Database
        GameDatabase gameDatabase = ScriptableObject.CreateInstance<GameDatabase>();
        gameDatabase.characterDatabase = database;
        gameDatabase.enableNewSystem = false; // Start with disabled to maintain UI compatibility

        #if UNITY_EDITOR
        // Save databases
        UnityEditor.AssetDatabase.CreateAsset(database, "Assets/Resources/CharacterDatabase.asset");
        UnityEditor.AssetDatabase.CreateAsset(gameDatabase, "Assets/Resources/GameDatabase.asset");
        UnityEditor.AssetDatabase.CreateAsset(testWarrior, "Assets/CharacterDefinitions/test_warrior_default_01.asset");
        UnityEditor.AssetDatabase.SaveAssets();

        Debug.Log("✅ Character System Database created successfully!");
        Debug.Log($"- Character Database: {database.characters.Count} characters, {database.categories.Count} categories");
        Debug.Log($"- Game Database: New system enabled = {gameDatabase.enableNewSystem}");
        #endif
    }

    private CharacterDefinition CreateTestCharacterDefinition()
    {
        CharacterDefinition warrior = ScriptableObject.CreateInstance<CharacterDefinition>();

        warrior.CharacterID = "warrior_basic_default_01";
        warrior.DisplayName = "Basic Warrior";
        warrior.CategoryID = "warrior";

        // Set base stats
        CharacterStats stats = new CharacterStats();
        stats.maxHealth = 120f;
        stats.attackDamage = 25f;
        stats.moveSpeed = 3.5f;
        stats.attackRange = 2f;
        stats.attackCooldown = 1f;

        // Create default variant
        CharacterVariant defaultVariant = new CharacterVariant();
        defaultVariant.variantID = "default";
        defaultVariant.variantName = "Default";
        defaultVariant.description = "Standard warrior configuration";
        defaultVariant.isDefault = true;
        defaultVariant.statModifiers = new CharacterStats(); // No modifiers

        warrior.Variants.Add(defaultVariant);

        // Set unlock condition
        UnlockCondition unlock = new UnlockCondition();
        unlock.unlockType = UnlockType.AlwaysUnlocked;
        unlock.isUnlocked = true;

        return warrior;
    }
}
