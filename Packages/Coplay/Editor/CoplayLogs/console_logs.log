[INFO] Func: write_to_file Args: path: Assets/Scripts/DebugCategories.cs, content: using UnityEngine;

public class DebugCategories : MonoBehaviour
{
    public static void Execute()
    {
        Debug.Log("=== DEBUG CATEGORIES ===");
        
        CharacterSelectionUI ui = FindObjectOfType<CharacterSelectionUI>();
        if (ui == null)
        {
            Debug.LogError("CharacterSelectionUI not found!");
            return;
        }
        
        // Use reflection to access private categories field
        var categoriesField = typeof(CharacterSelectionUI).GetField("categories", 
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        
        if (categoriesField != null)
        {
            CharacterCategory[] categories = (CharacterCategory[])categoriesField.GetValue(ui);
            
            if (categories != null)
            {
                Debug.Log($"Found {categories.Length} categories:");
                
                for (int i = 0; i < categories.Length; i++)
                {
                    CharacterCategory category = categories[i];
                    Debug.Log($"Category {i}: {category.categoryName}");
                    
                    if (category.characterPrefabs != null)
                    {
                        Debug.Log($"  - Has {category.characterPrefabs.Length} prefabs:");
                        foreach (GameObject prefab in category.characterPrefabs)
                        {
                            if (prefab != null)
                                Debug.Log($"    * {prefab.name}");
                            else
                                Debug.Log($"    * NULL PREFAB");
                        }
                    }
                    else
                    {
                        Debug.Log($"  - characterPrefabs is NULL");
                    }
                }
            }
            else
            {
                Debug.LogError("Categories array is null!");
            }
        }
        else
        {
            Debug.LogError("Could not access categories field!");
        }
        
        // Also check BattleGameManager
        BattleGameManager gameManager = FindObjectOfType<BattleGameManager>();
        if (gameManager != null && gameManager.characterPrefabs != null)
        {
            Debug.Log($"BattleGameManager has {gameManager.characterPrefabs.Length} prefabs:");
            foreach (GameObject prefab in gameManager.characterPrefabs)
            {
                if (prefab != null)
                    Debug.Log($"  - {prefab.name}");
                else
                    Debug.Log($"  - NULL PREFAB");
            }
        }
        
        Debug.Log("=== END DEBUG ===");
    }
}
