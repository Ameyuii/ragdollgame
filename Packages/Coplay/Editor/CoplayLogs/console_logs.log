public class RagdollSetup : MonoBehaviour
{
    [Header("Ragdoll Setup")]
    public bool setupOnStart = true;
    
    void Start()
    {
        if (setupOnStart)
        {
            SetupRagdollPhysics();
        }
    }
    
    [ContextMenu("Setup Ragdoll Physics")]
    public void SetupRagdollPhysics()
    {
        // Add rigidbodies and colliders to all bones
        Transform[] bones = GetComponentsInChildren<Transform>();
        
        foreach (Transform bone in bones)
        {
            // Skip the root object
            if (bone == transform) continue;
            
            // Add Rigidbody if not present
            Rigidbody rb = bone.GetComponent<Rigidbody>();
            if (rb == null)
            {
                rb = bone.gameObject.AddComponent<Rigidbody>();
                rb.mass = 1f;
                rb.drag = 0.1f;
                rb.angularDrag = 0.1f;
            }
            
            // Add Collider if not present
            Collider col = bone.GetComponent<Collider>();
            if (col == null)
            {
                // Use different collider types based on bone name
                if (bone.name.Contains("head") || bone.name.Contains("Head"))
                {
                    SphereCollider sphereCol = bone.gameObject.AddComponent<SphereCollider>();
                    sphereCol.radius = 0.1f;
                }
                else if (bone.name.Contains("hand") || bone.name.Contains("foot") || 
                         bone.name.Contains("Hand") || bone.name.Contains("Foot"))
                {
                    BoxCollider boxCol = bone.gameObject.AddComponent<BoxCollider>();
                    boxCol.size = new Vector3(0.1f, 0.1f, 0.1f);
                }
                else
                {
                    CapsuleCollider capsuleCol = bone.gameObject.AddComponent<CapsuleCollider>();
                    capsuleCol.radius = 0.05f;
                    capsuleCol.height = 0.2f;
                    capsuleCol.direction = 1; // Y-axis
                }
            }
            
            // Add joints for connected bones
            if (bone.parent != null && bone.parent != transform)
            {
                CharacterJoint joint = bone.GetComponent<CharacterJoint>();
                if (joint == null)
                {
                    joint = bone.gameObject.AddComponent<CharacterJoint>();
                    
                    Rigidbody parentRb = bone.parent.GetComponent<Rigidbody>();
                    if (parentRb != null)
                    {
                        joint.connectedBody = parentRb;
                    }
                    
                    // Set joint limits
                    joint.swing1Limit = new SoftJointLimit { limit = 30f };
                    joint.swing2Limit = new SoftJointLimit { limit = 30f };
                    joint.highTwistLimit = new SoftJointLimit { limit = 20f };
                    joint.lowTwistLimit = new SoftJointLimit { limit = -20f };
                }
            }
        }
        
        Debug.Log("Ragdoll physics setup completed for " + gameObject.name);
    }
    
    [ContextMenu("Remove Ragdoll Physics")]
    public void RemoveRagdollPhysics()
    {
        Transform[] bones = GetComponentsInChildren<Transform>();
        
        foreach (Transform bone in bones)
        {
            if (bone == transform) continue;
            
            // Remove components
            Rigidbody rb = bone.GetComponent<Rigidbody>();
            if (rb != null) DestroyImmediate(rb);
            
            CharacterJoint joint = bone.GetComponent<CharacterJoint>();
            if (joint != null) DestroyImmediate(joint);
            
            // Keep colliders but you can remove them if needed
            // Collider col = bone.GetComponent<Collider>();
            // if (col != null) DestroyImmediate(col);
        }
        
        Debug.Log("Ragdoll physics removed from " + gameObject.name);
    }
}
