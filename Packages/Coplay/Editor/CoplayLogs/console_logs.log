    Transform FindHeadBone(Transform parent)
    {
        // Search for head bone in the hierarchy
        Transform[] allChildren = parent.GetComponentsInChildren<Transform>();
        
        foreach (Transform child in allChildren)
        {
            if (child.name.ToLower().Contains("head"))
            {
                return child;
            }
        }
        
        return null;
    }
    
    void Update()
    {
        if (isDead || isRagdoll) return;
        
        // Update health bar to always stay above head and face camera
        if (healthBarCanvas != null && Camera.main != null)
        {
            // Find head bone and position health bar above it
            Transform headBone = FindHeadBone(transform);
            if (headBone != null)
            {
                healthBarCanvas.transform.position = headBone.position + Vector3.up * 0.2f;
            }
            else
            {
                // Fallback to character position + offset
                healthBarCanvas.transform.position = transform.position + Vector3.up * 2.2f;
            }
            
            // Always face camera
            healthBarCanvas.transform.LookAt(Camera.main.transform);
            healthBarCanvas.transform.Rotate(0, 180, 0);
        }
        
        // Find nearest enemy
        FindNearestEnemy();
        
        // Move towards enemy and attack
        if (target != null)
        {
            MoveTowardsTarget();
            TryAttack();
        }
        else
        {
            // Random movement if no target
            RandomMovement();
        }
        
        // Update animator parameters
        UpdateAnimator();
    }
    
    void UpdateAnimator()
    {
        if (animator == null) return;
        
        // Calculate movement speed
        float currentSpeed = 0f;
        if (target != null)
        {
            float distanceToTarget = Vector3.Distance(transform.position, target.position);
            if (distanceToTarget > attackRange)
            {
                currentSpeed = moveSpeed;
            }
        }
        
        // Set animator parameters
        animator.SetFloat("Speed", currentSpeed);
        animator.SetBool("IsAlive", !isDead);
    }
    
    void FindNearestEnemy()
    {
        RagdollCharacter[] allCharacters = Object.FindObjectsByType<RagdollCharacter>(FindObjectsSortMode.None);
        float nearestDistance = Mathf.Infinity;
        Transform? nearestEnemy = null;
        
        foreach (RagdollCharacter character in allCharacters)
        {
            if (character != this && character.team != this.team && !character.isDead)
            {
                float distance = Vector3.Distance(transform.position, character.transform.position);
                if (distance < nearestDistance)
                {
                    nearestDistance = distance;
                    nearestEnemy = character.transform;
                }
            }
        }
        
        target = nearestEnemy;
    }
    
    void MoveTowardsTarget()
    {
        if (target == null) return;
        
        Vector3 direction = (target.position - transform.position).normalized;
        direction.y = 0; // Keep movement on ground
        
        float distanceToTarget = Vector3.Distance(transform.position, target.position);
        
        if (distanceToTarget > attackRange)
        {
            // Move towards target
            transform.position += direction * moveSpeed * Time.deltaTime;
            transform.LookAt(target.position);
        }
    }
    
    void RandomMovement()
    {
        // Simple random movement when no target
        if (Random.Range(0f, 1f) < 0.02f) // 2% chance per frame
        {
            Vector3 randomDirection = new Vector3(Random.Range(-1f, 1f), 0, Random.Range(-1f, 1f)).normalized;
            transform.position += randomDirection * moveSpeed * Time.deltaTime * 0.5f;
        }
    }
    
    void TryAttack()
    {
        if (target == null || Time.time - lastAttackTime < attackCooldown) return;
        
        float distanceToTarget = Vector3.Distance(transform.position, target.position);
        
        if (distanceToTarget <= attackRange)
        {
            Attack();
            lastAttackTime = Time.time;
        }
    }
    
