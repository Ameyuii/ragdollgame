[INFO] Func: write_to_file Args: path: Assets/Scripts/FixUILayout.cs, content: using UnityEngine;
using UnityEngine.UI;

public class FixUILayout : MonoBehaviour
{
    public static void Execute()
    {
        Debug.Log("=== FIXING UI LAYOUT ===");
        
        Canvas canvas = FindObjectOfType<Canvas>();
        if (canvas == null)
        {
            Debug.LogError("Canvas not found!");
            return;
        }
        
        // Remove duplicate UI elements
        RemoveDuplicateElements(canvas.transform);
        
        // Create ModelSelectionPanel if it doesn't exist
        CreateModelSelectionPanel(canvas.transform);
        
        Debug.Log("UI Layout fixed!");
    }
    
    static void RemoveDuplicateElements(Transform canvasTransform)
    {
        // Find all CharacterCategoryPanel objects
        CharacterCategoryPanel[] categoryPanels = FindObjectsOfType<CharacterCategoryPanel>();
        Debug.Log($"Found {categoryPanels.Length} CharacterCategoryPanel components");
        
        // Find duplicate GameObjects by name
        GameObject[] allChildren = new GameObject[canvasTransform.childCount];
        for (int i = 0; i < canvasTransform.childCount; i++)
        {
            allChildren[i] = canvasTransform.GetChild(i).gameObject;
        }
        
        // Remove duplicates
        for (int i = 0; i < allChildren.Length; i++)
        {
            GameObject obj1 = allChildren[i];
            if (obj1 == null) continue;
            
            for (int j = i + 1; j < allChildren.Length; j++)
            {
                GameObject obj2 = allChildren[j];
                if (obj2 == null) continue;
                
                if (obj1.name == obj2.name && obj1 != obj2)
                {
                    Debug.Log($"Removing duplicate: {obj2.name}");
                    DestroyImmediate(obj2);
                    allChildren[j] = null;
                }
            }
        }
    }
    
    static void CreateModelSelectionPanel(Transform canvasTransform)
    {
        // Check if ModelSelectionPanel already exists
        Transform existingPanel = canvasTransform.Find("ModelSelectionPanel");
        if (existingPanel != null)
        {
            Debug.Log("ModelSelectionPanel already exists");
            return;
        }
        
        // Create ModelSelectionPanel
        GameObject modelPanel = new GameObject("ModelSelectionPanel");
        modelPanel.transform.SetParent(canvasTransform, false);
        
        RectTransform rect = modelPanel.AddComponent<RectTransform>();
        rect.anchorMin = new Vector2(0.3f, 0);
        rect.anchorMax = new Vector2(1, 0.6f);
        rect.offsetMin = Vector2.zero;
        rect.offsetMax = Vector2.zero;
        
        Image bg = modelPanel.AddComponent<Image>();
        bg.color = new Color(0.2f, 0.2f, 0.2f, 0.9f);
        
        // Create title area
        CreateTitleArea(modelPanel.transform);
        
        // Create navigation area
        CreateNavigationArea(modelPanel.transform);
        
        // Create model container
        CreateModelContainer(modelPanel.transform);
        
        // Initially hide the panel
        modelPanel.SetActive(false);
        
        Debug.Log("Created ModelSelectionPanel");
    }
    
    static void CreateTitleArea(Transform parent)
    {
        GameObject titleArea = new GameObject("TitleArea");
        titleArea.transform.SetParent(parent, false);
        
        RectTransform rect = titleArea.AddComponent<RectTransform>();
        rect.anchorMin = new Vector2(0, 0.85f);
        rect.anchorMax = new Vector2(1, 1);
        rect.offsetMin = Vector2.zero;
        rect.offsetMax = Vector2.zero;
        
        // Category Title
        GameObject categoryTitle = new GameObject("CategoryTitle");
        categoryTitle.transform.SetParent(titleArea.transform, false);
        
        RectTransform titleRect = categoryTitle.AddComponent<RectTransform>();
        titleRect.anchorMin = new Vector2(0, 0);
        titleRect.anchorMax = new Vector2(0.7f, 1);
        titleRect.offsetMin = new Vector2(20, 0);
        titleRect.offsetMax = Vector2.zero;
        
        Text titleText = categoryTitle.AddComponent<Text>();
        titleText.text = "Chọn danh mục";
        titleText.font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
        titleText.fontSize = 16;
        titleText.fontStyle = FontStyle.Bold;
        titleText.color = Color.white;
        titleText.alignment = TextAnchor.MiddleLeft;
        
        // Page Info
        GameObject pageInfo = new GameObject("PageInfo");
        pageInfo.transform.SetParent(titleArea.transform, false);
        
        RectTransform pageRect = pageInfo.AddComponent<RectTransform>();
        pageRect.anchorMin = new Vector2(0.7f, 0);
        pageRect.anchorMax = new Vector2(1, 1);
        pageRect.offsetMin = Vector2.zero;
        pageRect.offsetMax = new Vector2(-20, 0);
        
        Text pageText = pageInfo.AddComponent<Text>();
        pageText.text = "Trang 1/1";
        pageText.font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
        pageText.fontSize = 12;
        pageText.color = Color.gray;
        pageText.alignment = TextAnchor.MiddleRight;
    }
    
    static void CreateNavigationArea(Transform parent)
    {
        GameObject navArea = new GameObject("NavigationArea");
        navArea.transform.SetParent(parent, false);
        
        RectTransform rect = navArea.AddComponent<RectTransform>();
        rect.anchorMin = new Vector2(0, 0);
        rect.anchorMax = new Vector2(1, 0.15f);
        rect.offsetMin = Vector2.zero;
        rect.offsetMax = Vector2.zero;
        
        // Previous Button
        CreateNavButton(navArea.transform, "PrevButton", "◀ TRƯỚC", new Vector2(0.1f, 0.2f), new Vector2(0.4f, 0.8f));
        
        // Next Button
        CreateNavButton(navArea.transform, "NextButton", "SAU ▶", new Vector2(0.6f, 0.2f), new Vector2(0.9f, 0.8f));
    }
    
    static void CreateNavButton(Transform parent, string name, string text, Vector2 anchorMin, Vector2 anchorMax)
    {
        GameObject button = new GameObject(name);
        button.transform.SetParent(parent, false);
        
        RectTransform rect = button.AddComponent<RectTransform>();
        rect.anchorMin = anchorMin;
        rect.anchorMax = anchorMax;
        rect.offsetMin = Vector2.zero;
        rect.offsetMax = Vector2.zero;
        
        Image bg = button.AddComponent<Image>();
        bg.color = new Color(0.4f, 0.4f, 0.4f, 1f);
        
        Button btn = button.AddComponent<Button>();
        
        // Button text
        GameObject textObj = new GameObject("Text");
        textObj.transform.SetParent(button.transform, false);
        
        RectTransform textRect = textObj.AddComponent<RectTransform>();
        textRect.anchorMin = Vector2.zero;
        textRect.anchorMax = Vector2.one;
        textRect.offsetMin = Vector2.zero;
        textRect.offsetMax = Vector2.zero;
        
        Text buttonText = textObj.AddComponent<Text>();
        buttonText.text = text;
        buttonText.font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
        buttonText.fontSize = 12;
        buttonText.color = Color.white;
        buttonText.alignment = TextAnchor.MiddleCenter;
    }
    
    static void CreateModelContainer(Transform parent)
    {
        GameObject container = new GameObject("ModelContainer");
        container.transform.SetParent(parent, false);
        
        RectTransform rect = container.AddComponent<RectTransform>();
        rect.anchorMin = new Vector2(0, 0.15f);
        rect.anchorMax = new Vector2(1, 0.85f);
        rect.offsetMin = Vector2.zero;
        rect.offsetMax = Vector2.zero;
        
        GridLayoutGroup grid = container.AddComponent<GridLayoutGroup>();
        grid.cellSize = new Vector2(100, 100);
        grid.spacing = new Vector2(10, 10);
        grid.startCorner = GridLayoutGroup.Corner.UpperLeft;
        grid.startAxis = GridLayoutGroup.Axis.Horizontal;
        grid.childAlignment = TextAnchor.UpperCenter;
        grid.constraint = GridLayoutGroup.Constraint.FixedColumnCount;
        grid.constraintCount = 6;
    }
}
