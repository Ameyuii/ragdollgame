            else
            {
                selectedTeamText.text = $"✅ SELECTED: {characterName}\n{teamIcon} {teamName} ({teamCount} placed)\n\n🖱️ Drag anywhere to place\n🚀 UNLIMITED SPAWNING";
            }
        }
