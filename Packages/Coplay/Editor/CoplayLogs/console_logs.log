[INFO] Func: write_to_file Args: path: Assets/Scripts/CharacterSelectionUI.cs, content: using UnityEngine;
using UnityEngine.UI;
using System.Collections.Generic;
using System.Collections;

[System.Serializable]
public class CharacterCategory
{
    public string categoryName;
    public GameObject[] characterPrefabs;
    public Color categoryColor = Color.white;
}

public class CharacterSelectionUI : MonoBehaviour
{
    [Header("UI References")]
    public Canvas mainCanvas;
    public BattleGameManager gameManager;
    
    [Header("Character Categories")]
    public CharacterCategory[] categories;
    
    [Header("UI Settings")]
    public int modelsPerPage = 6;
    public float buttonSpacing = 10f;
    
    // UI Components
    private GameObject leftPanel;
    private GameObject bottomPanel;
    private GameObject modelContainer;
    private GameObject teamSelectionPanel;
    private GameObject teamDropdownPanel;
    private Button prevButton;
    private Button nextButton;
    private Text pageInfoText;
    private Button teamDropdownButton;
    private Text teamDropdownText;
    private Text selectedTeamText;
    private bool isTeamDropdownOpen = false;
    
    // State
    private int selectedCategoryIndex = -1;
    private int currentPage = 0;
    private int totalPages = 0;
    private int selectedTeam = 1;
    private int maxTeams = 4;
    
    void Start()
    {
        if (mainCanvas == null)
            mainCanvas = FindObjectOfType<Canvas>();
        
        if (gameManager == null)
            gameManager = FindObjectOfType<BattleGameManager>();
        
        InitializeCategories();
        CreateUI();
    }
    
    public void RefreshUI()
    {
        Debug.Log("Refreshing CharacterSelectionUI...");
        
        // Clear existing UI
        if (leftPanel != null)
            DestroyImmediate(leftPanel);
        if (bottomPanel != null)
            DestroyImmediate(bottomPanel);
        if (teamSelectionPanel != null)
            DestroyImmediate(teamSelectionPanel);
        
        // Reinitialize
        selectedCategoryIndex = -1;
        currentPage = 0;
        
        InitializeCategories();
        CreateUI();
        
        Debug.Log("CharacterSelectionUI refreshed successfully!");
    }
    
    void InitializeCategories()
    {
        Debug.Log("InitializeCategories called");
        
        // Always recreate categories to ensure fresh data
        List<CharacterCategory> defaultCategories = new List<CharacterCategory>();
        
        // Robot category
        CharacterCategory robotCategory = new CharacterCategory();
        robotCategory.categoryName = "🤖 ROBOT";
        robotCategory.categoryColor = new Color(0.3f, 0.6f, 1f, 1f);
        
        // Monster category  
        CharacterCategory monsterCategory = new CharacterCategory();
        monsterCategory.categoryName = "👹 QUÁI VẬT";
        monsterCategory.categoryColor = new Color(1f, 0.3f, 0.3f, 1f);
        
        // Soldier category
        CharacterCategory soldierCategory = new CharacterCategory();
        soldierCategory.categoryName = "🪖 CHIẾN BINH";
        soldierCategory.categoryColor = new Color(0.3f, 1f, 0.3f, 1f);
        
        // Load prefabs from organized folders first
        List<GameObject> robots = new List<GameObject>();
        List<GameObject> monsters = new List<GameObject>();
        List<GameObject> soldiers = new List<GameObject>();
        
        // Try to load from specific folders in Resources
        GameObject[] robotPrefabs = Resources.LoadAll<GameObject>("Robot");
        GameObject[] monsterPrefabs = Resources.LoadAll<GameObject>("QuaiVat");
        GameObject[] soldierPrefabs = Resources.LoadAll<GameObject>("ChienBinh");
        GameObject[] humanoidPrefabs = Resources.LoadAll<GameObject>("LoaiNhanVat");
        
        robots.AddRange(robotPrefabs);
        monsters.AddRange(monsterPrefabs);
        soldiers.AddRange(soldierPrefabs);
        
        // Add humanoid prefabs to appropriate category or create new one
        if (humanoidPrefabs.Length > 0)
        {
            soldiers.AddRange(humanoidPrefabs); // Add to soldiers for now
        }
        
        // Fallback: Load from gameManager if organized folders are empty
        if (robots.Count == 0 && monsters.Count == 0 && soldiers.Count == 0)
        {
            Debug.Log("No organized prefabs found, using gameManager prefabs");
            if (gameManager != null && gameManager.characterPrefabs != null && gameManager.characterPrefabs.Length > 0)
            {
                foreach (GameObject prefab in gameManager.characterPrefabs)
                {
                    if (prefab != null)
                    {
                        string prefabName = prefab.name.ToLower();
                        
                        // Better categorization based on actual prefab names
                        if (prefabName.Contains("complete") || prefabName.Contains("character"))
                        {
                            robots.Add(prefab);
                            Debug.Log($"Added {prefab.name} to ROBOT category");
                        }
                        else if (prefabName.Contains("npc") || prefabName.Contains("variant"))
                        {
                            monsters.Add(prefab);
                            Debug.Log($"Added {prefab.name} to QUÁI VẬT category");
                        }
                        else if (prefabName.Contains("battle"))
                        {
                            soldiers.Add(prefab);
                            Debug.Log($"Added {prefab.name} to CHIẾN BINH category");
                        }
                        else
                        {
                            // Default fallback - distribute evenly
                            int prefabIndex = System.Array.IndexOf(gameManager.characterPrefabs, prefab);
                            if (prefabIndex % 3 == 0)
                                robots.Add(prefab);
                            else if (prefabIndex % 3 == 1)
                                soldiers.Add(prefab);
                            else
                                monsters.Add(prefab);
                            
                            Debug.Log($"Added {prefab.name} to fallback category (index {prefabIndex})");
                        }
                    }
                }
            }
        }
        
        robotCategory.characterPrefabs = robots.ToArray();
        monsterCategory.characterPrefabs = monsters.ToArray();
        soldierCategory.characterPrefabs = soldiers.ToArray();
        
        // If still no prefabs found, try fallback from all Resources
        if (robots.Count == 0 && monsters.Count == 0 && soldiers.Count == 0)
        {
            GameObject[] resourcePrefabs = Resources.LoadAll<GameObject>("");
            List<GameObject> fallbackPrefabs = new List<GameObject>();
            
            foreach (GameObject prefab in resourcePrefabs)
            {
                if (prefab != null && prefab.GetComponent<RagdollCharacter>() != null)
                {
                    fallbackPrefabs.Add(prefab);
                }
            }
            
            robotCategory.characterPrefabs = fallbackPrefabs.ToArray();
            monsterCategory.characterPrefabs = fallbackPrefabs.ToArray();
            soldierCategory.characterPrefabs = fallbackPrefabs.ToArray();
            
            Debug.LogWarning("No organized prefabs found, using fallback from all Resources");
        }
        
        defaultCategories.Add(robotCategory);
        defaultCategories.Add(monsterCategory);
        defaultCategories.Add(soldierCategory);
        
        categories = defaultCategories.ToArray();
        
        Debug.Log($"Initialized {categories.Length} categories:");
        for (int i = 0; i < categories.Length; i++)
        {
            Debug.Log($"  {categories[i].categoryName}: {categories[i].characterPrefabs.Length} prefabs");
        }
    }
    
    void CreateUI()
    {
        if (mainCanvas == null) return;
        
        CreateLeftPanel();
        CreateBottomPanel();
        CreateTeamSelectionPanel();
    }
    
    void CreateLeftPanel()
    {
        leftPanel = new GameObject("CharacterCategoryPanel");
        leftPanel.transform.SetParent(mainCanvas.transform, false);
        
