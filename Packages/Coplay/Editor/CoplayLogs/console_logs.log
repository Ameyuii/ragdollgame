[INFO] Func: write_to_file Args: path: Assets/Scripts/DragDropTeamFix.cs, content: using UnityEngine;

public class DragDropTeamFix : MonoBehaviour
{
    private TeamSelectionHandler teamHandler;
    
    void Start()
    {
        teamHandler = FindObjectOfType<TeamSelectionHandler>();
        
        // Hook into drag/drop events
        if (teamHandler != null)
        {
            InvokeRepeating("CheckAndFixTeamButton", 1f, 0.5f); // Check every 0.5 seconds
        }
    }
    
    void CheckAndFixTeamButton()
    {
        if (teamHandler != null)
        {
            // Force refresh team selection periodically
            teamHandler.RefreshButtonState();
        }
    }
    
    // Call this method after any drag/drop operation
    public static void OnDragDropComplete()
    {
        Debug.Log("DragDropTeamFix: OnDragDropComplete called");
        
        TeamSelectionHandler handler = FindObjectOfType<TeamSelectionHandler>();
        if (handler != null)
        {
            handler.ForceRefreshTeamSelection();
            handler.RefreshButtonState();
            Debug.Log("Team selection refreshed after drag/drop");
        }
        
        // Also ensure EventSystem is enabled
        UnityEngine.EventSystems.EventSystem eventSystem = FindObjectOfType<UnityEngine.EventSystems.EventSystem>();
        if (eventSystem != null && !eventSystem.enabled)
        {
            eventSystem.enabled = true;
            Debug.Log("Re-enabled EventSystem");
        }
    }
}
