public class SimpleBattleInfo : MonoBehaviour
{
    public static void Execute()
    {
        Debug.Log("=== RAGDOLL BATTLE GAME STATUS ===");
        
        // Count characters
        RagdollCharacter[] allCharacters = FindObjectsOfType<RagdollCharacter>();
        int totalCharacters = 0;
        int team1 = 0;
        int team2 = 0;
        
        foreach (RagdollCharacter character in allCharacters)
        {
            if (character.name != "npc Variant")
            {
                totalCharacters++;
                if (character.team == 0) team1++;
                else if (character.team == 1) team2++;
            }
        }
        
        Debug.Log($"📊 Battle Statistics:");
        Debug.Log($"   🔵 Team 1 (Blue): {team1} fighters");
        Debug.Log($"   🔴 Team 2 (Red): {team2} fighters");
        Debug.Log($"   ⚔️ Total fighters: {totalCharacters}");
        
        if (totalCharacters > 0)
        {
            Debug.Log("✅ Battle is ACTIVE! Characters are fighting with ragdoll physics!");
            Debug.Log("🎮 You can watch the epic ragdoll battle in the Game View!");
            Debug.Log("💡 Switch to Game tab to see the UI and battle action!");
        }
        else
        {
            Debug.Log("⏸️ No battle currently running. Click START BATTLE to begin!");
        }
        
        Debug.Log("=====================================");
    }
}
