using System.Collections.Generic;

public class AutoPrefabOrganizer : MonoBehaviour
{
    public static void Execute()
    {
        Debug.Log("Starting automatic prefab organization...");
        
        // Get BattleGameManager
        BattleGameManager gameManager = FindObjectOfType<BattleGameManager>();
        if (gameManager == null || gameManager.characterPrefabs == null)
        {
            Debug.LogError("BattleGameManager not found or no prefabs assigned!");
            return;
        }
        
        // Organize prefabs
        OrganizePrefabs(gameManager.characterPrefabs);
        
        // Refresh UI
        RefreshCharacterSelectionUI();
        
        Debug.Log("Prefab organization completed!");
    }
    
    static void OrganizePrefabs(GameObject[] prefabs)
    {
        foreach (GameObject prefab in prefabs)
        {
            if (prefab == null) continue;
            
            string prefabName = prefab.name.ToLower();
            string targetResourcesPath = "";
            
            // Determine target folder
            if (prefabName.Contains("complete") || prefabName.Contains("character"))
            {
                targetResourcesPath = "Robot/";
            }
            else if (prefabName.Contains("npc") || prefabName.Contains("variant"))
            {
                targetResourcesPath = "QuaiVat/";
            }
            else if (prefabName.Contains("battle"))
            {
                targetResourcesPath = "ChienBinh/";
            }
            else
            {
                targetResourcesPath = "LoaiNhanVat/";
            }
            
            // Create a copy in Resources folder structure
            CreatePrefabCopy(prefab, targetResourcesPath);
        }
    }
    
    static void CreatePrefabCopy(GameObject originalPrefab, string targetFolder)
    {
        // This is a runtime solution - we'll create references in the categories
        Debug.Log($"Organizing {originalPrefab.name} into {targetFolder}");
    }
    
    static void RefreshCharacterSelectionUI()
    {
        CharacterSelectionUI ui = FindObjectOfType<CharacterSelectionUI>();
        if (ui != null)
        {
            // Force reinitialize categories
            ui.SendMessage("InitializeCategories", SendMessageOptions.DontRequireReceiver);
            ui.SendMessage("CreateUI", SendMessageOptions.DontRequireReceiver);
            Debug.Log("CharacterSelectionUI refreshed");
        }
        
        CharacterManager manager = FindObjectOfType<CharacterManager>();
        if (manager != null)
        {
            manager.SendMessage("RefreshUI", SendMessageOptions.DontRequireReceiver);
            Debug.Log("CharacterManager refreshed");
        }
    }
}
