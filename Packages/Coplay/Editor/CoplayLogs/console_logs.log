public class FixRagdollPhysics : MonoBehaviour
{
    public static void Execute()
    {
        // Find all RagdollCharacter objects
        RagdollCharacter[] characters = Object.FindObjectsByType<RagdollCharacter>(FindObjectsSortMode.None);
        
        foreach (RagdollCharacter character in characters)
        {
            FixCharacterPhysics(character);
        }
        
        Debug.Log($"Fixed physics for {characters.Length} characters!");
    }
    
    static void FixCharacterPhysics(RagdollCharacter character)
    {
        // Get all rigidbodies in the character
        Rigidbody[] allRigidbodies = character.GetComponentsInChildren<Rigidbody>();
        
        foreach (Rigidbody rb in allRigidbodies)
        {
            // Skip the main rigidbody
            if (rb == character.GetComponent<Rigidbody>()) continue;
            
            // Set better physics properties
            rb.useGravity = true;
            rb.drag = 2f; // Air resistance to prevent excessive bouncing
            rb.angularDrag = 5f; // Rotational resistance
            rb.mass = 1f; // Reasonable mass
            
            // Ensure they're not flying around
            if (rb.velocity.magnitude > 10f)
            {
                rb.velocity = rb.velocity.normalized * 10f;
            }
            
            // Limit upward velocity
            if (rb.velocity.y > 5f)
            {
                rb.velocity = new Vector3(rb.velocity.x, 5f, rb.velocity.z);
            }
            
            // Add downward force if they're floating
            if (rb.transform.position.y > 3f)
            {
                rb.AddForce(Vector3.down * 200f, ForceMode.Force);
            }
        }
        
        // Reset character to ground if they're floating
        if (character.transform.position.y > 2f)
        {
            RaycastHit hit;
            if (Physics.Raycast(character.transform.position + Vector3.up * 2f, Vector3.down, out hit, 10f))
            {
                character.transform.position = hit.point + Vector3.up * 0.1f;
            }
            else
            {
                // Fallback: move to ground level
                character.transform.position = new Vector3(
                    character.transform.position.x, 
                    0.1f, 
                    character.transform.position.z
                );
            }
        }
        
        Debug.Log($"Fixed physics for {character.name}");
    }
}
