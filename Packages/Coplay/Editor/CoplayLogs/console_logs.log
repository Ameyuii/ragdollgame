using UnityEngine.UI;
using System.Collections.Generic;

public class TeamSelectionHandler : MonoBehaviour
{
    [Header("Team Settings")]
    public int maxTeams = 4;
    public int selectedTeam = 1;
    
    private Button teamDropdownButton;
    private Text teamDropdownText;
    private Text selectedTeamText;
    private GameObject dropdownPanel;
    private bool isDropdownOpen = false;
    
    private BattleGameManager gameManager;
    
    void Start()
    {
        gameManager = FindObjectOfType<BattleGameManager>();
        SetupTeamSelection();
    }
    
    void SetupTeamSelection()
    {
        Canvas canvas = FindObjectOfType<Canvas>();
        if (canvas == null) return;
        
        // Find team selection components
        Transform teamSelectionPanel = canvas.transform.Find("TeamSelectionPanel");
        if (teamSelectionPanel == null)
        {
            Debug.LogError("TeamSelectionPanel not found!");
            return;
        }
        
        // Find dropdown button
        Transform dropdownButtonTransform = teamSelectionPanel.Find("TeamDropdownButton");
        if (dropdownButtonTransform != null)
        {
            teamDropdownButton = dropdownButtonTransform.GetComponent<Button>();
            teamDropdownText = dropdownButtonTransform.GetComponentInChildren<Text>();
            
            if (teamDropdownButton != null)
            {
                // Clear existing listeners and add new one
                teamDropdownButton.onClick.RemoveAllListeners();
                teamDropdownButton.onClick.AddListener(ToggleTeamDropdown);
                Debug.Log("Team dropdown button setup complete");
            }
        }
        
        // Find selected team display
        Transform selectedTeamDisplay = teamSelectionPanel.Find("SelectedTeamDisplay");
        if (selectedTeamDisplay == null)
        {
            // Try alternative path
            selectedTeamDisplay = canvas.transform.Find("SelectedTeamDisplay");
        }
        
        if (selectedTeamDisplay != null)
        {
            selectedTeamText = selectedTeamDisplay.GetComponentInChildren<Text>();
        }
        
        // Update initial display
        UpdateTeamDisplay();
        
        // Update game manager
        if (gameManager != null)
        {
            gameManager.selectedTeam = selectedTeam;
        }
    }
    
    void ToggleTeamDropdown()
    {
        Debug.Log("ToggleTeamDropdown called");
        
        isDropdownOpen = !isDropdownOpen;
        
        if (isDropdownOpen)
        {
            CreateDropdownPanel();
        }
        else
        {
            DestroyDropdownPanel();
        }
    }
    
    void CreateDropdownPanel()
    {
        if (dropdownPanel != null)
        {
            DestroyImmediate(dropdownPanel);
        }
        
        Canvas canvas = FindObjectOfType<Canvas>();
        if (canvas == null) return;
        
        Transform teamSelectionPanel = canvas.transform.Find("TeamSelectionPanel");
        if (teamSelectionPanel == null) return;
        
        // Create dropdown panel
        dropdownPanel = new GameObject("TeamDropdownPanel");
        dropdownPanel.transform.SetParent(teamSelectionPanel, false);
        
        RectTransform rect = dropdownPanel.AddComponent<RectTransform>();
        rect.anchorMin = new Vector2(0.7f, 0.3f);
        rect.anchorMax = new Vector2(1f, 0.7f);
        rect.offsetMin = new Vector2(-5, 0);
        rect.offsetMax = new Vector2(-5, 0);
        
        Image bg = dropdownPanel.AddComponent<Image>();
        bg.color = new Color(0.1f, 0.1f, 0.1f, 0.95f);
        
        // Create team options
        for (int i = 1; i <= maxTeams; i++)
        {
            CreateTeamOption(i);
        }
        
        Debug.Log($"Created dropdown panel with {maxTeams} team options");
    }
    
    void CreateTeamOption(int teamNumber)
    {
        GameObject optionObj = new GameObject($"TeamOption_{teamNumber}");
        optionObj.transform.SetParent(dropdownPanel.transform, false);
        
        RectTransform rect = optionObj.AddComponent<RectTransform>();
        float optionHeight = 1f / maxTeams;
        rect.anchorMin = new Vector2(0, 1f - teamNumber * optionHeight);
        rect.anchorMax = new Vector2(1, 1f - (teamNumber - 1) * optionHeight);
        rect.offsetMin = Vector2.zero;
        rect.offsetMax = Vector2.zero;
        
        Image bg = optionObj.AddComponent<Image>();
        bg.color = teamNumber == selectedTeam ? 
            new Color(0.3f, 0.6f, 1f, 1f) : 
            new Color(0.2f, 0.2f, 0.2f, 1f);
        
        Button button = optionObj.AddComponent<Button>();
        button.onClick.AddListener(() => SelectTeam(teamNumber));
        
        // Add hover effect
        ColorBlock colors = button.colors;
        colors.normalColor = bg.color;
        colors.highlightedColor = new Color(0.4f, 0.7f, 1f, 1f);
        colors.pressedColor = new Color(0.2f, 0.5f, 0.9f, 1f);
        button.colors = colors;
        
        // Option text
        GameObject textObj = new GameObject("Text");
        textObj.transform.SetParent(optionObj.transform, false);
        
        RectTransform textRect = textObj.AddComponent<RectTransform>();
        textRect.anchorMin = Vector2.zero;
        textRect.anchorMax = Vector2.one;
        textRect.offsetMin = Vector2.zero;
        textRect.offsetMax = Vector2.zero;
        
        Text text = textObj.AddComponent<Text>();
        text.text = $"ĐỘI {teamNumber}";
        text.font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
        text.fontSize = 12;
        text.fontStyle = FontStyle.Bold;
        text.color = Color.white;
        text.alignment = TextAnchor.MiddleCenter;
    }
    
    void DestroyDropdownPanel()
    {
        if (dropdownPanel != null)
        {
            DestroyImmediate(dropdownPanel);
            dropdownPanel = null;
        }
    }
    
    public void SelectTeam(int teamNumber)
    {
        Debug.Log($"SelectTeam called with team: {teamNumber}");
        
        if (teamNumber < 1 || teamNumber > maxTeams)
        {
            Debug.LogError($"Invalid team number: {teamNumber}");
            return;
        }
        
        selectedTeam = teamNumber;
        
        // Update UI display
        UpdateTeamDisplay();
        
        // Update game manager
        if (gameManager != null)
        {
            gameManager.selectedTeam = selectedTeam;
            Debug.Log($"Updated BattleGameManager selectedTeam to: {selectedTeam}");
        }
        
        // Close dropdown
        isDropdownOpen = false;
        DestroyDropdownPanel();
        
        Debug.Log($"Team selection changed to: {selectedTeam}");
    }
    
    void UpdateTeamDisplay()
    {
        // Update dropdown button text
        if (teamDropdownText != null)
        {
            teamDropdownText.text = $"ĐỘI {selectedTeam} ▼";
        }
        
        // Update selected team display text
        if (selectedTeamText != null)
        {
            selectedTeamText.text = $"ĐỘI {selectedTeam} ĐƯỢC CHỌN - Kéo thả nhân vật vào bản đồ";
        }
        
        // Update dropdown button color based on team
        if (teamDropdownButton != null)
        {
            Image buttonImage = teamDropdownButton.GetComponent<Image>();
            if (buttonImage != null)
            {
                Color teamColor = GetTeamColor(selectedTeam);
                buttonImage.color = teamColor;
            }
        }
    }
    
    Color GetTeamColor(int team)
    {
        switch (team)
        {
            case 1: return new Color(0.2f, 0.4f, 0.8f, 1f); // Blue
            case 2: return new Color(0.8f, 0.2f, 0.2f, 1f); // Red
            case 3: return new Color(0.2f, 0.8f, 0.2f, 1f); // Green
            case 4: return new Color(0.8f, 0.8f, 0.2f, 1f); // Yellow
            default: return new Color(0.2f, 0.4f, 0.8f, 1f); // Default blue
        }
    }
    
    // Public method to get current selected team
    public int GetSelectedTeam()
    {
        return selectedTeam;
    }
    
    // Public method to set team programmatically
    public void SetTeam(int teamNumber)
    {
        if (teamNumber >= 1 && teamNumber <= maxTeams)
        {
            SelectTeam(teamNumber);
        }
    }
    
    void Update()
    {
        // Close dropdown if clicked outside
        if (isDropdownOpen && Input.GetMouseButtonDown(0))
        {
            Vector2 mousePos = Input.mousePosition;
            
            if (dropdownPanel != null)
            {
                RectTransform dropdownRect = dropdownPanel.GetComponent<RectTransform>();
                if (!RectTransformUtility.RectangleContainsScreenPoint(dropdownRect, mousePos))
                {
                    // Check if clicked on dropdown button
                    if (teamDropdownButton != null)
                    {
                        RectTransform buttonRect = teamDropdownButton.GetComponent<RectTransform>();
                        if (!RectTransformUtility.RectangleContainsScreenPoint(buttonRect, mousePos))
                        {
                            isDropdownOpen = false;
                            DestroyDropdownPanel();
                        }
                    }
                }
            }
        }
    }
}
