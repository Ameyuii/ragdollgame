=======
    private CharacterDefinition CreateTestCharacterDefinition()
    {
        CharacterDefinition warrior = ScriptableObject.CreateInstance<CharacterDefinition>();

        warrior.CharacterID = "warrior_basic_default_01";
        warrior.DisplayName = "Basic Warrior";
        warrior.CategoryID = "warrior";

        // Try to load an existing prefab
        GameObject prefab = Resources.Load<GameObject>("CompleteCharacter");
        if (prefab == null)
        {
            prefab = Resources.Load<GameObject>("BattleCharacter");
        }

        // Use reflection to set basePrefab since it's private
        System.Reflection.FieldInfo prefabField = typeof(CharacterDefinition).GetField("basePrefab", 
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        if (prefabField != null && prefab != null)
        {
            prefabField.SetValue(warrior, prefab);
            Debug.Log($"[TestCharacter] Assigned prefab: {prefab.name}");
        }

        // Set base stats
        System.Reflection.FieldInfo statsField = typeof(CharacterDefinition).GetField("baseStats", 
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        if (statsField != null)
        {
            CharacterStats stats = new CharacterStats();
            stats.maxHealth = 120f;
            stats.attackDamage = 25f;
            stats.moveSpeed = 3.5f;
            stats.attackRange = 2f;
            stats.attackCooldown = 1f;
            statsField.SetValue(warrior, stats);
        }

        // Create default variant
        CharacterVariant defaultVariant = new CharacterVariant();
        defaultVariant.variantID = "default";
        defaultVariant.variantName = "Default";
        defaultVariant.description = "Standard warrior configuration";
        defaultVariant.isDefault = true;
        defaultVariant.statModifiers = new CharacterStats(); // No modifiers

        warrior.Variants.Add(defaultVariant);

        // Set unlock condition
        UnlockCondition unlock = new UnlockCondition();
        unlock.unlockType = UnlockType.AlwaysUnlocked;
        unlock.isUnlocked = true;

        // Use reflection to set unlock condition
        System.Reflection.FieldInfo unlockField = typeof(CharacterDefinition).GetField("unlockCondition", 
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        if (unlockField != null)
        {
            unlockField.SetValue(warrior, unlock);
        }

        return warrior;
    }
