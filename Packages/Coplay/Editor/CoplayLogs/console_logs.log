    void Update()
    {
        // Continuously ensure button is functional
        if (teamDropdownButton != null)
        {
            if (!teamDropdownButton.interactable)
            {
                teamDropdownButton.interactable = true;
                Debug.Log("Re-enabled team button in Update");
            }
        }
        
        // Close dropdown if clicked outside (using new Input System)
        if (isDropdownOpen)
        {
            // Check for mouse click using new Input System
            bool mouseClicked = false;
            Vector2 mousePos = Vector2.zero;
            
            try
            {
                // Try to use new Input System
                var mouse = UnityEngine.InputSystem.Mouse.current;
                if (mouse != null && mouse.leftButton.wasPressedThisFrame)
                {
                    mouseClicked = true;
                    mousePos = mouse.position.ReadValue();
                }
            }
            catch
            {
                // Fallback - just close dropdown after a delay if needed
                // This avoids the Input System error
            }
            
            if (mouseClicked && dropdownPanel != null)
            {
                RectTransform dropdownRect = dropdownPanel.GetComponent<RectTransform>();
                if (!RectTransformUtility.RectangleContainsScreenPoint(dropdownRect, mousePos))
                {
                    // Check if clicked on dropdown button
                    if (teamDropdownButton != null)
                    {
                        RectTransform buttonRect = teamDropdownButton.GetComponent<RectTransform>();
                        if (!RectTransformUtility.RectangleContainsScreenPoint(buttonRect, mousePos))
                        {
                            isDropdownOpen = false;
                            DestroyDropdownPanel();
                        }
                    }
                }
            }
        }
    }
    
    void LateUpdate()
    {
        // Additional check in LateUpdate to ensure button remains functional
        if (teamDropdownButton != null)
        {
            // Force button to be interactable
            teamDropdownButton.interactable = true;
            
            // Check if button has lost its listener
            if (teamDropdownButton.onClick.GetPersistentEventCount() == 0)
            {
                teamDropdownButton.onClick.RemoveAllListeners();
                teamDropdownButton.onClick.AddListener(ToggleTeamDropdown);
                Debug.Log("Re-attached button listener in LateUpdate");
            }
        }
    }
