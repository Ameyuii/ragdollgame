/// <summary>
/// Bridge để kết nối hệ thống mới với UI hiện tại theo thiết kế tài liệu
/// Đảm bảo backward compatibility và logic team selection hoạt động
/// </summary>
public class GameManagerBridge : MonoBehaviour
{
    [Header("System Settings")]
    public bool enableNewSystem = false; // Bắt đầu với legacy system
    public bool debugMode = true;

    [Header("Legacy References")]
    public BattleGameManager legacyGameManager;
    public TeamSelectionHandler teamHandler;

    private static GameManagerBridge _instance;
    public static GameManagerBridge Instance
    {
        get
        {
            if (_instance == null)
            {
                _instance = FindObjectOfType<GameManagerBridge>();
            }
            return _instance;
        }
    }

    void Awake()
    {
        if (_instance == null)
        {
            _instance = this;
        }
        else if (_instance != this)
        {
            Destroy(gameObject);
            return;
        }

        InitializeBridge();
    }

    void Start()
    {
        SetupReferences();
        FixTeamSelectionLogic();
    }

    private void InitializeBridge()
    {
        if (debugMode)
        {
            Debug.Log($"[GameManagerBridge] Bridge initialized. New system: {enableNewSystem}");
        }
    }

    private void SetupReferences()
    {
        // Auto-find references
        if (legacyGameManager == null)
        {
            legacyGameManager = FindObjectOfType<BattleGameManager>();
        }

        if (teamHandler == null)
        {
            teamHandler = FindObjectOfType<TeamSelectionHandler>();
        }

        if (debugMode)
        {
            Debug.Log($"[GameManagerBridge] Found BattleGameManager: {legacyGameManager != null}");
            Debug.Log($"[GameManagerBridge] Found TeamSelectionHandler: {teamHandler != null}");
        }
    }

    /// <summary>
    /// Sửa logic team selection theo thiết kế tài liệu
    /// </summary>
    private void FixTeamSelectionLogic()
    {
        if (legacyGameManager != null && teamHandler != null)
        {
            // Đồng bộ team selection giữa các component
            int currentTeam = teamHandler.selectedTeam;
            legacyGameManager.selectedTeam = currentTeam;

            if (debugMode)
            {
                Debug.Log($"[GameManagerBridge] Team selection synchronized to: {currentTeam}");
            }
        }
    }

    /// <summary>
    /// Spawn character - entry point cho drag & drop system
    /// </summary>
    public void SpawnCharacterAtPosition(Vector3 position)
    {
        if (enableNewSystem)
        {
            SpawnUsingNewSystem(position);
        }
        else
        {
            SpawnUsingLegacySystem(position);
        }
    }

    private void SpawnUsingNewSystem(Vector3 position)
    {
        // TODO: Implement new system when ready (Phase 2-3)
        if (debugMode)
        {
            Debug.Log("[GameManagerBridge] New system not fully implemented yet, falling back to legacy");
        }
        SpawnUsingLegacySystem(position);
    }

    private void SpawnUsingLegacySystem(Vector3 position)
    {
        if (legacyGameManager == null) return;

        // Đảm bảo team được set đúng
        int selectedTeam = GetCurrentSelectedTeam();
        legacyGameManager.selectedTeam = selectedTeam;

        // Gọi method spawn của legacy system
        legacyGameManager.SpawnCharacterAtPosition(position);

        if (debugMode)
        {
            Debug.Log($"[GameManagerBridge] Spawned character at {position} for team {selectedTeam}");
        }
    }

    /// <summary>
    /// Lấy team hiện tại được chọn
    /// </summary>
    public int GetCurrentSelectedTeam()
    {
        if (teamHandler != null)
        {
            return teamHandler.selectedTeam;
        }

        if (legacyGameManager != null)
        {
            return legacyGameManager.selectedTeam;
        }

        return 1; // Default team
    }

    /// <summary>
    /// Update team selection từ UI
    /// </summary>
    public void OnTeamSelectionChanged(int newTeam)
    {
        if (teamHandler != null)
        {
            teamHandler.selectedTeam = newTeam;
        }

        if (legacyGameManager != null)
        {
            legacyGameManager.selectedTeam = newTeam;
        }

        if (debugMode)
        {
            Debug.Log($"[GameManagerBridge] Team changed to: {newTeam}");
        }
    }

    /// <summary>
    /// Enable new system (theo thiết kế Phase 4)
    /// </summary>
    [ContextMenu("Enable New System")]
    public void EnableNewSystem()
    {
        enableNewSystem = true;
        Debug.Log("[GameManagerBridge] New system enabled");
    }

    /// <summary>
    /// Disable new system (fallback to legacy)
    /// </summary>
    [ContextMenu("Disable New System")]
    public void DisableNewSystem()
    {
        enableNewSystem = false;
        Debug.Log("[GameManagerBridge] Using legacy system");
    }
}
