    [ContextMenu("Refresh UI")]
    public void RefreshUI()
    {
        if (characterSelectionUI == null) return;
        
        // Check if CharacterSelectionUI has the old CharacterCategory class
        var categoryType = System.Type.GetType("CharacterCategory");
        if (categoryType == null)
        {
            Debug.LogWarning("CharacterCategory class not found in CharacterSelectionUI");
            return;
        }
        
        // Use reflection to create old format categories
        var oldCategoriesArray = System.Array.CreateInstance(categoryType, categories.Count);
        
        for (int i = 0; i < categories.Count; i++)
        {
            var category = categories[i];
            var oldCategory = System.Activator.CreateInstance(categoryType);
            
            // Set properties using reflection
            var nameField = categoryType.GetField("categoryName");
            if (nameField != null) nameField.SetValue(oldCategory, category.categoryName);
            
            var colorField = categoryType.GetField("categoryColor");
            if (colorField != null) colorField.SetValue(oldCategory, category.categoryColor);
            
            // Convert characters to prefab array
            var prefabs = new List<GameObject>();
            foreach (var character in category.characters)
            {
                if (character.prefab != null)
                {
                    prefabs.Add(character.prefab);
                }
            }
            
            var prefabsField = categoryType.GetField("characterPrefabs");
            if (prefabsField != null) prefabsField.SetValue(oldCategory, prefabs.ToArray());
            
            oldCategoriesArray.SetValue(oldCategory, i);
        }
        
        // Set categories on UI using reflection
        var categoriesField = characterSelectionUI.GetType().GetField("categories");
        if (categoriesField != null)
        {
            categoriesField.SetValue(characterSelectionUI, oldCategoriesArray);
        }
        
        Debug.Log("UI refreshed with current character data");
    }
