using System.Collections;

public class RagdollCharacter : MonoBehaviour
{
    [Header("Character Settings")]
    public float health = 100f;
    public float maxHealth = 100f;
    public int team = 0; // 0 = Team 1, 1 = Team 2
    public float attackDamage = 20f;
    public float attackRange = 2f;
    public float attackCooldown = 1.5f;
    
    [Header("Movement")]
    public float moveSpeed = 3f;
    public float jumpForce = 5f;
    
    [Header("Ragdoll")]
    public bool isRagdoll = false;
    public float ragdollTime = 3f;
    
    private Rigidbody[]? ragdollRigidbodies;
    private Collider[]? ragdollColliders;
    private Animator? animator;
    private Rigidbody? mainRigidbody;
    private Collider? mainCollider;
    private Transform? target;
    private float lastAttackTime;
    private bool isDead = false;
    
    // UI Health Bar
    private GameObject? healthBarCanvas;
    private UnityEngine.UI.Slider? healthSlider;
    
    void Start()
    {
        SetupRagdoll();
        SetupHealthBar();
        animator = GetComponent<Animator>();
        mainRigidbody = GetComponent<Rigidbody>();
        mainCollider = GetComponent<Collider>();
        
        // Find GameManager and register this character
        if (GameManager.Instance != null)
        {
            GameManager.Instance.RegisterCharacter(this);
        }
    }
    
    void SetupRagdoll()
    {
        ragdollRigidbodies = GetComponentsInChildren<Rigidbody>();
        ragdollColliders = GetComponentsInChildren<Collider>();
        
        // Initially disable ragdoll
        SetRagdollState(false);
    }
    
    void SetupHealthBar()
    {
        // Create health bar canvas
        GameObject healthBarPrefab = new GameObject("HealthBar");
        healthBarPrefab.transform.SetParent(transform);
        
        // Find head bone for positioning
        Transform headBone = FindHeadBone(transform);
        if (headBone != null)
        {
            healthBarPrefab.transform.position = headBone.position + Vector3.up * 0.3f;
        }
        else
        {
            healthBarPrefab.transform.localPosition = Vector3.up * 2.5f;
        }
        
        healthBarPrefab.transform.localScale = Vector3.one * 0.005f; // Small but visible
        
        Canvas canvas = healthBarPrefab.AddComponent<Canvas>();
        canvas.renderMode = RenderMode.WorldSpace;
        canvas.worldCamera = Camera.main;
        
        UnityEngine.UI.CanvasScaler scaler = healthBarPrefab.AddComponent<UnityEngine.UI.CanvasScaler>();
        scaler.scaleFactor = 0.01f; // Reasonable size
        
        // Set small canvas size
        RectTransform canvasRect = healthBarPrefab.GetComponent<RectTransform>();
        canvasRect.sizeDelta = new Vector2(100, 20);
        
        // Create health bar background
        GameObject healthBarBG = new GameObject("HealthBarBG");
        healthBarBG.transform.SetParent(healthBarPrefab.transform);
        healthBarBG.transform.localPosition = Vector3.zero;
        healthBarBG.transform.localScale = Vector3.one;
        
        UnityEngine.UI.Image bgImage = healthBarBG.AddComponent<UnityEngine.UI.Image>();
        bgImage.color = new Color(0.1f, 0.1f, 0.1f, 0.8f); // Dark background
        
        RectTransform bgRect = healthBarBG.GetComponent<RectTransform>();
        bgRect.sizeDelta = new Vector2(80, 10); // Small but visible
        bgRect.anchorMin = new Vector2(0.5f, 0.5f);
        bgRect.anchorMax = new Vector2(0.5f, 0.5f);
        bgRect.anchoredPosition = Vector2.zero;
        
        // Create health bar fill
        GameObject healthBarFill = new GameObject("HealthBarFill");
        healthBarFill.transform.SetParent(healthBarBG.transform);
        healthBarFill.transform.localPosition = Vector3.zero;
        healthBarFill.transform.localScale = Vector3.one;
        
        UnityEngine.UI.Image fillImage = healthBarFill.AddComponent<UnityEngine.UI.Image>();
        fillImage.color = new Color(0f, 0.8f, 0f, 1f); // Green but not too bright
        
        RectTransform fillRect = healthBarFill.GetComponent<RectTransform>();
        fillRect.sizeDelta = new Vector2(80, 10);
        fillRect.anchorMin = new Vector2(0, 0);
        fillRect.anchorMax = new Vector2(1, 1);
        fillRect.anchoredPosition = Vector2.zero;
        
        // Create slider component
        healthSlider = healthBarBG.AddComponent<UnityEngine.UI.Slider>();
        healthSlider.fillRect = fillRect;
        healthSlider.value = 1f;
        healthSlider.maxValue = 1f;
        
        healthBarCanvas = healthBarPrefab;
    }
    
    Transform FindHeadBone(Transform parent)
    {
        // Search for head bone in the hierarchy
        Transform[] allChildren = parent.GetComponentsInChildren<Transform>();
        
        foreach (Transform child in allChildren)
        {
            if (child.name.ToLower().Contains("head"))
            {
                return child;
            }
        }
        
        return null;
    }
    
    void Update()
    {
        if (isDead || isRagdoll) return;
        
        // Update health bar to always stay above head and face camera
        if (healthBarCanvas != null && Camera.main != null)
        {
            // Find head bone and position health bar above it
            Transform headBone = FindHeadBone(transform);
            if (headBone != null)
            {
                healthBarCanvas.transform.position = headBone.position + Vector3.up * 0.2f;
            }
            else
            {
                // Fallback to character position + offset
                healthBarCanvas.transform.position = transform.position + Vector3.up * 2.2f;
            }
            
            // Always face camera
            healthBarCanvas.transform.LookAt(Camera.main.transform);
            healthBarCanvas.transform.Rotate(0, 180, 0);
        }
        
        // Only allow movement and combat if battle is in progress
        if (GameManager.Instance != null && GameManager.Instance.IsBattleInProgress())
        {
            // Find nearest enemy
            FindNearestEnemy();
            
            // Move towards enemy and attack
            if (target != null)
            {
                MoveTowardsTarget();
                TryAttack();
            }
            else
            {
                // Random movement if no target
                RandomMovement();
            }
        }
        
        // Update animator parameters
        UpdateAnimator();
    }
    
    void UpdateAnimator()
    {
        if (animator == null) return;
        
        // Calculate movement speed - only if battle is in progress
        float currentSpeed = 0f;
        if (GameManager.Instance != null && GameManager.Instance.IsBattleInProgress() && target != null)
        {
            float distanceToTarget = Vector3.Distance(transform.position, target.position);
            if (distanceToTarget > attackRange)
            {
                currentSpeed = moveSpeed;
            }
        }
        
        // Set animator parameters
        animator.SetFloat("Speed", currentSpeed);
        animator.SetBool("IsAlive", !isDead);
    }
    
    void FindNearestEnemy()
    {
        RagdollCharacter[] allCharacters = Object.FindObjectsByType<RagdollCharacter>(FindObjectsSortMode.None);
        float nearestDistance = Mathf.Infinity;
        Transform? nearestEnemy = null;
        
        foreach (RagdollCharacter character in allCharacters)
        {
            if (character != this && character.team != this.team && !character.isDead)
            {
                float distance = Vector3.Distance(transform.position, character.transform.position);
                if (distance < nearestDistance)
                {
                    nearestDistance = distance;
                    nearestEnemy = character.transform;
                }
            }
        }
        
        target = nearestEnemy;
    }
    
    void MoveTowardsTarget()
    {
        if (target == null) return;
        
        Vector3 direction = (target.position - transform.position).normalized;
        direction.y = 0; // Keep movement on ground
        
        float distanceToTarget = Vector3.Distance(transform.position, target.position);
        
        if (distanceToTarget > attackRange)
        {
            // Move towards target
            transform.position += direction * moveSpeed * Time.deltaTime;
            transform.LookAt(target.position);
        }
    }
    
    void RandomMovement()
    {
        // Simple random movement when no target
        if (Random.Range(0f, 1f) < 0.02f) // 2% chance per frame
        {
            Vector3 randomDirection = new Vector3(Random.Range(-1f, 1f), 0, Random.Range(-1f, 1f)).normalized;
            transform.position += randomDirection * moveSpeed * Time.deltaTime * 0.5f;
        }
    }
    
    void TryAttack()
    {
        if (target == null || Time.time - lastAttackTime < attackCooldown) return;
        
        float distanceToTarget = Vector3.Distance(transform.position, target.position);
        
        if (distanceToTarget <= attackRange)
        {
            Attack();
            lastAttackTime = Time.time;
        }
    }
    
    void Attack()
    {
        if (target == null) return;
        
        // Trigger attack animation
        if (animator != null)
        {
            animator.SetTrigger("Attack");
        }
        
        // Apply damage to target
        RagdollCharacter targetCharacter = target.GetComponent<RagdollCharacter>();
        if (targetCharacter != null)
        {
            targetCharacter.TakeDamage(attackDamage);
            
            // Apply more realistic knockback force
            Vector3 knockbackDirection = (target.position - transform.position).normalized;
            knockbackDirection.y = 0.2f; // Reduced upward force
            
            Rigidbody targetRb = target.GetComponent<Rigidbody>();
            if (targetRb != null)
            {
                // Reduced knockback force
                targetRb.AddForce(knockbackDirection * 200f, ForceMode.Impulse);
            }
            
            // Trigger ragdoll on target temporarily with shorter duration
            targetCharacter.TriggerRagdoll(0.5f);
        }
        
        // Reduced jump attack force
        if (mainRigidbody != null)
        {
            mainRigidbody.AddForce(Vector3.up * (jumpForce * 0.3f), ForceMode.Impulse);
        }
    }
    
    public void TakeDamage(float damage)
    {
        if (isDead) return;
        
        health -= damage;
        
        // Trigger hit animation
        if (animator != null && health > 0)
        {
            animator.SetTrigger("Hit");
        }
        
        // Update health bar
        if (healthSlider != null)
        {
            healthSlider.value = health / maxHealth;
        }
        
        if (health <= 0)
        {
            Die();
        }
    }
    
    public void TriggerRagdoll(float duration)
    {
        if (isDead) return;
        
        StartCoroutine(RagdollCoroutine(duration));
    }
    
    IEnumerator RagdollCoroutine(float duration)
    {
        SetRagdollState(true);
        
        // Apply gravity and physics improvements to ragdoll parts
        ApplyGravityToRagdoll();
        
        yield return new WaitForSeconds(duration);
        
        if (!isDead)
        {
            SetRagdollState(false);
            
            // Reset character position to ground level if they're floating
            ResetToGroundLevel();
        }
    }
    
    void ApplyGravityToRagdoll()
    {
        if (ragdollRigidbodies != null)
        {
            foreach (Rigidbody rb in ragdollRigidbodies)
            {
                if (rb != mainRigidbody)
                {
                    // Ensure gravity is enabled and add physics improvements
                    rb.useGravity = true;
                    rb.linearDamping = 3f; // Add air resistance to prevent excessive bouncing
                    rb.angularDamping = 8f; // Reduce spinning
                    
                    // Add slight downward force to ensure falling
                    rb.AddForce(Vector3.down * 100f, ForceMode.Force);
                    
                    // Limit upward velocity to prevent excessive flying
                    if (rb.linearVelocity.y > 5f)
                    {
                        rb.linearVelocity = new Vector3(rb.linearVelocity.x, 5f, rb.linearVelocity.z);
                    }
                }
            }
        }
    }
    
    void ResetToGroundLevel()
    {
        // Raycast down to find ground
        RaycastHit hit;
        if (Physics.Raycast(transform.position + Vector3.up * 2f, Vector3.down, out hit, 10f))
        {
            // If character is too high above ground, move them down
            if (hit.distance > 2f)
            {
                transform.position = hit.point + Vector3.up * 0.1f;
            }
        }
        
        // Reset velocity to prevent continued floating
        if (mainRigidbody != null)
        {
            mainRigidbody.linearVelocity = Vector3.zero;
            mainRigidbody.angularVelocity = Vector3.zero;
        }
        
        // Reset all ragdoll rigidbodies
        if (ragdollRigidbodies != null)
        {
            foreach (Rigidbody rb in ragdollRigidbodies)
            {
                if (rb != mainRigidbody)
                {
                    rb.linearVelocity = Vector3.zero;
                    rb.angularVelocity = Vector3.zero;
                }
            }
        }
    }
    
    void SetRagdollState(bool ragdollEnabled)
    {
        isRagdoll = ragdollEnabled;
        
        if (animator != null)
            animator.enabled = !ragdollEnabled;
        
        if (mainRigidbody != null)
            mainRigidbody.isKinematic = ragdollEnabled;
        
        if (mainCollider != null)
            mainCollider.enabled = !ragdollEnabled;
        
        // Enable/disable ragdoll rigidbodies and colliders
        if (ragdollRigidbodies != null)
        {
            foreach (Rigidbody rb in ragdollRigidbodies)
            {
                if (rb != mainRigidbody)
                {
                    rb.isKinematic = !ragdollEnabled;
                    
                    if (ragdollEnabled)
                    {
                        // Setup physics properties for better ragdoll behavior
                        rb.useGravity = true;
                        rb.linearDamping = 2f; // Air resistance
                        rb.angularDamping = 5f; // Rotational resistance
                        rb.mass = 1f; // Reasonable mass
                        
                        // Limit velocity to prevent excessive flying
                        if (rb.linearVelocity.magnitude > 10f)
                        {
                            rb.linearVelocity = rb.linearVelocity.normalized * 10f;
                        }
                    }
                    else
                    {
                        // Reset physics when disabling ragdoll
                        rb.linearVelocity = Vector3.zero;
                        rb.angularVelocity = Vector3.zero;
                        rb.linearDamping = 0f;
                        rb.angularDamping = 0.05f;
                    }
                }
            }
        }
        
        if (ragdollColliders != null)
        {
            foreach (Collider col in ragdollColliders)
            {
                if (col != mainCollider)
                {
                    col.enabled = ragdollEnabled;
                }
            }
        }
    }
    
    void Die()
    {
        isDead = true;
        
        // Trigger death animation
        if (animator != null)
        {
            animator.SetTrigger("Death");
            animator.SetBool("IsAlive", false);
        }
        
        // Delay ragdoll activation to let death animation play
        StartCoroutine(DelayedRagdollActivation());
        
        // Notify GameManager
        if (GameManager.Instance != null)
        {
            GameManager.Instance.OnCharacterDied(this);
        }
        
        // Destroy after some time
        Destroy(gameObject, 10f);
    }
    
    System.Collections.IEnumerator DelayedRagdollActivation()
    {
        yield return new WaitForSeconds(1.5f); // Let death animation play
        SetRagdollState(true);
    }
    
    public void EnableRagdoll()
    {
        if (!isDead)
        {
            SetRagdollState(true);
        }
    }
    
    public void ResetCharacter()
    {
        // Reset health
        health = maxHealth;
        isDead = false;
        
        // Update health bar
        if (healthSlider != null)
        {
            healthSlider.value = 1f;
        }
        
        // Disable ragdoll
        SetRagdollState(false);
        
        // Reset position if needed
        transform.rotation = Quaternion.identity;
        
        // Clear target
        target = null;
        lastAttackTime = 0f;
    }
    
    void OnDrawGizmosSelected()
    {
        // Draw attack range
        Gizmos.color = Color.red;
        Gizmos.DrawWireSphere(transform.position, attackRange);
    }
}
