/// <summary>
/// Bridge to integrate new character system with existing UI without breaking current functionality
/// </summary>
public class UIIntegrationBridge : MonoBehaviour
{
    [Header("Integration Settings")]
    public bool enableNewSystemForUI = false; // Start disabled to maintain current UI functionality
    public bool debugLogging = true;

    [Header("UI References")]
    public BattleGameManager battleGameManager;
    public TeamSelectionHandler teamSelectionHandler;

    private static UIIntegrationBridge _instance;
    public static UIIntegrationBridge Instance
    {
        get
        {
            if (_instance == null)
            {
                _instance = FindObjectOfType<UIIntegrationBridge>();
            }
            return _instance;
        }
    }

    void Awake()
    {
        if (_instance == null)
        {
            _instance = this;
        }
        else if (_instance != this)
        {
            Destroy(gameObject);
            return;
        }

        InitializeBridge();
    }

    void Start()
    {
        // Setup references
        SetupReferences();
    }

    private void InitializeBridge()
    {
        if (debugLogging)
        {
            Debug.Log($"[UIBridge] UI Integration Bridge initialized. New system for UI: {enableNewSystemForUI}");
        }
    }

    private void SetupReferences()
    {
        // Find references if not assigned
        if (battleGameManager == null)
        {
            battleGameManager = FindObjectOfType<BattleGameManager>();
        }

        if (teamSelectionHandler == null)
        {
            teamSelectionHandler = FindObjectOfType<TeamSelectionHandler>();
        }

        if (debugLogging)
        {
            Debug.Log($"[UIBridge] References setup - BattleGameManager: {battleGameManager != null}, TeamSelectionHandler: {teamSelectionHandler != null}");
        }
    }

    /// <summary>
    /// Get current selected team from UI
    /// </summary>
    public int GetCurrentSelectedTeam()
    {
        if (teamSelectionHandler != null)
        {
            return teamSelectionHandler.selectedTeam;
        }
        
        if (battleGameManager != null)
        {
            return battleGameManager.selectedTeam;
        }

        return 1; // Default team
    }

    /// <summary>
    /// Handle character spawn request from drag & drop
    /// This method will be called when character is dropped
    /// </summary>
    public GameObject HandleCharacterSpawn(Vector3 position, GameObject originalPrefab = null)
    {
        int selectedTeam = GetCurrentSelectedTeam();

        if (debugLogging)
        {
            Debug.Log($"[UIBridge] Handling character spawn at {position} for team {selectedTeam}");
        }

        if (enableNewSystemForUI && CharacterSystemManager.Instance.ShouldUseNewSystem())
        {
            return SpawnUsingNewSystem(position, selectedTeam);
        }
        else
        {
            return SpawnUsingLegacySystem(position, selectedTeam, originalPrefab);
        }
    }

    private GameObject SpawnUsingNewSystem(Vector3 position, int teamID)
    {
        if (debugLogging)
        {
            Debug.Log($"[UIBridge] Spawning using NEW system for team {teamID}");
        }

        // Use new character system
        GameObject character = CharacterSystemManager.Instance.SpawnCharacter(
            "warrior_basic_default_01", // Default character for now
            "default",
            teamID,
            position);

        if (character != null)
        {
            // Update battle manager counts
            UpdateBattleManagerCounts(teamID, 1);
        }

        return character;
    }

    private GameObject SpawnUsingLegacySystem(Vector3 position, int teamID, GameObject originalPrefab)
    {
        if (debugLogging)
        {
            Debug.Log($"[UIBridge] Spawning using LEGACY system for team {teamID}");
        }

        GameObject character = null;

        // Use existing prefab if provided
        if (originalPrefab != null)
        {
            character = Instantiate(originalPrefab, position, Quaternion.identity);
        }
        else if (battleGameManager != null && battleGameManager.characterPrefabs.Length > 0)
        {
            // Use first available prefab from BattleGameManager
            GameObject prefab = battleGameManager.characterPrefabs[0];
            character = Instantiate(prefab, position, Quaternion.identity);
        }

        if (character != null)
        {
            // Apply team settings
            ApplyTeamToCharacter(character, teamID);

            // Update battle manager counts
            UpdateBattleManagerCounts(teamID, 1);
        }

        return character;
    }

    /// <summary>
    /// Apply team settings to character using existing logic
    /// </summary>
    private void ApplyTeamToCharacter(GameObject character, int teamID)
    {
        // Apply team ID to RagdollCharacter if present
        RagdollCharacter ragdoll = character.GetComponent<RagdollCharacter>();
        if (ragdoll != null)
        {
            ragdoll.teamId = teamID;
        }

        // Apply team materials using existing logic
        ApplyTeamMaterials(character, teamID);
    }

    /// <summary>
    /// Apply team materials using existing approach
    /// </summary>
    private void ApplyTeamMaterials(GameObject character, int teamID)
    {
        Material teamMaterial = null;

        // Load team materials from Resources (same as legacy system)
        if (teamID == 1)
        {
            teamMaterial = Resources.Load<Material>("Team1_Blue");
        }
        else if (teamID == 2)
        {
            teamMaterial = Resources.Load<Material>("Team2_Red");
        }

        if (teamMaterial != null && debugLogging)
        {
            Debug.Log($"[UIBridge] Applying team {teamID} material: {teamMaterial.name}");
        }

        if (teamMaterial != null)
        {
            Renderer[] renderers = character.GetComponentsInChildren<Renderer>();
            foreach (Renderer renderer in renderers)
            {
                if (renderer != null)
                {
                    renderer.material = teamMaterial;
                }
            }
        }
    }

    /// <summary>
    /// Update battle manager team counts
    /// </summary>
    private void UpdateBattleManagerCounts(int teamID, int change)
    {
        if (battleGameManager == null) return;

        if (teamID == 1)
        {
            battleGameManager.team1AliveCount += change;
        }
        else if (teamID == 2)
        {
            battleGameManager.team2AliveCount += change;
        }

        // Update UI
        battleGameManager.UpdateUI();

        if (debugLogging)
        {
            Debug.Log($"[UIBridge] Updated team {teamID} count by {change}. Team1: {battleGameManager.team1AliveCount}, Team2: {battleGameManager.team2AliveCount}");
        }
    }

    /// <summary>
    /// Enable new system for UI (can be called from inspector or other scripts)
    /// </summary>
    [ContextMenu("Enable New System for UI")]
    public void EnableNewSystemForUI()
    {
        enableNewSystemForUI = true;
        Debug.Log("[UIBridge] ✅ New system enabled for UI");
    }

    /// <summary>
    /// Disable new system for UI (fallback to legacy)
    /// </summary>
    [ContextMenu("Disable New System for UI")]  
    public void DisableNewSystemForUI()
    {
        enableNewSystemForUI = false;
        Debug.Log("[UIBridge] ⚠️ New system disabled for UI - using legacy");
    }

    /// <summary>
    /// Test spawn character
    /// </summary>
    [ContextMenu("Test Character Spawn")]
    public void TestCharacterSpawn()
    {
        Vector3 testPosition = new Vector3(0, 0, 5);
        GameObject character = HandleCharacterSpawn(testPosition);
        
        if (character != null)
        {
            Debug.Log($"[UIBridge] ✅ Test spawn successful: {character.name}");
        }
        else
        {
            Debug.LogError("[UIBridge] ❌ Test spawn failed");
        }
    }
}
