public class TestTeamSelection : MonoBehaviour
{
    public static void Execute()
    {
        Debug.Log("=== TEST TEAM SELECTION ===");
        
        TeamSelectionHandler handler = FindObjectOfType<TeamSelectionHandler>();
        if (handler != null)
        {
            // Force refresh team selection
            handler.ForceRefreshTeamSelection();
            
            // Also refresh button state
            handler.RefreshButtonState();
            
            Debug.Log($"Current selected team: {handler.GetSelectedTeam()}");
            Debug.Log("Team selection refreshed successfully");
        }
        else
        {
            Debug.LogError("TeamSelectionHandler not found!");
        }
        
        // Also check if EventSystem is working
