public class SimpleDebugTeam
{
    public static void Execute()
    {
        Debug.Log("=== SIMPLE DEBUG ===");
        
        try
        {
            BattleGameManager battleManager = Object.FindObjectOfType<BattleGameManager>();
            TeamSelectionHandler teamHandler = Object.FindObjectOfType<TeamSelectionHandler>();
            
            Debug.Log($"BattleGameManager found: {battleManager != null}");
            Debug.Log($"TeamSelectionHandler found: {teamHandler != null}");
            
            if (battleManager != null)
            {
                Debug.Log($"BattleGameManager.selectedTeam = {battleManager.selectedTeam}");
            }
            
            if (teamHandler != null)
            {
                Debug.Log($"TeamSelectionHandler.selectedTeam = {teamHandler.selectedTeam}");
                
                // Force manual assignment
                var field = typeof(TeamSelectionHandler).GetField("gameManager", 
                    System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
                
                if (field != null && battleManager != null)
