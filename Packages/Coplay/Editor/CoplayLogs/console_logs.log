[INFO] Func: write_to_file Args: path: Assets/Scripts/CharacterSystem/CharacterSystemTest.cs, content: using UnityEngine;

public class CharacterSystemTest : MonoBehaviour
{
    [Header("Test Settings")]
    public bool runTestOnStart = false;
    public Vector3 testSpawnPosition = new Vector3(0, 0, 5);

    [Header("Test Results")]
    public GameObject spawnedCharacter;

    void Start()
    {
        if (runTestOnStart)
        {
            TestCharacterSystem();
        }
    }

    [ContextMenu("Test Character System")]
    public void TestCharacterSystem()
    {
        Debug.Log("=== Testing Character System ===");

        // Test 1: Check if databases exist
        TestDatabasesExist();

        // Test 2: Test character spawning
        TestCharacterSpawning();

        // Test 3: Test legacy bridge
        TestLegacyBridge();

        Debug.Log("=== Character System Test Complete ===");
    }

    private void TestDatabasesExist()
    {
        Debug.Log("--- Test 1: Database Existence ---");

        GameDatabase gameDB = GameDatabase.Instance;
        if (gameDB != null)
        {
            Debug.Log("✅ GameDatabase found");
            if (gameDB.characterDatabase != null)
            {
                Debug.Log($"✅ CharacterDatabase found with {gameDB.characterDatabase.characters.Count} characters");
            }
            else
            {
                Debug.LogError("❌ CharacterDatabase is null");
            }
        }
        else
        {
            Debug.LogError("❌ GameDatabase not found");
        }
    }

    private void TestCharacterSpawning()
    {
        Debug.Log("--- Test 2: Character Spawning ---");

        CharacterSystemManager manager = CharacterSystemManager.Instance;
        if (manager != null)
        {
            Debug.Log("✅ CharacterSystemManager found");

            // Try to spawn a test character
            spawnedCharacter = manager.SpawnCharacter(
                "warrior_basic_default_01", 
                "default", 
                1, 
                testSpawnPosition);

            if (spawnedCharacter != null)
            {
                Debug.Log($"✅ Character spawned successfully: {spawnedCharacter.name}");
                
                // Check components
                EnhancedCharacterController enhanced = spawnedCharacter.GetComponent<EnhancedCharacterController>();
                if (enhanced != null)
                {
                    Debug.Log($"✅ EnhancedCharacterController found - Team: {enhanced.TeamID}");
                }
                else
                {
                    Debug.LogWarning("⚠️ EnhancedCharacterController not found");
                }
            }
            else
            {
                Debug.LogError("❌ Character spawn failed");
            }
        }
        else
        {
            Debug.LogError("❌ CharacterSystemManager not found");
        }
    }

    private void TestLegacyBridge()
    {
        Debug.Log("--- Test 3: Legacy Bridge ---");

        LegacySystemBridge bridge = LegacySystemBridge.Instance;
        if (bridge != null)
        {
            Debug.Log("✅ LegacySystemBridge found");
            Debug.Log($"Bridge ready: {bridge.IsNewSystemReady()}");
        }
        else
        {
            Debug.LogError("❌ LegacySystemBridge not found");
        }
    }

    [ContextMenu("Enable New System")]
    public void EnableNewSystem()
    {
        LegacySystemBridge bridge = LegacySystemBridge.Instance;
        if (bridge != null)
        {
            bridge.EnableNewSystemIntegration();
            Debug.Log("✅ New system integration enabled");
        }
    }

    [ContextMenu("Disable New System")]
    public void DisableNewSystem()
    {
        LegacySystemBridge bridge = LegacySystemBridge.Instance;
        if (bridge != null)
        {
            bridge.DisableNewSystemIntegration();
            Debug.Log("✅ New system integration disabled");
        }
    }

    [ContextMenu("Cleanup Test Character")]
    public void CleanupTestCharacter()
    {
        if (spawnedCharacter != null)
        {
            DestroyImmediate(spawnedCharacter);
            spawnedCharacter = null;
            Debug.Log("Test character cleaned up");
        }
    }
}
