[INFO] Func: write_to_file Args: path: Assets/Scripts/CheckBattleStatus.cs, content: using UnityEngine;

public class CheckBattleStatus : MonoBehaviour
{
    public static void Execute()
    {
        // Find all RagdollCharacter objects
        RagdollCharacter[] allCharacters = FindObjectsOfType<RagdollCharacter>();
        
        Debug.Log($"Total characters found: {allCharacters.Length}");
        
        int team1Count = 0;
        int team2Count = 0;
        
        foreach (RagdollCharacter character in allCharacters)
        {
            if (character.team == 0)
            {
                team1Count++;
                Debug.Log($"Team 1 character: {character.name} at position {character.transform.position}");
            }
            else if (character.team == 1)
            {
                team2Count++;
                Debug.Log($"Team 2 character: {character.name} at position {character.transform.position}");
            }
        }
        
        Debug.Log($"Team 1 (Blue): {team1Count} characters");
        Debug.Log($"Team 2 (Red): {team2Count} characters");
        
        // Check GameManager status
        GameManager gameManager = FindObjectOfType<GameManager>();
        if (gameManager != null)
        {
            Debug.Log("GameManager found and active!");
            if (gameManager.gameStatusText != null)
            {
                Debug.Log($"Game Status: {gameManager.gameStatusText.text}");
            }
        }
        else
        {
            Debug.LogError("GameManager not found!");
        }
        
        // List all game objects in scene
        GameObject[] allObjects = FindObjectsOfType<GameObject>();
        Debug.Log($"Total GameObjects in scene: {allObjects.Length}");
        
        // Check for spawn areas
        GameObject team1Spawn = GameObject.Find("Team1SpawnArea");
        GameObject team2Spawn = GameObject.Find("Team2SpawnArea");
        
        if (team1Spawn != null)
            Debug.Log($"Team1SpawnArea found at: {team1Spawn.transform.position}");
        else
            Debug.LogWarning("Team1SpawnArea not found!");
            
        if (team2Spawn != null)
            Debug.Log($"Team2SpawnArea found at: {team2Spawn.transform.position}");
        else
            Debug.LogWarning("Team2SpawnArea not found!");
    }
}
