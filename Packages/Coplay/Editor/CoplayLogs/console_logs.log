    [ContextMenu("Setup Ragdoll Physics")]
    public void SetupRagdollPhysics()
    {
        // Add rigidbodies and colliders to all bones
        Transform[] bones = GetComponentsInChildren<Transform>();
        
        foreach (Transform bone in bones)
        {
            // Skip the root object
            if (bone == transform) continue;
            
            // Add Rigidbody if not present
            Rigidbody rb = bone.GetComponent<Rigidbody>();
            if (rb == null)
            {
                rb = bone.gameObject.AddComponent<Rigidbody>();
                rb.mass = 1f;
                rb.linearDamping = 0.1f;
                rb.angularDamping = 0.1f;
            }
            
            // Add Collider if not present
            Collider col = bone.GetComponent<Collider>();
