[INFO] Func: write_to_file Args: path: Assets/Scripts/TestTeamSelection.cs, content: using UnityEngine;
using UnityEngine.UI;

public class TestTeamSelection
{
    public static void Execute()
    {
        Debug.Log("Testing Team Selection System...");
        
        // Find components
        TeamSelectionHandler teamHandler = Object.FindObjectOfType<TeamSelectionHandler>();
        BattleGameManager gameManager = Object.FindObjectOfType<BattleGameManager>();
        
        if (teamHandler == null)
        {
            Debug.LogError("TeamSelectionHandler not found!");
            return;
        }
        
        if (gameManager == null)
        {
            Debug.LogError("BattleGameManager not found!");
            return;
        }
        
        // Test current state
        Debug.Log($"TeamSelectionHandler selectedTeam: {teamHandler.selectedTeam}");
        Debug.Log($"BattleGameManager selectedTeam: {gameManager.selectedTeam}");
        
        // Test team selection
        Debug.Log("Testing team selection change to Team 2...");
        teamHandler.SelectTeam(2);
        
        Debug.Log($"After change - TeamSelectionHandler selectedTeam: {teamHandler.selectedTeam}");
        Debug.Log($"After change - BattleGameManager selectedTeam: {gameManager.selectedTeam}");
        
        // Test UI update
        Button teamButton = GameObject.Find("TeamDropdownButton")?.GetComponent<Button>();
        if (teamButton != null)
        {
            Debug.Log($"TeamDropdownButton interactable: {teamButton.interactable}");
        }
        else
        {
            Debug.LogWarning("TeamDropdownButton not found!");
        }
        
        // Test text components
        Text teamDropdownText = GameObject.Find("TeamDropdownButton/Text")?.GetComponent<Text>();
        if (teamDropdownText != null)
        {
            Debug.Log($"TeamDropdownButton text: '{teamDropdownText.text}'");
        }
        
        Text selectedTeamText = GameObject.Find("SelectedTeamDisplay/Text")?.GetComponent<Text>();
        if (selectedTeamText != null)
        {
            Debug.Log($"SelectedTeamDisplay text: '{selectedTeamText.text}'");
        }
        
        Debug.Log("Team Selection Test Complete!");
    }
}
