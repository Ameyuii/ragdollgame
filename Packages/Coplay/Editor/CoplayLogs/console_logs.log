public class TriggerTeamSetup
{
    public static void Execute()
    {
        Debug.Log("Triggering TeamSelectionHandler setup...");
        
        TeamSelectionHandler teamHandler = Object.FindObjectOfType<TeamSelectionHandler>();
        if (teamHandler != null)
        {
            // Force call Start method using reflection
            var startMethod = typeof(TeamSelectionHandler).GetMethod("Start", 
                System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
            
            if (startMethod != null)
            {
                startMethod.Invoke(teamHandler, null);
                Debug.Log("TeamSelectionHandler.Start() called manually");
            }
            
            // Test team selection
            Debug.Log("Testing team selection after setup...");
            teamHandler.SelectTeam(2);
            
            BattleGameManager battleManager = Object.FindObjectOfType<BattleGameManager>();
            if (battleManager != null)
            {
                Debug.Log($"After setup - BattleGameManager.selectedTeam = {battleManager.selectedTeam}");
            }
        }
        
        Debug.Log("Setup trigger complete!");
    }
}
