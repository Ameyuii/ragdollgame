using UnityEditor;

/// <summary>
/// Quick setup menu for character management
/// </summary>
public class QuickCharacterSetupMenu
{
    [MenuItem("GameObject/Character Management/Add Character Manager", false, 10)]
    public static void AddCharacterManager()
    {
        GameObject selected = Selection.activeGameObject;
        if (selected == null)
        {
            // Create new GameObject
            selected = new GameObject("Character Manager");
            Selection.activeGameObject = selected;
        }
        
        // Add CharacterManager component if not exists
        CharacterManager manager = selected.GetComponent<CharacterManager>();
        if (manager == null)
        {
            manager = selected.AddComponent<CharacterManager>();
            
            // Try to find UI references
            CharacterSelectionUI ui = Object.FindObjectOfType<CharacterSelectionUI>();
            if (ui != null)
            {
                manager.characterSelectionUI = ui;
            }
            
            BattleGameManager gameManager = Object.FindObjectOfType<BattleGameManager>();
            if (gameManager != null)
            {
                manager.gameManager = gameManager;
            }
            
            // Initialize default categories
            manager.InitializeDefaultCategories();
            
            EditorUtility.SetDirty(manager);
            Debug.Log("Character Manager added and initialized!");
        }
        else
        {
            Debug.Log("Character Manager already exists on this GameObject");
        }
    }
    
    [MenuItem("GameObject/Character Management/Setup Selected as Character", false, 11)]
    public static void SetupSelectedAsCharacter()
    {
        GameObject[] selected = Selection.gameObjects;
        if (selected.Length == 0)
        {
            EditorUtility.DisplayDialog("No Selection", "Please select one or more GameObjects to setup as characters.", "OK");
            return;
        }
        
        // Open Advanced Character Setup with selected objects
        AdvancedCharacterSetup window = EditorWindow.GetWindow<AdvancedCharacterSetup>();
        window.titleContent = new GUIContent("Advanced Character Setup");
        window.Show();
        
        Debug.Log($"Opening Advanced Character Setup for {selected.Length} selected objects");
    }
    
    [MenuItem("Assets/Character Management/Auto Setup Character Prefab", false, 20)]
    public static void AutoSetupCharacterPrefab()
    {
        GameObject selected = Selection.activeObject as GameObject;
        if (selected == null)
        {
            EditorUtility.DisplayDialog("Invalid Selection", "Please select a GameObject prefab to setup.", "OK");
            return;
        }
        
        // Auto setup with common components
        GameObject instance = PrefabUtility.InstantiatePrefab(selected) as GameObject;
        if (instance == null)
        {
            instance = Object.Instantiate(selected);
        }
        
        bool modified = false;
        
        // Add common components
        if (instance.GetComponent<RagdollCharacter>() == null)
        {
            instance.AddComponent<RagdollCharacter>();
            modified = true;
        }
        
        if (instance.GetComponent<UnityEngine.AI.NavMeshAgent>() == null)
        {
            instance.AddComponent<UnityEngine.AI.NavMeshAgent>();
            modified = true;
        }
        
        if (instance.GetComponent<Animator>() == null)
        {
            instance.AddComponent<Animator>();
            modified = true;
        }
        
        if (instance.GetComponent<Rigidbody>() == null)
        {
            instance.AddComponent<Rigidbody>();
            modified = true;
        }
        
        if (instance.GetComponent<CapsuleCollider>() == null)
        {
            instance.AddComponent<CapsuleCollider>();
            modified = true;
        }
        
        if (modified)
        {
            // Save back to prefab
            string prefabPath = AssetDatabase.GetAssetPath(selected);
            if (!string.IsNullOrEmpty(prefabPath))
            {
                PrefabUtility.SaveAsPrefabAsset(instance, prefabPath);
                Debug.Log($"Auto setup completed for {selected.name}");
            }
            else
            {
                // Save as new prefab
                string newPath = $"Assets/Prefabs/{selected.name}_Setup.prefab";
                if (!AssetDatabase.IsValidFolder("Assets/Prefabs"))
                {
                    AssetDatabase.CreateFolder("Assets", "Prefabs");
                }
                PrefabUtility.SaveAsPrefabAsset(instance, newPath);
                Debug.Log($"Created new setup prefab: {newPath}");
            }
        }
        else
        {
            Debug.Log($"{selected.name} already has all required components");
        }
        
        Object.DestroyImmediate(instance);
    }
    
    // Validation methods
    [MenuItem("GameObject/Character Management/Add Character Manager", true)]
    public static bool ValidateAddCharacterManager()
    {
        return Selection.activeGameObject != null;
    }
    
    [MenuItem("GameObject/Character Management/Setup Selected as Character", true)]
    public static bool ValidateSetupSelectedAsCharacter()
    {
        return Selection.gameObjects.Length > 0;
    }
    
    [MenuItem("Assets/Character Management/Auto Setup Character Prefab", true)]
    public static bool ValidateAutoSetupCharacterPrefab()
    {
        return Selection.activeObject is GameObject;
    }
}
