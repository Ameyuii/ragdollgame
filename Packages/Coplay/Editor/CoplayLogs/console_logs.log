public class DebugTeamSelection
{
    public static void Execute()
    {
        Debug.Log("=== DEBUGGING TEAM SELECTION ===");
        
        // Find GameManager GameObject
        GameObject gameManagerObj = GameObject.Find("GameManager");
        if (gameManagerObj == null)
        {
            Debug.LogError("GameManager GameObject not found!");
            return;
        }
        
        Debug.Log($"GameManager GameObject found: {gameManagerObj.name}");
        
        // Check all components on GameManager
        Component[] components = gameManagerObj.GetComponents<Component>();
        Debug.Log($"Components on GameManager ({components.Length}):");
        
        BattleGameManager battleManager = null;
        TeamSelectionHandler teamHandler = null;
        
        foreach (Component comp in components)
        {
            Debug.Log($"  - {comp.GetType().Name}");
            
            if (comp is BattleGameManager)
                battleManager = comp as BattleGameManager;
            
            if (comp is TeamSelectionHandler)
                teamHandler = comp as TeamSelectionHandler;
        }
        
        // Test manual reference assignment
        if (teamHandler != null && battleManager != null)
        {
            Debug.Log("Both components found - testing manual assignment...");
            
            // Get private field using reflection
            var field = typeof(TeamSelectionHandler).GetField("gameManager", 
                System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
            
            if (field != null)
            {
                field.SetValue(teamHandler, battleManager);
                Debug.Log("Manual assignment completed!");
                
                // Test team selection now
                teamHandler.SelectTeam(2);
                Debug.Log($"After manual assignment - BattleGameManager selectedTeam: {battleManager.selectedTeam}");
            }
        }
        
        Debug.Log("=== DEBUG COMPLETE ===");
    }
}
