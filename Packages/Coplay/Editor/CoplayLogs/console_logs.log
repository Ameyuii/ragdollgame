using UnityEngine.UI;

public class FixUIForBetterDisplay : MonoBehaviour
{
    public static void Execute()
    {
        // Find UI Canvas
        Canvas canvas = FindObjectOfType<Canvas>();
        if (canvas == null)
        {
            Debug.LogError("No Canvas found!");
            return;
        }
        
        // Make UI less intrusive and cleaner
        GameObject panel = GameObject.Find("GameUI Panel");
        if (panel != null)
        {
            Image panelImage = panel.GetComponent<Image>();
            if (panelImage != null)
            {
                // Make background more transparent
                panelImage.color = new Color(0, 0, 0, 0.1f);
            }
        }
        
        // Simplify and clean up UI elements
        GameObject title = GameObject.Find("Title");
        if (title != null)
        {
            Text titleText = title.GetComponent<Text>();
            if (titleText != null)
            {
                titleText.text = "RAGDOLL BATTLE";
                titleText.fontSize = 36;
                titleText.color = new Color(1f, 1f, 0f, 0.8f); // Semi-transparent yellow
            }
            
            RectTransform titleRect = title.GetComponent<RectTransform>();
            titleRect.anchoredPosition = new Vector2(0, -30);
        }
        
        // Make team counters smaller and less intrusive
        GameObject team1Counter = GameObject.Find("Team1Counter");
        if (team1Counter != null)
        {
            Text team1Text = team1Counter.GetComponent<Text>();
            if (team1Text != null)
            {
                team1Text.fontSize = 24;
                team1Text.color = new Color(0f, 0.8f, 1f, 0.9f); // Semi-transparent cyan
            }
            
            RectTransform team1Rect = team1Counter.GetComponent<RectTransform>();
            team1Rect.anchoredPosition = new Vector2(150, -20);
        }
        
        GameObject team2Counter = GameObject.Find("Team2Counter");
        if (team2Counter != null)
        {
            Text team2Text = team2Counter.GetComponent<Text>();
            if (team2Text != null)
            {
                team2Text.fontSize = 24;
                team2Text.color = new Color(1f, 0.3f, 0.3f, 0.9f); // Semi-transparent red
            }
            
            RectTransform team2Rect = team2Counter.GetComponent<RectTransform>();
            team2Rect.anchoredPosition = new Vector2(-150, -20);
        }
        
        // Make status text smaller and less prominent
        GameObject statusText = GameObject.Find("StatusText");
        if (statusText != null)
        {
            Text status = statusText.GetComponent<Text>();
            if (status != null)
            {
                status.fontSize = 20;
                status.color = new Color(1f, 1f, 1f, 0.7f); // Semi-transparent white
                status.text = "Battle in Progress - Watch the Ragdoll Action!";
            }
            
            RectTransform statusRect = statusText.GetComponent<RectTransform>();
            statusRect.anchoredPosition = new Vector2(0, -80);
        }
        
        // Make buttons smaller and move to corner
        GameObject startButton = GameObject.Find("StartButton");
        if (startButton != null)
        {
            RectTransform startRect = startButton.GetComponent<RectTransform>();
            startRect.anchorMin = new Vector2(0, 1);
            startRect.anchorMax = new Vector2(0, 1);
            startRect.anchoredPosition = new Vector2(80, -120);
            startRect.sizeDelta = new Vector2(120, 35);
            
            Image startImage = startButton.GetComponent<Image>();
            if (startImage != null)
            {
                startImage.color = new Color(0.2f, 0.8f, 0.2f, 0.6f);
            }
            
            Text startText = startButton.GetComponentInChildren<Text>();
            if (startText != null)
            {
                startText.fontSize = 16;
            }
        }
        
        GameObject resetButton = GameObject.Find("ResetButton");
        if (resetButton != null)
        {
            RectTransform resetRect = resetButton.GetComponent<RectTransform>();
            resetRect.anchorMin = new Vector2(0, 1);
            resetRect.anchorMax = new Vector2(0, 1);
            resetRect.anchoredPosition = new Vector2(220, -120);
            resetRect.sizeDelta = new Vector2(120, 35);
            
            Image resetImage = resetButton.GetComponent<Image>();
            if (resetImage != null)
            {
                resetImage.color = new Color(0.8f, 0.2f, 0.2f, 0.6f);
            }
            
            Text resetText = resetButton.GetComponentInChildren<Text>();
            if (resetText != null)
            {
                resetText.fontSize = 16;
            }
        }
        
        Debug.Log("UI cleaned up for better game experience!");
        Debug.Log("UI is now less intrusive and more transparent.");
        Debug.Log("You can now enjoy watching the ragdoll battle without UI clutter!");
    }
}
