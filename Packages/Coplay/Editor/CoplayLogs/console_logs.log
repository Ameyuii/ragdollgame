    public void TakeDamage(float damage)
    {
        if (isDead) return;
        
        health -= damage;
        
        // Trigger hit animation
        if (animator != null && health > 0)
        {
            animator.SetTrigger("Hit");
        }
        
        // Update health bar
        if (healthSlider != null)
        {
            healthSlider.value = health / maxHealth;
        }
        
        if (health <= 0)
        {
            Die();
        }
    }
    
    public void TriggerRagdoll(float duration)
    {
        if (isDead) return;
        
        StartCoroutine(RagdollCoroutine(duration));
    }
    
    IEnumerator RagdollCoroutine(float duration)
    {
        SetRagdollState(true);
        
        // Apply gravity and physics improvements to ragdoll parts
        ApplyGravityToRagdoll();
        
        yield return new WaitForSeconds(duration);
        
        if (!isDead)
        {
            SetRagdollState(false);
            
            // Reset character position to ground level if they're floating
            ResetToGroundLevel();
        }
    }
    
    void ApplyGravityToRagdoll()
    {
        if (ragdollRigidbodies != null)
        {
            foreach (Rigidbody rb in ragdollRigidbodies)
            {
                if (rb != mainRigidbody)
                {
                    // Ensure gravity is enabled and add physics improvements
                    rb.useGravity = true;
                    rb.linearDamping = 3f; // Add air resistance to prevent excessive bouncing
                    rb.angularDamping = 8f; // Reduce spinning
                    
                    // Add slight downward force to ensure falling
                    rb.AddForce(Vector3.down * 100f, ForceMode.Force);
                    
                    // Limit upward velocity to prevent excessive flying
                    if (rb.linearVelocity.y > 5f)
                    {
                        rb.linearVelocity = new Vector3(rb.linearVelocity.x, 5f, rb.linearVelocity.z);
                    }
                }
            }
        }
    }
    
