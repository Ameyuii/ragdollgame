/// <summary>
/// Simple integration to make the game work normally with current UI
/// This ensures backward compatibility while gradually introducing new features
/// </summary>
public class SimpleGameIntegration : MonoBehaviour
{
    [Header("Integration Settings")]
    public bool enableSimpleIntegration = true;
    public bool debugMode = true;

    [Header("UI Components")]
    public BattleGameManager battleGameManager;
    public TeamSelectionHandler teamHandler;

    private static SimpleGameIntegration _instance;
    public static SimpleGameIntegration Instance
    {
        get
        {
            if (_instance == null)
            {
                _instance = FindObjectOfType<SimpleGameIntegration>();
            }
            return _instance;
        }
    }

    void Awake()
    {
        if (_instance == null)
        {
            _instance = this;
            DontDestroyOnLoad(gameObject);
        }
        else if (_instance != this)
        {
            Destroy(gameObject);
            return;
        }

        InitializeIntegration();
    }

    void Start()
    {
        SetupUIReferences();
        FixTeamSelection();
    }

    private void InitializeIntegration()
    {
        if (debugMode)
        {
            Debug.Log("[SimpleIntegration] Initializing simple game integration...");
        }
    }

    private void SetupUIReferences()
    {
        // Find BattleGameManager
        if (battleGameManager == null)
        {
            battleGameManager = FindObjectOfType<BattleGameManager>();
        }

        // Find TeamSelectionHandler
        if (teamHandler == null)
        {
            teamHandler = FindObjectOfType<TeamSelectionHandler>();
        }

        if (debugMode)
        {
            Debug.Log($"[SimpleIntegration] Found BattleGameManager: {battleGameManager != null}");
            Debug.Log($"[SimpleIntegration] Found TeamSelectionHandler: {teamHandler != null}");
        }
    }

    /// <summary>
    /// Fix team selection functionality to work with current UI
    /// </summary>
    private void FixTeamSelection()
    {
        if (!enableSimpleIntegration) return;

        // Ensure team selection works
        if (teamHandler != null && battleGameManager != null)
        {
            // Sync team selection between components
            SyncTeamSelection();
        }
    }

    /// <summary>
    /// Sync team selection between different components
    /// </summary>
    private void SyncTeamSelection()
    {
        if (teamHandler != null && battleGameManager != null)
        {
            // Make sure both components have the same selected team
            if (teamHandler.selectedTeam != battleGameManager.selectedTeam)
            {
                battleGameManager.selectedTeam = teamHandler.selectedTeam;
                if (debugMode)
                {
                    Debug.Log($"[SimpleIntegration] Synced team selection to: {teamHandler.selectedTeam}");
                }
            }
        }
    }

    /// <summary>
    /// Get current selected team (unified approach)
    /// </summary>
    public int GetCurrentSelectedTeam()
    {
        if (teamHandler != null)
        {
            return teamHandler.selectedTeam;
        }
        
        if (battleGameManager != null)
        {
            return battleGameManager.selectedTeam;
        }

        return 1; // Default team
    }

    /// <summary>
    /// Handle character spawn - integrated approach
    /// </summary>
    public GameObject SpawnCharacter(Vector3 position, GameObject prefab = null)
    {
        if (!enableSimpleIntegration)
        {
            return SpawnUsingLegacySystem(position, prefab);
        }

        int selectedTeam = GetCurrentSelectedTeam();
        
        if (debugMode)
        {
            Debug.Log($"[SimpleIntegration] Spawning character at {position} for team {selectedTeam}");
        }

        // Try to get a prefab to spawn
        GameObject prefabToSpawn = GetPrefabToSpawn(prefab);
        if (prefabToSpawn == null)
        {
            Debug.LogError("[SimpleIntegration] No prefab available for spawning");
            return null;
        }

        // Spawn the character
        GameObject character = Instantiate(prefabToSpawn, position, Quaternion.identity);
        
        // Apply team configuration
        ApplyTeamConfiguration(character, selectedTeam);

        // Update counts
        UpdateTeamCounts(selectedTeam, 1);

        // Log success
        if (debugMode)
        {
            Debug.Log($"[SimpleIntegration] ✅ Character spawned: {character.name} for team {selectedTeam}");
        }

        return character;
    }

    private GameObject SpawnUsingLegacySystem(Vector3 position, GameObject prefab)
    {
        if (battleGameManager != null)
        {
            // Use legacy system
            battleGameManager.SpawnCharacterAtPosition(position);
            return null; // Legacy system doesn't return the spawned object
        }

        return null;
    }

    private GameObject GetPrefabToSpawn(GameObject preferredPrefab)
    {
        // Use provided prefab if available
        if (preferredPrefab != null)
        {
            return preferredPrefab;
        }

        // Try to get from BattleGameManager
        if (battleGameManager != null && battleGameManager.characterPrefabs.Length > 0)
        {
            // Use the first available prefab or based on selected character type
            int selectedType = battleGameManager.selectedCharacterType;
            if (selectedType >= 0 && selectedType < battleGameManager.characterPrefabs.Length)
            {
                return battleGameManager.characterPrefabs[selectedType];
            }
            else
            {
                return battleGameManager.characterPrefabs[0];
            }
        }

        // Try to load from Resources as fallback
        GameObject fallbackPrefab = Resources.Load<GameObject>("CompleteCharacter");
        if (fallbackPrefab != null)
        {
            return fallbackPrefab;
        }

        fallbackPrefab = Resources.Load<GameObject>("BattleCharacter");
        return fallbackPrefab;
    }

    private void ApplyTeamConfiguration(GameObject character, int teamID)
    {
        // Set team ID on RagdollCharacter if present
        RagdollCharacter ragdoll = character.GetComponent<RagdollCharacter>();
        if (ragdoll != null)
        {
            ragdoll.teamId = teamID;
        }

        // Apply team materials
        ApplyTeamMaterials(character, teamID);
    }

    private void ApplyTeamMaterials(GameObject character, int teamID)
    {
        Material teamMaterial = null;

        // Load team materials from Resources
        if (teamID == 1)
        {
            teamMaterial = Resources.Load<Material>("Team1_Blue");
        }
        else if (teamID == 2)
        {
            teamMaterial = Resources.Load<Material>("Team2_Red");
        }

        if (teamMaterial != null)
        {
            // Apply to all renderers
            Renderer[] renderers = character.GetComponentsInChildren<Renderer>();
            foreach (Renderer renderer in renderers)
            {
                if (renderer != null)
                {
                    renderer.material = teamMaterial;
                }
            }

            if (debugMode)
            {
                Debug.Log($"[SimpleIntegration] Applied team {teamID} material: {teamMaterial.name}");
            }
        }
        else if (debugMode)
        {
            Debug.LogWarning($"[SimpleIntegration] No material found for team {teamID}");
        }
    }

    private void UpdateTeamCounts(int teamID, int change)
    {
        if (battleGameManager == null) return;

        if (teamID == 1)
        {
            battleGameManager.team1AliveCount += change;
        }
        else if (teamID == 2)
        {
            battleGameManager.team2AliveCount += change;
        }

        // Force UI update by directly updating text components
        UpdateTeamCountTexts();

        if (debugMode)
        {
            Debug.Log($"[SimpleIntegration] Updated team {teamID} count by {change}. Team1: {battleGameManager.team1AliveCount}, Team2: {battleGameManager.team2AliveCount}");
        }
    }

    private void UpdateTeamCountTexts()
    {
        if (battleGameManager == null) return;

        // Update team counter texts directly
        if (battleGameManager.team1CounterText != null)
        {
            battleGameManager.team1CounterText.text = $"Team 1: {battleGameManager.team1AliveCount}";
        }

        if (battleGameManager.team2CounterText != null)
        {
            battleGameManager.team2CounterText.text = $"Team 2: {battleGameManager.team2AliveCount}";
        }
    }

    /// <summary>
    /// Handle team change from UI
    /// </summary>
    public void OnTeamChanged(int newTeamID)
    {
        if (debugMode)
        {
            Debug.Log($"[SimpleIntegration] Team changed to: {newTeamID}");
        }

        // Update both components
        if (teamHandler != null)
        {
            teamHandler.selectedTeam = newTeamID;
        }

        if (battleGameManager != null)
        {
            battleGameManager.selectedTeam = newTeamID;
        }
    }

    /// <summary>
    /// Test character spawn (for debugging)
    /// </summary>
    [ContextMenu("Test Character Spawn")]
    public void TestCharacterSpawn()
    {
        Vector3 testPosition = new Vector3(0, 0, 5);
        GameObject character = SpawnCharacter(testPosition);
        
        if (character != null)
        {
            Debug.Log($"[SimpleIntegration] ✅ Test spawn successful: {character.name}");
        }
        else
        {
            Debug.LogError("[SimpleIntegration] ❌ Test spawn failed");
        }
    }
}
