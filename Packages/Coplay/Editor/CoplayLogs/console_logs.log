using UnityEngine.InputSystem;

namespace AnimalRevolt.UI
{
    /// <summary>
    /// Script debug để kiểm tra tất cả các script đang xử lý phím F1
    /// và tìm ra nguyên nhân ẩn character
    /// </summary>
    public class F1DebugChecker : MonoBehaviour
    {
        [Header("🔍 Debug Settings")]
        [SerializeField, Tooltip("Hiển thị debug log chi tiết")]
        private bool showDetailedLogs = true;
        
        [SerializeField, Tooltip("Kiểm tra tất cả GameObject trong scene")]
        private bool checkAllGameObjects = true;

        private InputAction f1Action;

        private void Awake()
        {
            // Tạo input action để theo dõi F1
            f1Action = new InputAction("F1Debug", InputActionType.Button, "<Keyboard>/f1");
            f1Action.Enable();
            
            Debug.Log("🔍 F1DebugChecker đã khởi tạo - sẽ theo dõi tất cả hoạt động F1");
        }

        private void Update()
        {
            if (f1Action.WasPressedThisFrame())
            {
                Debug.Log("🔍 ===== F1 ĐƯỢC NHẤN - BẮT ĐẦU KIỂM TRA =====");
                
                // Kiểm tra trạng thái trước khi xử lý
                KiemTraTrangThaiTruocXuLy();
                
                // Đợi 1 frame để các script khác xử lý
                StartCoroutine(KiemTraSauXuLy());
            }
        }

        /// <summary>
        /// Kiểm tra trạng thái trước khi xử lý F1
        /// </summary>
        private void KiemTraTrangThaiTruocXuLy()
        {
            Debug.Log("🔍 === TRẠNG THÁI TRƯỚC KHI XỬ LÝ F1 ===");
            
            // Kiểm tra các character
            KiemTraCharacters("TRƯỚC");
            
            // Kiểm tra UI Manager
            KiemTraUIManagers("TRƯỚC");
        }

        /// <summary>
        /// Kiểm tra trạng thái sau khi xử lý F1
        /// </summary>
        private System.Collections.IEnumerator KiemTraSauXuLy()
        {
            yield return new WaitForEndOfFrame();
            
            Debug.Log("🔍 === TRẠNG THÁI SAU KHI XỬ LÝ F1 ===");
            
            // Kiểm tra các character
            KiemTraCharacters("SAU");
            
            // Kiểm tra UI Manager
            KiemTraUIManagers("SAU");
            
            Debug.Log("🔍 ===== KẾT THÚC KIỂM TRA F1 =====");
        }

        /// <summary>
        /// Kiểm tra trạng thái của các character
        /// </summary>
        private void KiemTraCharacters(string thoiDiem)
        {
            Debug.Log($"🔍 [{thoiDiem}] Kiểm tra Characters:");
            
            // Kiểm tra Warrok W Kurniawan
            GameObject warrok = GameObject.Find("Warrok W Kurniawan");
            if (warrok != null)
            {
                Debug.Log($"🔍 [{thoiDiem}] Warrok W Kurniawan: Active={warrok.activeInHierarchy}, SetActive={warrok.activeSelf}");
                
                // Kiểm tra renderer
                Renderer[] renderers = warrok.GetComponentsInChildren<Renderer>();
                foreach (var renderer in renderers)
                {
                    Debug.Log($"🔍 [{thoiDiem}] Warrok Renderer {renderer.name}: enabled={renderer.enabled}");
                }
            }
            
            // Kiểm tra npc Variant
            GameObject[] npcVariants = GameObject.FindGameObjectsWithTag("Untagged");
            foreach (var npc in npcVariants)
            {
                if (npc.name.Contains("npc Variant"))
                {
                    Debug.Log($"🔍 [{thoiDiem}] {npc.name}: Active={npc.activeInHierarchy}, SetActive={npc.activeSelf}");
                    
                    // Kiểm tra renderer
                    Renderer[] renderers = npc.GetComponentsInChildren<Renderer>();
                    foreach (var renderer in renderers)
                    {
                        Debug.Log($"🔍 [{thoiDiem}] {npc.name} Renderer {renderer.name}: enabled={renderer.enabled}");
                    }
                }
            }
        }

        /// <summary>
        /// Kiểm tra trạng thái của UI Managers
        /// </summary>
        private void KiemTraUIManagers(string thoiDiem)
        {
            Debug.Log($"🔍 [{thoiDiem}] Kiểm tra UI Managers:");
            
            // Kiểm tra UnifiedUIManager
            UnifiedUIManager unifiedUI = FindFirstObjectByType<UnifiedUIManager>();
            if (unifiedUI != null)
            {
                Debug.Log($"🔍 [{thoiDiem}] UnifiedUIManager: AllUIVisible={unifiedUI.IsAllUIVisible()}");
            }
            
            // Kiểm tra UIToggleManager (legacy)
            UIToggleManager legacyUI = FindFirstObjectByType<UIToggleManager>();
            if (legacyUI != null)
            {
                Debug.Log($"🔍 [{thoiDiem}] UIToggleManager (Legacy): Found={legacyUI != null}");
            }
            
            // Kiểm tra CameraSettingsUI
            CameraSettingsUI[] cameraUIs = FindObjectsByType<CameraSettingsUI>(FindObjectsSortMode.None);
            foreach (var cameraUI in cameraUIs)
            {
                Debug.Log($"🔍 [{thoiDiem}] CameraSettingsUI {cameraUI.name}: GameObject Active={cameraUI.gameObject.activeInHierarchy}");
            }
        }

        private void OnDestroy()
        {
            f1Action?.Dispose();
        }
    }
}
