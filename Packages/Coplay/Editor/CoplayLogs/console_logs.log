[INFO] Func: write_to_file Args: path: Assets/Scripts/CharacterSystem/CreateDatabaseScript.cs, content: using UnityEngine;

public class CreateDatabaseScript : MonoBehaviour
{
    [Header("Database Creation")]
    public bool createOnStart = true;

    void Start()
    {
        if (createOnStart)
        {
            CreateDatabases();
        }
    }

    [ContextMenu("Create Character Database")]
    public void CreateCharacterDatabase()
    {
        NewCharacterDatabase database = ScriptableObject.CreateInstance<NewCharacterDatabase>();
        
        // Create some default categories
        database.categories.Add(new CharacterCategory("warrior", "Warriors", "Strong melee fighters"));
        database.categories.Add(new CharacterCategory("archer", "Archers", "Ranged attackers"));
        database.categories.Add(new CharacterCategory("mage", "Mages", "Magic users"));

        // Save as asset
        #if UNITY_EDITOR
        string path = "Assets/Resources/CharacterDatabase.asset";
        UnityEditor.AssetDatabase.CreateAsset(database, path);
        UnityEditor.AssetDatabase.SaveAssets();
        Debug.Log($"Character Database created at: {path}");
        #endif
    }

    [ContextMenu("Create Game Database")]
    public void CreateGameDatabase()
    {
        GameDatabase gameDatabase = ScriptableObject.CreateInstance<GameDatabase>();
        
        // Try to find existing character database
        NewCharacterDatabase characterDB = Resources.Load<NewCharacterDatabase>("CharacterDatabase");
        if (characterDB != null)
        {
            gameDatabase.characterDatabase = characterDB;
        }

        // Save as asset
        #if UNITY_EDITOR
        string path = "Assets/Resources/GameDatabase.asset";
        UnityEditor.AssetDatabase.CreateAsset(gameDatabase, path);
        UnityEditor.AssetDatabase.SaveAssets();
        Debug.Log($"Game Database created at: {path}");
        #endif
    }

    [ContextMenu("Create Both Databases")]
    public void CreateDatabases()
    {
        CreateCharacterDatabase();
        CreateGameDatabase();
        
        Debug.Log("Character System databases created successfully!");
    }
}
