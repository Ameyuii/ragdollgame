public class FixSpawnAreasAndStartBattle : MonoBehaviour
{
    public static void Execute()
    {
        // Find GameManager
        GameManager gameManager = FindObjectOfType<GameManager>();
        if (gameManager == null)
        {
            Debug.LogError("GameManager not found!");
            return;
        }
        
        // Create spawn areas manually
        GameObject team1SpawnGO = GameObject.Find("Team1SpawnArea");
        if (team1SpawnGO == null)
        {
            team1SpawnGO = new GameObject("Team1SpawnArea");
            team1SpawnGO.transform.position = new Vector3(-15, 0, 0);
            Debug.Log("Created Team1SpawnArea at " + team1SpawnGO.transform.position);
        }
        
        GameObject team2SpawnGO = GameObject.Find("Team2SpawnArea");
        if (team2SpawnGO == null)
        {
            team2SpawnGO = new GameObject("Team2SpawnArea");
            team2SpawnGO.transform.position = new Vector3(15, 0, 0);
            Debug.Log("Created Team2SpawnArea at " + team2SpawnGO.transform.position);
        }
        
        // Assign spawn areas to GameManager
        gameManager.team1SpawnArea = team1SpawnGO.transform;
        gameManager.team2SpawnArea = team2SpawnGO.transform;
        
        // Set character prefab to the existing NPC
        GameObject npcTemplate = GameObject.Find("npc Variant");
        if (npcTemplate != null)
        {
            gameManager.characterPrefab = npcTemplate;
            Debug.Log("Set character prefab to: " + npcTemplate.name);
        }
        
        // Reset battle first
        gameManager.ResetBattle();
        
        // Wait a frame then start battle
        Debug.Log("Starting battle with proper spawn areas...");
        gameManager.StartBattle();
        
        Debug.Log("Battle should now be running with characters spawning!");
    }
}
