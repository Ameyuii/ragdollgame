using System.Collections.Generic;
using UnityEngine.UI;

public class GameManager : MonoBehaviour
{
    public static GameManager Instance;
    
    [Header("Game Settings")]
    public int team1Count = 5;
    public int team2Count = 5;
    public GameObject characterPrefab;
    
    [Header("Spawn Settings")]
    public Transform team1SpawnArea;
    public Transform team2SpawnArea;
    public float spawnRadius = 5f;
    
    [Header("UI")]
    public Text team1CountText;
    public Text team2CountText;
    public Text gameStatusText;
    public Button startBattleButton;
    public Button resetBattleButton;
    
    private List<RagdollCharacter> allCharacters = new List<RagdollCharacter>();
    private List<RagdollCharacter> team1Characters = new List<RagdollCharacter>();
    private List<RagdollCharacter> team2Characters = new List<RagdollCharacter>();
    
    private bool battleStarted = false;
    private bool battleEnded = false;
    
    void Awake()
    {
        if (Instance == null)
        {
            Instance = this;
        }
        else
        {
            Destroy(gameObject);
        }
    }
    
    void Start()
    {
        SetupUI();
        CreateSpawnAreas();
        UpdateUI();
    }
    
    void SetupUI()
    {
        // Create UI Canvas if it doesn't exist
        Canvas canvas = FindObjectOfType<Canvas>();
        if (canvas == null)
        {
            GameObject canvasGO = new GameObject("UI Canvas");
            canvas = canvasGO.AddComponent<Canvas>();
            canvas.renderMode = RenderMode.ScreenSpaceOverlay;
            canvasGO.AddComponent<CanvasScaler>();
            canvasGO.AddComponent<GraphicRaycaster>();
        }
        
        // Create UI elements
        CreateUIElements(canvas.transform);
    }
    
    void CreateUIElements(Transform parent)
    {
        // Team 1 Count Text
        GameObject team1TextGO = new GameObject("Team1CountText");
        team1TextGO.transform.SetParent(parent);
        team1CountText = team1TextGO.AddComponent<Text>();
        team1CountText.text = "Team 1: " + team1Count;
        team1CountText.font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
        team1CountText.fontSize = 24;
        team1CountText.color = Color.blue;
        
        RectTransform team1Rect = team1TextGO.GetComponent<RectTransform>();
        team1Rect.anchorMin = new Vector2(0, 1);
        team1Rect.anchorMax = new Vector2(0, 1);
        team1Rect.anchoredPosition = new Vector2(100, -30);
        team1Rect.sizeDelta = new Vector2(200, 30);
        
        // Team 2 Count Text
        GameObject team2TextGO = new GameObject("Team2CountText");
        team2TextGO.transform.SetParent(parent);
        team2CountText = team2TextGO.AddComponent<Text>();
        team2CountText.text = "Team 2: " + team2Count;
        team2CountText.font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
        team2CountText.fontSize = 24;
        team2CountText.color = Color.red;
        
        RectTransform team2Rect = team2TextGO.GetComponent<RectTransform>();
        team2Rect.anchorMin = new Vector2(1, 1);
        team2Rect.anchorMax = new Vector2(1, 1);
        team2Rect.anchoredPosition = new Vector2(-100, -30);
        team2Rect.sizeDelta = new Vector2(200, 30);
        
        // Game Status Text
        GameObject statusTextGO = new GameObject("GameStatusText");
        statusTextGO.transform.SetParent(parent);
        gameStatusText = statusTextGO.AddComponent<Text>();
        gameStatusText.text = "Press Start Battle to begin!";
        gameStatusText.font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
        gameStatusText.fontSize = 32;
        gameStatusText.color = Color.white;
        gameStatusText.alignment = TextAnchor.MiddleCenter;
        
        RectTransform statusRect = statusTextGO.GetComponent<RectTransform>();
        statusRect.anchorMin = new Vector2(0.5f, 1);
        statusRect.anchorMax = new Vector2(0.5f, 1);
        statusRect.anchoredPosition = new Vector2(0, -80);
        statusRect.sizeDelta = new Vector2(400, 40);
        
        // Start Battle Button
        GameObject startButtonGO = new GameObject("StartBattleButton");
        startButtonGO.transform.SetParent(parent);
        startBattleButton = startButtonGO.AddComponent<Button>();
        
        Image startButtonImage = startButtonGO.AddComponent<Image>();
        startButtonImage.color = Color.green;
        
        RectTransform startButtonRect = startButtonGO.GetComponent<RectTransform>();
        startButtonRect.anchorMin = new Vector2(0.5f, 0);
        startButtonRect.anchorMax = new Vector2(0.5f, 0);
        startButtonRect.anchoredPosition = new Vector2(-100, 50);
        startButtonRect.sizeDelta = new Vector2(150, 40);
        
        // Start Button Text
        GameObject startButtonTextGO = new GameObject("Text");
        startButtonTextGO.transform.SetParent(startButtonGO.transform);
        Text startButtonText = startButtonTextGO.AddComponent<Text>();
        startButtonText.text = "Start Battle";
        startButtonText.font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
        startButtonText.fontSize = 18;
        startButtonText.color = Color.white;
        startButtonText.alignment = TextAnchor.MiddleCenter;
        
        RectTransform startTextRect = startButtonTextGO.GetComponent<RectTransform>();
        startTextRect.anchorMin = Vector2.zero;
        startTextRect.anchorMax = Vector2.one;
        startTextRect.offsetMin = Vector2.zero;
        startTextRect.offsetMax = Vector2.zero;
        
        startBattleButton.onClick.AddListener(StartBattle);
        
        // Reset Battle Button
        GameObject resetButtonGO = new GameObject("ResetBattleButton");
        resetButtonGO.transform.SetParent(parent);
        resetBattleButton = resetButtonGO.AddComponent<Button>();
        
        Image resetButtonImage = resetButtonGO.AddComponent<Image>();
        resetButtonImage.color = Color.red;
        
        RectTransform resetButtonRect = resetButtonGO.GetComponent<RectTransform>();
        resetButtonRect.anchorMin = new Vector2(0.5f, 0);
        resetButtonRect.anchorMax = new Vector2(0.5f, 0);
        resetButtonRect.anchoredPosition = new Vector2(100, 50);
        resetButtonRect.sizeDelta = new Vector2(150, 40);
        
        // Reset Button Text
        GameObject resetButtonTextGO = new GameObject("Text");
        resetButtonTextGO.transform.SetParent(resetButtonGO.transform);
        Text resetButtonText = resetButtonTextGO.AddComponent<Text>();
        resetButtonText.text = "Reset Battle";
        resetButtonText.font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
        resetButtonText.fontSize = 18;
        resetButtonText.color = Color.white;
        resetButtonText.alignment = TextAnchor.MiddleCenter;
        
        RectTransform resetTextRect = resetButtonTextGO.GetComponent<RectTransform>();
        resetTextRect.anchorMin = Vector2.zero;
        resetTextRect.anchorMax = Vector2.one;
        resetTextRect.offsetMin = Vector2.zero;
        resetTextRect.offsetMax = Vector2.zero;
        
        resetBattleButton.onClick.AddListener(ResetBattle);
    }
    
    void CreateSpawnAreas()
    {
        // Create Team 1 spawn area
        GameObject team1SpawnGO = new GameObject("Team1SpawnArea");
        team1SpawnGO.transform.position = new Vector3(-15, 0, 0);
        team1SpawnArea = team1SpawnGO.transform;
        
        // Create Team 2 spawn area
        GameObject team2SpawnGO = new GameObject("Team2SpawnArea");
        team2SpawnGO.transform.position = new Vector3(15, 0, 0);
        team2SpawnArea = team2SpawnGO.transform;
    }
    
    public void StartBattle()
    {
        if (battleStarted) return;
        
        battleStarted = true;
        battleEnded = false;
        
        // Clear existing characters
        ClearAllCharacters();
        
        // Use the existing NPC as a template
        GameObject npcTemplate = GameObject.Find("npc Variant");
        if (npcTemplate != null)
        {
            characterPrefab = npcTemplate;
        }
        
        // Spawn characters
        SpawnTeam(0, team1Count, team1SpawnArea.position);
        SpawnTeam(1, team2Count, team2SpawnArea.position);
        
        gameStatusText.text = "Battle in Progress!";
        startBattleButton.interactable = false;
    }
    
    void SpawnTeam(int teamNumber, int count, Vector3 spawnCenter)
    {
        for (int i = 0; i < count; i++)
        {
            Vector3 spawnPosition = spawnCenter + Random.insideUnitSphere * spawnRadius;
            spawnPosition.y = 1f; // Keep above ground
            
            GameObject newCharacter;
            if (characterPrefab != null)
            {
                newCharacter = Instantiate(characterPrefab, spawnPosition, Quaternion.identity);
            }
            else
            {
                // Create a simple capsule character if no prefab
                newCharacter = GameObject.CreatePrimitive(PrimitiveType.Capsule);
                newCharacter.transform.position = spawnPosition;
                newCharacter.AddComponent<Rigidbody>();
            }
            
            newCharacter.name = "Character_Team" + (teamNumber + 1) + "_" + (i + 1);
            
            // Add RagdollCharacter component
            RagdollCharacter ragdollChar = newCharacter.GetComponent<RagdollCharacter>();
            if (ragdollChar == null)
            {
                ragdollChar = newCharacter.AddComponent<RagdollCharacter>();
            }
            
            ragdollChar.team = teamNumber;
            
            // Set team colors
            Renderer[] renderers = newCharacter.GetComponentsInChildren<Renderer>();
            Color teamColor = teamNumber == 0 ? Color.blue : Color.red;
            
            foreach (Renderer renderer in renderers)
            {
                if (renderer.material != null)
                {
                    renderer.material.color = teamColor;
                }
            }
        }
    }
    
    public void RegisterCharacter(RagdollCharacter character)
    {
        if (!allCharacters.Contains(character))
        {
            allCharacters.Add(character);
            
            if (character.team == 0)
            {
                team1Characters.Add(character);
            }
            else
            {
                team2Characters.Add(character);
            }
        }
    }
    
    public void OnCharacterDied(RagdollCharacter character)
    {
        allCharacters.Remove(character);
        
        if (character.team == 0)
        {
            team1Characters.Remove(character);
        }
        else
        {
            team2Characters.Remove(character);
        }
        
        UpdateUI();
        CheckBattleEnd();
    }
    
    void UpdateUI()
    {
        if (team1CountText != null)
            team1CountText.text = "Team 1: " + team1Characters.Count;
        
        if (team2CountText != null)
            team2CountText.text = "Team 2: " + team2Characters.Count;
    }
    
    void CheckBattleEnd()
    {
        if (!battleStarted || battleEnded) return;
        
        if (team1Characters.Count == 0)
        {
            EndBattle("Team 2 Wins!");
        }
        else if (team2Characters.Count == 0)
        {
            EndBattle("Team 1 Wins!");
        }
    }
    
    void EndBattle(string result)
    {
        battleEnded = true;
        gameStatusText.text = result;
        startBattleButton.interactable = true;
    }
    
    public void ResetBattle()
    {
        ClearAllCharacters();
        battleStarted = false;
        battleEnded = false;
        
        gameStatusText.text = "Press Start Battle to begin!";
        startBattleButton.interactable = true;
        
        UpdateUI();
    }
    
    void ClearAllCharacters()
    {
        // Destroy all spawned characters (but keep the original NPC)
        RagdollCharacter[] characters = FindObjectsOfType<RagdollCharacter>();
        foreach (RagdollCharacter character in characters)
        {
            if (character.gameObject.name != "npc Variant")
            {
                DestroyImmediate(character.gameObject);
            }
        }
        
        allCharacters.Clear();
        team1Characters.Clear();
        team2Characters.Clear();
    }
    
    void Update()
    {
        if (battleStarted && !battleEnded)
        {
            UpdateUI();
        }
    }
}
