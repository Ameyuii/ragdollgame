using UnityEngine.UI;

public class FixUILayout : MonoBehaviour
{
    public static void Execute()
    {
        // Find UI elements
        GameObject titleGO = GameObject.Find("Title");
        GameObject team1GO = GameObject.Find("Team1Counter");
        GameObject team2GO = GameObject.Find("Team2Counter");
        GameObject statusGO = GameObject.Find("StatusText");
        GameObject startButtonGO = GameObject.Find("StartButton");
        GameObject resetButtonGO = GameObject.Find("ResetButton");
        
        // Fix Title position
        if (titleGO != null)
        {
            RectTransform titleRect = titleGO.GetComponent<RectTransform>();
            titleRect.anchorMin = new Vector2(0.5f, 0.9f);
            titleRect.anchorMax = new Vector2(0.5f, 0.9f);
            titleRect.anchoredPosition = Vector2.zero;
            titleRect.sizeDelta = new Vector2(800, 60);
        }
        
        // Fix Team 1 Counter (left side)
        if (team1GO != null)
        {
            RectTransform team1Rect = team1GO.GetComponent<RectTransform>();
            team1Rect.anchorMin = new Vector2(0f, 0.8f);
            team1Rect.anchorMax = new Vector2(0f, 0.8f);
            team1Rect.anchoredPosition = new Vector2(200, 0);
            team1Rect.sizeDelta = new Vector2(400, 40);
            
            Text team1Text = team1GO.GetComponent<Text>();
            if (team1Text != null)
            {
                team1Text.alignment = TextAnchor.MiddleLeft;
            }
        }
        
        // Fix Team 2 Counter (right side)
        if (team2GO != null)
        {
            RectTransform team2Rect = team2GO.GetComponent<RectTransform>();
            team2Rect.anchorMin = new Vector2(1f, 0.8f);
            team2Rect.anchorMax = new Vector2(1f, 0.8f);
            team2Rect.anchoredPosition = new Vector2(-200, 0);
            team2Rect.sizeDelta = new Vector2(400, 40);
            
            Text team2Text = team2GO.GetComponent<Text>();
            if (team2Text != null)
            {
                team2Text.alignment = TextAnchor.MiddleRight;
            }
        }
        
        // Fix Status Text (center)
        if (statusGO != null)
        {
            RectTransform statusRect = statusGO.GetComponent<RectTransform>();
            statusRect.anchorMin = new Vector2(0.5f, 0.7f);
            statusRect.anchorMax = new Vector2(0.5f, 0.7f);
            statusRect.anchoredPosition = Vector2.zero;
            statusRect.sizeDelta = new Vector2(800, 40);
        }
        
        // Fix Start Button (center-left)
        if (startButtonGO != null)
        {
            RectTransform startButtonRect = startButtonGO.GetComponent<RectTransform>();
            startButtonRect.anchorMin = new Vector2(0.5f, 0.1f);
            startButtonRect.anchorMax = new Vector2(0.5f, 0.1f);
            startButtonRect.anchoredPosition = new Vector2(-120, 0);
            startButtonRect.sizeDelta = new Vector2(200, 60);
        }
        
        // Fix Reset Button (center-right)
        if (resetButtonGO != null)
        {
            RectTransform resetButtonRect = resetButtonGO.GetComponent<RectTransform>();
            resetButtonRect.anchorMin = new Vector2(0.5f, 0.1f);
            resetButtonRect.anchorMax = new Vector2(0.5f, 0.1f);
            resetButtonRect.anchoredPosition = new Vector2(120, 0);
            resetButtonRect.sizeDelta = new Vector2(200, 60);
        }
        
        Debug.Log("UI Layout fixed - all elements should now be properly centered!");
    }
}
