    void Update()
    {
        // Close dropdown if clicked outside (using new Input System)
        if (isDropdownOpen)
        {
            // Check for mouse click using new Input System
            bool mouseClicked = false;
            Vector2 mousePos = Vector2.zero;
            
            try
            {
                // Try to use new Input System
                var mouse = UnityEngine.InputSystem.Mouse.current;
                if (mouse != null && mouse.leftButton.wasPressedThisFrame)
                {
                    mouseClicked = true;
                    mousePos = mouse.position.ReadValue();
                }
            }
            catch
            {
                // Fallback - just close dropdown after a delay if needed
                // This avoids the Input System error
            }
            
            if (mouseClicked && dropdownPanel != null)
            {
                RectTransform dropdownRect = dropdownPanel.GetComponent<RectTransform>();
