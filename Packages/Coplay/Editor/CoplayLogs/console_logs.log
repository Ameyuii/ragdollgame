/// <summary>
/// Demo script to show how to use CharacterManager programmatically
/// </summary>
public class CharacterManagerDemo : MonoBehaviour
{
    [Header("References")]
    public CharacterManager characterManager;
    
    void Start()
    {
        if (characterManager == null)
            characterManager = GetComponent<CharacterManager>();
        
        // Demo: Add some characters if manager is empty
        if (characterManager != null && characterManager.TotalCharacterCount == 0)
        {
            AddDemoCharacters();
        }
    }
    
    /// <summary>
    /// Add demo characters to test the system
    /// </summary>
    [ContextMenu("Add Demo Characters")]
    public void AddDemoCharacters()
    {
        if (characterManager == null) return;
        
        // Ensure we have categories
        if (characterManager.CategoryCount == 0)
        {
            characterManager.InitializeDefaultCategories();
        }
        
        // Add demo soldier
        CharacterEntry soldier = new CharacterEntry();
        soldier.characterName = "Demo Soldier";
        soldier.health = 100;
        soldier.speed = 5f;
        soldier.attackDamage = 25f;
        soldier.attackRange = 2f;
        soldier.teamColor = Color.green;
        soldier.description = "A basic soldier unit for demonstration";
        
        characterManager.AddCharacterToCategory("🪖 CHIẾN BINH", soldier);
        
        // Add demo robot
        CharacterEntry robot = new CharacterEntry();
        robot.characterName = "Demo Robot";
        robot.health = 150;
        robot.speed = 4f;
        robot.attackDamage = 30f;
        robot.attackRange = 3f;
        robot.teamColor = Color.blue;
        robot.description = "A mechanical warrior with enhanced durability";
        
        characterManager.AddCharacterToCategory("🤖 ROBOT", robot);
        
        // Add demo monster
        CharacterEntry monster = new CharacterEntry();
        monster.characterName = "Demo Monster";
        monster.health = 80;
        monster.speed = 6f;
        monster.attackDamage = 35f;
        monster.attackRange = 1.5f;
        monster.teamColor = Color.red;
        monster.description = "A fierce creature with high attack power";
        
        characterManager.AddCharacterToCategory("👹 QUÁI VẬT", monster);
        
        Debug.Log("Added demo characters to Character Manager!");
    }
    
    /// <summary>
    /// Example of how to get characters programmatically
    /// </summary>
    [ContextMenu("Test Character Access")]
    public void TestCharacterAccess()
    {
        if (characterManager == null) return;
        
        Debug.Log("=== CHARACTER ACCESS TEST ===");
        
        // Get all characters
        var allCharacters = characterManager.GetAllCharacters();
        Debug.Log($"Total characters: {allCharacters.Count}");
        
        // Get characters from specific category
        var soldiers = characterManager.GetCharactersFromCategory("🪖 CHIẾN BINH");
        Debug.Log($"Soldiers: {soldiers.Count}");
        
        // Print character details
        foreach (var character in allCharacters)
        {
            Debug.Log($"Character: {character.characterName} - HP: {character.health} - Speed: {character.speed}");
        }
    }
    
    /// <summary>
    /// Example of adding character at runtime
    /// </summary>
    [ContextMenu("Add Random Character")]
    public void AddRandomCharacter()
    {
        if (characterManager == null) return;
        
        CharacterEntry randomCharacter = new CharacterEntry();
        randomCharacter.characterName = $"Random Character {Random.Range(1000, 9999)}";
        randomCharacter.health = Random.Range(50, 200);
        randomCharacter.speed = Random.Range(3f, 8f);
        randomCharacter.attackDamage = Random.Range(15f, 50f);
        randomCharacter.attackRange = Random.Range(1f, 4f);
        randomCharacter.teamColor = new Color(Random.value, Random.value, Random.value, 1f);
        randomCharacter.description = "Randomly generated character for testing";
        
        // Add to random category
        if (characterManager.CategoryCount > 0)
        {
            int randomCategoryIndex = Random.Range(0, characterManager.CategoryCount);
            string categoryName = characterManager.Categories[randomCategoryIndex].categoryName;
            characterManager.AddCharacterToCategory(categoryName, randomCharacter);
            
            Debug.Log($"Added random character '{randomCharacter.characterName}' to category '{categoryName}'");
        }
    }
}
