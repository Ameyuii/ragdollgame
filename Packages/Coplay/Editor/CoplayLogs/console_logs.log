### 3.2 Performance Optimization

#### **Caching Strategy:**
```csharp
public class CharacterDataCache : MonoBehaviour
{
    private static Dictionary<string, CharacterDefinition> characterCache;
    private static Dictionary<string, GameObject> prefabCache;
    private static Dictionary<int, TeamConfiguration> teamCache;
    
    public static void PreloadData()
    {
        // Load và cache tất cả character definitions
        // Preload frequently used prefabs
        // Cache team configurations
    }
    
    public static CharacterDefinition GetCharacter(string characterID)
    {
        if (characterCache.TryGetValue(characterID, out CharacterDefinition character))
            return character;
        
        // Load from database if not cached
        return LoadCharacterFromDatabase(characterID);
    }
}
```

#### **Object Pooling System:**
```csharp
public class CharacterPool : MonoBehaviour
{
    private Dictionary<string, Queue<GameObject>> pooledCharacters;
    private Dictionary<string, GameObject> prefabReferences;
    
    public GameObject GetCharacter(string characterID, string variantID)
    {
        string poolKey = $"{characterID}_{variantID}";
        
        if (pooledCharacters.TryGetValue(poolKey, out Queue<GameObject> pool) && pool.Count > 0)
        {
            return pool.Dequeue();
        }
        
        // Create new instance if pool is empty
        return CreateNewCharacterInstance(characterID, variantID);
    }
    
    public void ReturnCharacter(GameObject character, string characterID, string variantID)
    {
        string poolKey = $"{characterID}_{variantID}";
        character.SetActive(false);
        
        if (!pooledCharacters.ContainsKey(poolKey))
            pooledCharacters[poolKey] = new Queue<GameObject>();
            
        pooledCharacters[poolKey].Enqueue(character);
    }
}
```

