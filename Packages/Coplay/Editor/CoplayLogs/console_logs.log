public class EnhanceBattleEffects : MonoBehaviour
{
    public static void Execute()
    {
        // Find all characters and enhance them
        RagdollCharacter[] allCharacters = FindObjectsOfType<RagdollCharacter>();
        
        Debug.Log($"Enhancing {allCharacters.Length} characters with battle effects...");
        
        foreach (RagdollCharacter character in allCharacters)
        {
            // Skip the original NPC template
            if (character.name == "npc Variant") continue;
            
            // Add more dramatic physics
            Rigidbody mainRb = character.GetComponent<Rigidbody>();
            if (mainRb != null)
            {
                mainRb.mass = 2f; // Make them heavier for more impact
                mainRb.drag = 0.5f; // Add some air resistance
            }
            
            // Enhance attack properties
            character.attackDamage = 25f;
            character.attackRange = 2.5f;
            character.moveSpeed = 4f;
            character.jumpForce = 8f;
            
            // Add team colors more dramatically
            Renderer[] renderers = character.GetComponentsInChildren<Renderer>();
            Color teamColor = character.team == 0 ? Color.blue : Color.red;
            
            foreach (Renderer renderer in renderers)
            {
                if (renderer.material != null)
                {
                    // Make colors more vibrant
                    renderer.material.color = teamColor;
                    renderer.material.SetFloat("_Metallic", 0.3f);
                    renderer.material.SetFloat("_Smoothness", 0.7f);
                }
            }
            
            // Add a simple particle effect for attacks (using a light component as effect)
            Light attackEffect = character.GetComponent<Light>();
            if (attackEffect == null)
            {
                attackEffect = character.gameObject.AddComponent<Light>();
                attackEffect.type = LightType.Point;
                attackEffect.color = teamColor;
                attackEffect.intensity = 2f;
                attackEffect.range = 3f;
                attackEffect.enabled = false; // Start disabled
            }
        }
        
        // Add some environmental effects
        // Make the ground more interesting
        GameObject ground = GameObject.Find("Ground");
        if (ground != null)
        {
            Renderer groundRenderer = ground.GetComponent<Renderer>();
            if (groundRenderer != null && groundRenderer.material != null)
            {
                // Add some battle arena feel
                groundRenderer.material.color = new Color(0.3f, 0.5f, 0.2f, 1f); // Darker green
            }
        }
        
        // Enhance lighting for dramatic effect
        Light directionalLight = FindObjectOfType<Light>();
        if (directionalLight != null)
        {
            directionalLight.intensity = 1.5f;
            directionalLight.color = new Color(1f, 0.9f, 0.8f); // Warm light
        }
        
        Debug.Log("Battle effects enhanced! Characters should now fight more dramatically!");
        
        // Show current battle status
        GameManager gameManager = FindObjectOfType<GameManager>();
        if (gameManager != null)
        {
            int team1Count = 0;
            int team2Count = 0;
            
            foreach (RagdollCharacter character in allCharacters)
            {
                if (character.name != "npc Variant")
                {
                    if (character.team == 0) team1Count++;
                    else if (character.team == 1) team2Count++;
                }
            }
            
            Debug.Log($"Current Battle Status - Team 1 (Blue): {team1Count}, Team 2 (Red): {team2Count}");
        }
    }
}
