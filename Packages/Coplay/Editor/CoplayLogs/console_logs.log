using System.Collections;

public class GameStatusMonitor : MonoBehaviour
{
    [Header("Monitor Settings")]
    public float updateInterval = 2f;
    public bool enableLogging = true;
    
    private int lastTeam1Count = 0;
    private int lastTeam2Count = 0;
    private float nextUpdateTime = 0f;
    
    void Start()
    {
        if (enableLogging)
        {
            Debug.Log("🎮 GAME STATUS MONITOR STARTED");
            Debug.Log("📊 Monitoring battle every " + updateInterval + " seconds");
            StartCoroutine(MonitorBattle());
        }
    }
    
    void Update()
    {
        if (enableLogging && Time.time >= nextUpdateTime)
        {
            UpdateBattleStatus();
            nextUpdateTime = Time.time + updateInterval;
        }
    }
    
    IEnumerator MonitorBattle()
    {
        while (true)
        {
            yield return new WaitForSeconds(updateInterval);
            UpdateBattleStatus();
        }
    }
    
    void UpdateBattleStatus()
    {
        RagdollCharacter[] allCharacters = FindObjectsOfType<RagdollCharacter>();
        
        int team1Alive = 0;
        int team2Alive = 0;
        int totalCharacters = 0;
        
        foreach (RagdollCharacter character in allCharacters)
        {
            if (character.name == "npc Variant") continue;
            
            totalCharacters++;
            if (character.health > 0)
            {
                if (character.team == 0) team1Alive++;
                else if (character.team == 1) team2Alive++;
            }
        }
        
        // Only log if there's a change
        if (team1Alive != lastTeam1Count || team2Alive != lastTeam2Count)
        {
            Debug.Log("=== BATTLE UPDATE ===");
            Debug.Log($"🔵 Team 1 (Blue): {team1Alive} fighters");
            Debug.Log($"🔴 Team 2 (Red): {team2Alive} fighters");
            Debug.Log($"⚔️ Total active: {team1Alive + team2Alive}/{totalCharacters}");
            
            if (team1Alive == 0 && team2Alive > 0)
            {
                Debug.Log("🏆 TEAM 2 (RED) WINS!");
            }
            else if (team2Alive == 0 && team1Alive > 0)
            {
                Debug.Log("🏆 TEAM 1 (BLUE) WINS!");
            }
            else if (team1Alive > 0 && team2Alive > 0)
            {
                Debug.Log("⚔️ BATTLE CONTINUES!");
            }
            
            lastTeam1Count = team1Alive;
            lastTeam2Count = team2Alive;
        }
    }
    
    // Public methods that can be called even during play mode
    [ContextMenu("Force Status Update")]
    public void ForceStatusUpdate()
    {
        UpdateBattleStatus();
    }
    
    [ContextMenu("Toggle Logging")]
    public void ToggleLogging()
    {
        enableLogging = !enableLogging;
        Debug.Log("Logging " + (enableLogging ? "ENABLED" : "DISABLED"));
    }
    
    [ContextMenu("Reset Battle")]
    public void ResetBattleFromMonitor()
    {
        GameManager gameManager = FindObjectOfType<GameManager>();
        if (gameManager != null)
        {
            gameManager.ResetBattle();
            Debug.Log("🔄 Battle reset from monitor!");
        }
    }
    
    [ContextMenu("Start New Battle")]
    public void StartNewBattleFromMonitor()
    {
        GameManager gameManager = FindObjectOfType<GameManager>();
        if (gameManager != null)
        {
            gameManager.StartBattle();
            Debug.Log("🚀 New battle started from monitor!");
        }
    }
}
