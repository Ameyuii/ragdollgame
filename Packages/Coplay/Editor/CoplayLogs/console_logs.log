[INFO] Func: write_to_file Args: path: Assets/Scripts/FixInputSystemUI.cs, content: using UnityEngine;
using UnityEngine.EventSystems;
using UnityEngine.InputSystem;
using UnityEngine.InputSystem.UI;

public class FixInputSystemUI
{
    public static void Execute()
    {
        // Find the EventSystem
        EventSystem eventSystem = Object.FindObjectOfType<EventSystem>();
        if (eventSystem == null)
        {
            Debug.LogError("EventSystem not found!");
            return;
        }

        // Get the InputSystemUIInputModule
        InputSystemUIInputModule inputModule = eventSystem.GetComponent<InputSystemUIInputModule>();
        if (inputModule == null)
        {
            Debug.LogError("InputSystemUIInputModule not found!");
            return;
        }

        // Load the Input Actions asset
        InputActionAsset inputActions = Resources.Load<InputActionAsset>("InputSystem_Actions");
        if (inputActions == null)
        {
            // Try loading from Assets folder
            inputActions = UnityEditor.AssetDatabase.LoadAssetAtPath<InputActionAsset>("Assets/InputSystem_Actions.inputactions");
        }

        if (inputActions == null)
        {
            Debug.LogError("InputSystem_Actions asset not found!");
            return;
        }

        // Get the UI action map
        InputActionMap uiActionMap = inputActions.FindActionMap("UI");
        if (uiActionMap == null)
        {
            Debug.LogError("UI action map not found!");
            return;
        }

        // Set up the action references
        inputModule.actionsAsset = inputActions;
        
        // Set individual action references
        inputModule.point = InputActionReference.Create(uiActionMap.FindAction("Point"));
        inputModule.leftClick = InputActionReference.Create(uiActionMap.FindAction("Click"));
        inputModule.rightClick = InputActionReference.Create(uiActionMap.FindAction("RightClick"));
        inputModule.middleClick = InputActionReference.Create(uiActionMap.FindAction("MiddleClick"));
        inputModule.move = InputActionReference.Create(uiActionMap.FindAction("Navigate"));
        inputModule.submit = InputActionReference.Create(uiActionMap.FindAction("Submit"));
        inputModule.cancel = InputActionReference.Create(uiActionMap.FindAction("Cancel"));
        inputModule.scrollWheel = InputActionReference.Create(uiActionMap.FindAction("ScrollWheel"));

        Debug.Log("InputSystemUIInputModule configured successfully!");
    }
}
