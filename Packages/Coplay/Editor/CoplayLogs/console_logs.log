        if (eventSystem != null)
        {
            Debug.Log($"EventSystem found and enabled: {eventSystem.enabled}");
        }
        else
        {
            Debug.LogError("EventSystem not found!");
        }
        
        Debug.Log("=== END TEST ===");
    }
}
