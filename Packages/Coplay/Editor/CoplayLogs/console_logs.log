[INFO] Func: write_to_file Args: path: Assets/Scripts/ForceRefreshUI.cs, content: using UnityEngine;

public class ForceRefreshUI : MonoBehaviour
{
    public static void Execute()
    {
        Debug.Log("=== FORCE REFRESH UI ===");
        
        // Find and refresh CharacterSelectionUI
        CharacterSelectionUI ui = FindObjectOfType<CharacterSelectionUI>();
        if (ui != null)
        {
            Debug.Log("Found CharacterSelectionUI, calling RefreshUI...");
            ui.RefreshUI();
        }
        else
        {
            Debug.LogError("CharacterSelectionUI not found!");
        }
        
        // Also check BattleGameManager prefabs
        BattleGameManager gameManager = FindObjectOfType<BattleGameManager>();
        if (gameManager != null && gameManager.characterPrefabs != null)
        {
            Debug.Log($"BattleGameManager found with {gameManager.characterPrefabs.Length} prefabs:");
            for (int i = 0; i < gameManager.characterPrefabs.Length; i++)
            {
                GameObject prefab = gameManager.characterPrefabs[i];
                if (prefab != null)
                    Debug.Log($"  [{i}] {prefab.name}");
                else
                    Debug.Log($"  [{i}] NULL");
            }
        }
        else
        {
            Debug.LogError("BattleGameManager not found or no prefabs!");
        }
        
        Debug.Log("=== END FORCE REFRESH ===");
    }
}
