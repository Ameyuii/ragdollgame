public class SetupRagdollForNPC : MonoBehaviour
{
    public static void Execute()
    {
        GameObject npc = GameObject.Find("npc Variant");
        if (npc == null)
        {
            Debug.LogError("NPC Variant not found!");
            return;
        }
        
        // Setup ragdoll physics for all child bones
        SetupRagdollRecursive(npc.transform);
        
        Debug.Log("Ragdoll setup completed for NPC Variant");
    }
    
    static void SetupRagdollRecursive(Transform parent)
    {
        foreach (Transform child in parent)
        {
            // Skip if it's the root or already has components
            if (child == parent || child.name.Contains("SK_Military"))
            {
                SetupRagdollRecursive(child);
                continue;
            }
            
            // Add Rigidbody
            Rigidbody rb = child.GetComponent<Rigidbody>();
            if (rb == null)
            {
                rb = child.gameObject.AddComponent<Rigidbody>();
                rb.mass = 0.5f;
                rb.drag = 0.1f;
                rb.angularDrag = 0.1f;
                rb.isKinematic = true; // Start as kinematic
            }
            
            // Add appropriate collider based on bone name
            Collider col = child.GetComponent<Collider>();
            if (col == null)
            {
                if (child.name.Contains("head"))
                {
                    SphereCollider sphereCol = child.gameObject.AddComponent<SphereCollider>();
                    sphereCol.radius = 0.08f;
                }
                else if (child.name.Contains("hand") || child.name.Contains("foot"))
                {
                    BoxCollider boxCol = child.gameObject.AddComponent<BoxCollider>();
                    boxCol.size = new Vector3(0.06f, 0.06f, 0.06f);
                }
                else if (child.name.Contains("pelvis") || child.name.Contains("spine"))
                {
                    BoxCollider boxCol = child.gameObject.AddComponent<BoxCollider>();
                    boxCol.size = new Vector3(0.15f, 0.1f, 0.1f);
                }
                else if (child.name.Contains("thigh") || child.name.Contains("calf") || 
                         child.name.Contains("upperarm") || child.name.Contains("lowerarm"))
                {
                    CapsuleCollider capsuleCol = child.gameObject.AddComponent<CapsuleCollider>();
                    capsuleCol.radius = 0.03f;
                    capsuleCol.height = 0.15f;
                    capsuleCol.direction = 1; // Y-axis
                }
                else
                {
                    // Default small collider for other bones
                    SphereCollider sphereCol = child.gameObject.AddComponent<SphereCollider>();
                    sphereCol.radius = 0.02f;
                }
                
                col = child.GetComponent<Collider>();
                col.enabled = false; // Start disabled
            }
            
            // Add joints for main bones
            if (ShouldHaveJoint(child.name) && child.parent != null)
            {
                CharacterJoint joint = child.GetComponent<CharacterJoint>();
                if (joint == null)
                {
                    joint = child.gameObject.AddComponent<CharacterJoint>();
                    
                    // Find connected body (parent with rigidbody)
                    Transform parentTransform = child.parent;
                    while (parentTransform != null)
                    {
                        Rigidbody parentRb = parentTransform.GetComponent<Rigidbody>();
                        if (parentRb != null)
                        {
                            joint.connectedBody = parentRb;
                            break;
                        }
                        parentTransform = parentTransform.parent;
                    }
                    
                    // Set joint limits based on bone type
                    SetJointLimits(joint, child.name);
                }
            }
            
            // Recursively setup children
            SetupRagdollRecursive(child);
        }
    }
    
    static bool ShouldHaveJoint(string boneName)
    {
        return boneName.Contains("pelvis") || boneName.Contains("spine") || 
               boneName.Contains("thigh") || boneName.Contains("calf") ||
               boneName.Contains("upperarm") || boneName.Contains("lowerarm") ||
               boneName.Contains("hand") || boneName.Contains("foot") ||
               boneName.Contains("head") || boneName.Contains("neck");
    }
    
    static void SetJointLimits(CharacterJoint joint, string boneName)
    {
        if (boneName.Contains("spine") || boneName.Contains("neck"))
        {
            joint.swing1Limit = new SoftJointLimit { limit = 20f };
            joint.swing2Limit = new SoftJointLimit { limit = 20f };
            joint.highTwistLimit = new SoftJointLimit { limit = 10f };
            joint.lowTwistLimit = new SoftJointLimit { limit = -10f };
        }
        else if (boneName.Contains("thigh"))
        {
            joint.swing1Limit = new SoftJointLimit { limit = 60f };
            joint.swing2Limit = new SoftJointLimit { limit = 30f };
            joint.highTwistLimit = new SoftJointLimit { limit = 30f };
            joint.lowTwistLimit = new SoftJointLimit { limit = -30f };
        }
        else if (boneName.Contains("calf"))
        {
            joint.swing1Limit = new SoftJointLimit { limit = 0f };
            joint.swing2Limit = new SoftJointLimit { limit = 0f };
            joint.highTwistLimit = new SoftJointLimit { limit = 0f };
            joint.lowTwistLimit = new SoftJointLimit { limit = -90f };
        }
        else if (boneName.Contains("upperarm"))
        {
            joint.swing1Limit = new SoftJointLimit { limit = 80f };
            joint.swing2Limit = new SoftJointLimit { limit = 40f };
            joint.highTwistLimit = new SoftJointLimit { limit = 40f };
            joint.lowTwistLimit = new SoftJointLimit { limit = -40f };
        }
        else if (boneName.Contains("lowerarm"))
        {
            joint.swing1Limit = new SoftJointLimit { limit = 0f };
            joint.swing2Limit = new SoftJointLimit { limit = 0f };
            joint.highTwistLimit = new SoftJointLimit { limit = 0f };
            joint.lowTwistLimit = new SoftJointLimit { limit = -120f };
        }
        else
        {
            // Default limits
            joint.swing1Limit = new SoftJointLimit { limit = 30f };
            joint.swing2Limit = new SoftJointLimit { limit = 30f };
            joint.highTwistLimit = new SoftJointLimit { limit = 20f };
            joint.lowTwistLimit = new SoftJointLimit { limit = -20f };
        }
    }
}
