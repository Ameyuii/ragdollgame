/// <summary>
/// Bridge between new character system and legacy UI/code
/// Maintains compatibility while gradually introducing new features
/// </summary>
public class LegacySystemBridge : MonoBehaviour
{
    [Header("Bridge Settings")]
    public bool enableNewSystemIntegration = false;
    public bool logBridgeActivity = true;

    [Header("Legacy System References")]
    public BattleGameManager legacyGameManager;

    private static LegacySystemBridge _instance;
    public static LegacySystemBridge Instance
    {
        get
        {
            if (_instance == null)
            {
                _instance = FindObjectOfType<LegacySystemBridge>();
            }
            return _instance;
        }
    }

    void Awake()
    {
        if (_instance == null)
        {
            _instance = this;
        }
        else if (_instance != this)
        {
            Destroy(gameObject);
            return;
        }

        InitializeBridge();
    }

    private void InitializeBridge()
    {
        // Find legacy game manager if not assigned
        if (legacyGameManager == null)
        {
            legacyGameManager = FindObjectOfType<BattleGameManager>();
        }

        if (logBridgeActivity)
        {
            Debug.Log($"[LegacyBridge] Bridge initialized. New system integration: {enableNewSystemIntegration}");
        }
    }

    /// <summary>
    /// Spawn character - this method will be called by existing drag & drop system
    /// </summary>
    public GameObject SpawnCharacterAtPosition(Vector3 position, int teamID = 1, string characterID = null)
    {
        if (enableNewSystemIntegration && CharacterSystemManager.Instance.ShouldUseNewSystem())
        {
            return SpawnUsingNewSystem(position, teamID, characterID);
        }
        else
        {
            return SpawnUsingLegacySystem(position, teamID);
        }
    }

    private GameObject SpawnUsingNewSystem(Vector3 position, int teamID, string characterID)
    {
        if (logBridgeActivity)
        {
            Debug.Log($"[LegacyBridge] Spawning character using NEW system: {characterID} at {position}");
        }

        // Use default character if none specified
        if (string.IsNullOrEmpty(characterID))
        {
            characterID = "warrior_basic_default_01"; // Default test character
        }

        // Spawn using new system
        GameObject character = CharacterSystemManager.Instance.SpawnCharacter(
            characterID, "default", teamID, position);

        if (character != null)
        {
            // Apply legacy compatibility
            ApplyLegacyCompatibility(character, teamID);
        }

        return character;
    }

    private GameObject SpawnUsingLegacySystem(Vector3 position, int teamID)
    {
        if (logBridgeActivity)
        {
            Debug.Log($"[LegacyBridge] Spawning character using LEGACY system at {position}");
        }

        // Use legacy system
        if (legacyGameManager != null)
        {
            // Call legacy spawn method - this would need to be adapted based on actual legacy implementation
            // For now, we'll just return null to indicate legacy system should handle it
            return null;
        }

        return null;
    }

    /// <summary>
    /// Apply legacy compatibility to characters spawned with new system
    /// </summary>
    private void ApplyLegacyCompatibility(GameObject character, int teamID)
    {
        // Ensure character has RagdollCharacter component for legacy compatibility
        RagdollCharacter ragdoll = character.GetComponent<RagdollCharacter>();
        if (ragdoll == null)
        {
            ragdoll = character.AddComponent<RagdollCharacter>();
            ragdoll.teamId = teamID;
        }

        // Copy stats from enhanced controller to legacy controller
        EnhancedCharacterController enhanced = character.GetComponent<EnhancedCharacterController>();
        if (enhanced != null && ragdoll != null)
        {
            CharacterStats stats = enhanced.CurrentStats;
            ragdoll.maxHealth = stats.maxHealth;
            ragdoll.moveSpeed = stats.moveSpeed;
            ragdoll.attackDamage = stats.attackDamage;
            ragdoll.attackRange = stats.attackRange;
            ragdoll.attackCooldown = stats.attackCooldown;
            ragdoll.teamId = teamID;
        }

        // Apply team materials using legacy method
        ApplyLegacyTeamMaterials(character, teamID);
    }

    /// <summary>
    /// Apply team materials using legacy method
    /// </summary>
    private void ApplyLegacyTeamMaterials(GameObject character, int teamID)
    {
        // Load team materials from Resources (legacy approach)
        Material teamMaterial = null;
        
        if (teamID == 1)
        {
            teamMaterial = Resources.Load<Material>("Team1_Blue");
        }
        else if (teamID == 2)
        {
            teamMaterial = Resources.Load<Material>("Team2_Red");
        }

        if (teamMaterial != null)
        {
            // Apply to all renderers
            Renderer[] renderers = character.GetComponentsInChildren<Renderer>();
            foreach (Renderer renderer in renderers)
            {
                if (renderer != null)
                {
                    renderer.material = teamMaterial;
                }
            }
        }
    }

    /// <summary>
    /// Enable new system integration (can be called from UI)
    /// </summary>
    public void EnableNewSystemIntegration()
    {
        enableNewSystemIntegration = true;
        
        // Also enable in GameDatabase
        GameDatabase gameDB = GameDatabase.Instance;
        if (gameDB != null)
        {
            gameDB.enableNewSystem = true;
        }

        if (logBridgeActivity)
        {
            Debug.Log("[LegacyBridge] New system integration ENABLED");
        }
    }

    /// <summary>
    /// Disable new system integration (fallback to legacy)
    /// </summary>
    public void DisableNewSystemIntegration()
    {
        enableNewSystemIntegration = false;
        
        // Also disable in GameDatabase
        GameDatabase gameDB = GameDatabase.Instance;
        if (gameDB != null)
        {
            gameDB.enableNewSystem = false;
        }

        if (logBridgeActivity)
        {
            Debug.Log("[LegacyBridge] New system integration DISABLED - using legacy system");
        }
    }

    /// <summary>
    /// Check if new system is ready and should be used
    /// </summary>
    public bool IsNewSystemReady()
    {
        return enableNewSystemIntegration && 
               CharacterSystemManager.Instance != null && 
               CharacterSystemManager.Instance.ShouldUseNewSystem();
    }
}
