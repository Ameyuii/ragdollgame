    void Die()
    {
        isDead = true;
        
        // Trigger death animation
        if (animator != null)
        {
            animator.SetTrigger("Death");
            animator.SetBool("IsAlive", false);
        }
        
        // Delay ragdoll activation to let death animation play
        StartCoroutine(DelayedRagdollActivation());
        
        // Notify GameManager
        if (GameManager.Instance != null)
        {
            GameManager.Instance.OnCharacterDied(this);
        }
        
        // Destroy after some time
        Destroy(gameObject, 10f);
    }
    
    System.Collections.IEnumerator DelayedRagdollActivation()
    {
        yield return new WaitForSeconds(1.5f); // Let death animation play
        SetRagdollState(true);
    }
