                    teamHandler.SelectTeam(2);
                    Debug.Log($"After SelectTeam(2): BattleGameManager.selectedTeam = {battleManager.selectedTeam}");
                }
            }
        }
        catch (System.Exception e)
        {
            Debug.LogError($"Error in SimpleDebugTeam: {e.Message}");
        }
        
        Debug.Log("=== DEBUG END ===");
    }
}
