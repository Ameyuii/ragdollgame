[INFO] Func: write_to_file Args: path: Assets/Scripts/FinalTeamTest.cs, content: using UnityEngine;

public class FinalTeamTest
{
    public static void Execute()
    {
        Debug.Log("=== FINAL TEAM SELECTION TEST ===");
        
        // Find components
        TeamSelectionHandler teamHandler = Object.FindObjectOfType<TeamSelectionHandler>();
        BattleGameManager gameManager = Object.FindObjectOfType<BattleGameManager>();
        
        Debug.Log($"TeamSelectionHandler found: {teamHandler != null}");
        Debug.Log($"BattleGameManager found: {gameManager != null}");
        
        if (teamHandler != null && gameManager != null)
        {
            // Test current state
            Debug.Log($"Initial state - TeamHandler: {teamHandler.selectedTeam}, GameManager: {gameManager.selectedTeam}");
            
            // Test team switching
            Debug.Log("Testing team switch to Team 2...");
            teamHandler.SelectTeam(2);
            Debug.Log($"After switch - TeamHandler: {teamHandler.selectedTeam}, GameManager: {gameManager.selectedTeam}");
            
            // Test team switching back to Team 1
            Debug.Log("Testing team switch to Team 1...");
            teamHandler.SelectTeam(1);
            Debug.Log($"After switch back - TeamHandler: {teamHandler.selectedTeam}, GameManager: {gameManager.selectedTeam}");
            
            // Check UI elements
            var dropdownText = GameObject.Find("TeamDropdownButton/Text")?.GetComponent<UnityEngine.UI.Text>();
            var selectedText = GameObject.Find("SelectedTeamDisplay/Text")?.GetComponent<UnityEngine.UI.Text>();
            
            Debug.Log($"Dropdown text: '{(dropdownText != null ? dropdownText.text : "NOT FOUND")}'");
            Debug.Log($"Selected text: '{(selectedText != null ? selectedText.text : "NOT FOUND")}'");
            
            // Test spawning with different teams
            Debug.Log("Testing character spawn simulation...");
            gameManager.SelectTeam(1);
            Debug.Log($"Team 1 selected for spawn: {gameManager.selectedTeam}");
            
            gameManager.SelectTeam(2);
            Debug.Log($"Team 2 selected for spawn: {gameManager.selectedTeam}");
            
            Debug.Log("✅ TEAM SELECTION IS WORKING CORRECTLY!");
        }
        else
        {
            Debug.LogError("❌ Required components missing!");
        }
        
        Debug.Log("=== TEST COMPLETE ===");
    }
}
