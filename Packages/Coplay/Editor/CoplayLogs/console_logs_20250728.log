using UnityEditor;

public class CreateCharacterRegistryAsset
{
    public static void Execute()
    {
        // Tạo instance của CharacterRegistry
        var characterRegistry = ScriptableObject.CreateInstance<CharacterRegistry>();
        
        // Configure settings như yêu cầu
        characterRegistry.enableAutoDiscovery = true;
        characterRegistry.basePath = "Assets/Resources/Characters";
        characterRegistry.autoGenerateIcons = true;
        
        // Tạo asset trong folder Assets/Data/
        string assetPath = "Assets/Data/CharacterRegistry.asset";
        AssetDatabase.CreateAsset(characterRegistry, assetPath);
        AssetDatabase.SaveAssets();
        AssetDatabase.Refresh();
        
        // Select asset trong Project window
        Selection.activeObject = characterRegistry;
        EditorGUIUtility.PingObject(characterRegistry);
        
        Debug.Log($"✅ CharacterRegistry asset đã được tạo tại: {assetPath}");
        Debug.Log("📋 Settings đã được cấu hình:");
        Debug.Log($"   - Enable Auto Discovery: {characterRegistry.enableAutoDiscovery}");
        Debug.Log($"   - Base Path: {characterRegistry.basePath}");
        Debug.Log($"   - Auto Generate Icons: {characterRegistry.autoGenerateIcons}");
    }
}
