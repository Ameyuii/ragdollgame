2025-07-28 21:37:24.017 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/SimpleTeamFix.cs, content: using UnityEngine;

public class SimpleTeamFix
{
    [UnityEditor.MenuItem("Debug/Fix Team Dropdown")]
    public static void FixTeamDropdown()
    {
        // Find all GameObjects including inactive ones
        GameObject[] allObjects = Resources.FindObjectsOfTypeAll<GameObject>();
        
        foreach (GameObject obj in allObjects)
        {
            if (obj.name == "BottomCharacterPanel")
            {
                obj.SetActive(true);
                Debug.Log("✅ Activated BottomCharacterPanel");
                break;
            }
        }
    }
}
