using UnityEngine.UI;

public class CharacterSelectionPanelController : MonoBehaviour
{
    [Header("UI References")]
    public GameObject characterSelectionPanel;
    public Text selectionTitle;
    public Transform characterContainer;
    
    [Header("Category Buttons")]
    public Button robotButton;
    public Button monsterButton;
    public Button warriorButton;
    public Button zombieButton;
    public Button closeButton;
    
    [Header("Character Data")]
    public CharacterData[] robotCharacters;
    public CharacterData[] monsterCharacters;
    public CharacterData[] warriorCharacters;
    public CharacterData[] zombieCharacters;
    
    [System.Serializable]
    public class CharacterData
    {
        public string characterName;
        public GameObject characterPrefab;
        public Sprite characterIcon;
    }
    
    void Start()
    {
        // Skip initialization if UI was cleaned up
        if (characterSelectionPanel == null)
        {
            Debug.Log("CharacterSelectionPanelController: Panel reference missing, disabling component");
            this.enabled = false;
            return;
        }
        
        // Hide panel initially
        characterSelectionPanel.SetActive(false);
        
        // Connect category buttons
        if (robotButton) robotButton.onClick.AddListener(() => ShowCharacters("ROBOT", robotCharacters));
        if (monsterButton) monsterButton.onClick.AddListener(() => ShowCharacters("QUÁI VẬT", monsterCharacters));
        if (warriorButton) warriorButton.onClick.AddListener(() => ShowCharacters("CHIẾN BINH", warriorCharacters));
        if (zombieButton) zombieButton.onClick.AddListener(() => ShowCharacters("ZOMBIE", zombieCharacters));
        
        // Connect close button
        if (closeButton) closeButton.onClick.AddListener(HidePanel);
    }
    
    public void ShowCharacters(string categoryName, CharacterData[] characters)
    {
        if (characterSelectionPanel == null) return;
        
        // Update title
        if (selectionTitle) selectionTitle.text = $"CHỌN NHÂN VẬT - {categoryName}";
        
        // Clear existing character buttons
        if (characterContainer != null)
        {
            foreach (Transform child in characterContainer)
            {
                if (child.name.Contains("Character"))
                    Destroy(child.gameObject);
            }
        }
        
        // Create character buttons
        for (int i = 0; i < characters.Length; i++)
        {
            CreateCharacterButton(characters[i], i);
        }
        
        // Show panel
        characterSelectionPanel.SetActive(true);
    }
    
    void CreateCharacterButton(CharacterData data, int index)
    {
        GameObject buttonObj = new GameObject($"CharacterButton_{index}");
        buttonObj.transform.SetParent(characterContainer, false);
        
        // Add Image component
        Image buttonImage = buttonObj.AddComponent<Image>();
        buttonImage.color = new Color(0.4f, 0.4f, 0.4f, 1f);
        
        // Add Button component
        Button button = buttonObj.AddComponent<Button>();
        
        // Set size
        RectTransform rectTransform = buttonObj.GetComponent<RectTransform>();
        rectTransform.sizeDelta = new Vector2(120, 120);
        
        // Add text
        GameObject textObj = new GameObject("Text");
        textObj.transform.SetParent(buttonObj.transform, false);
        
        Text text = textObj.AddComponent<Text>();
        text.text = data.characterName;
        text.font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
        text.fontSize = 12;
        text.color = Color.white;
        text.alignment = TextAnchor.MiddleCenter;
        
        RectTransform textRect = textObj.GetComponent<RectTransform>();
        textRect.anchorMin = Vector2.zero;
        textRect.anchorMax = Vector2.one;
        textRect.offsetMin = Vector2.zero;
        textRect.offsetMax = Vector2.zero;
        
        // Add click functionality
        button.onClick.AddListener(() => SelectCharacter(data));
        
        // Add drag functionality if needed
        CharacterDragHandler dragHandler = buttonObj.AddComponent<CharacterDragHandler>();
        dragHandler.characterPrefab = data.characterPrefab;
    }
    
    void SelectCharacter(CharacterData data)
    {
        // Set selected character in game manager
        BattleGameManager gameManager = FindObjectOfType<BattleGameManager>();
        if (gameManager)
        {
            // You can implement character selection logic here
            Debug.Log($"Selected character: {data.characterName}");
        }
    }
    
    public void HidePanel()
    {
        if (characterSelectionPanel != null)
        {
            characterSelectionPanel.SetActive(false);
        }
    }
}

[System.Serializable]
public class CharacterDragHandler : MonoBehaviour, UnityEngine.EventSystems.IBeginDragHandler, UnityEngine.EventSystems.IDragHandler, UnityEngine.EventSystems.IEndDragHandler
{
    public GameObject characterPrefab;
    private GameObject dragObject;
    private Canvas canvas;
    private RectTransform canvasRect;
    
    void Start()
    {
        canvas = FindObjectOfType<Canvas>();
        canvasRect = canvas.GetComponent<RectTransform>();
    }
    
    public void OnBeginDrag(UnityEngine.EventSystems.PointerEventData eventData)
    {
        // Create visual feedback
        dragObject = new GameObject("DragPreview");
        dragObject.transform.SetParent(canvas.transform, false);
        
        Image dragImage = dragObject.AddComponent<Image>();
        dragImage.color = new Color(1, 1, 1, 0.6f);
        dragImage.raycastTarget = false;
        
        RectTransform dragRect = dragObject.GetComponent<RectTransform>();
        dragRect.sizeDelta = new Vector2(80, 80);
    }
    
    public void OnDrag(UnityEngine.EventSystems.PointerEventData eventData)
    {
        if (dragObject)
        {
            Vector2 localPoint;
            RectTransformUtility.ScreenPointToLocalPointInRectangle(canvasRect, eventData.position, eventData.pressEventCamera, out localPoint);
            dragObject.transform.localPosition = localPoint;
        }
    }
    
    public void OnEndDrag(UnityEngine.EventSystems.PointerEventData eventData)
    {
        if (dragObject)
        {
            Destroy(dragObject);
        }
        
        // Try to spawn character at drop location
        MapDropZone dropZone = FindObjectOfType<MapDropZone>();
        if (dropZone && characterPrefab)
        {
            // Check if dropped on valid area
            Vector3 worldPosition;
            if (RectTransformUtility.ScreenPointToWorldPointInRectangle(canvasRect, eventData.position, eventData.pressEventCamera, out worldPosition))
            {
                // Spawn character via game manager
                BattleGameManager gameManager = FindObjectOfType<BattleGameManager>();
                if (gameManager)
                {
                    // Simple character spawning
                    GameObject spawnedCharacter = Instantiate(characterPrefab, worldPosition, Quaternion.identity);
                    Debug.Log($"Spawned character: {characterPrefab.name} at {worldPosition}");
                }
            }
        }
    }
}

