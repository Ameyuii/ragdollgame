    void CreateCharacterButtons()
    {
        if (modelContentArea == null || currentPrefabs == null)
        {
            Debug.LogWarning("⚠️ ModelContentArea or currentPrefabs is null!");
            return;
        }
        
        // Clear existing buttons
        foreach (Transform child in modelContentArea)
        {
            DestroyImmediate(child.gameObject);
        }
        
        // Create buttons for each character
        for (int i = 0; i < currentPrefabs.Length; i++)
        {
            GameObject prefab = currentPrefabs[i];
            if (prefab == null) continue;
            
            // Create button
            GameObject buttonObj = new GameObject($"CharacterButton_{i}");
            buttonObj.transform.SetParent(modelContentArea);
            
            // Add Button component
            Button button = buttonObj.AddComponent<Button>();
            
            // Add Image component for button background
            Image buttonImage = buttonObj.AddComponent<Image>();
            buttonImage.color = new Color(0.2f, 0.3f, 0.8f, 0.8f);
            
            // Add RectTransform
            RectTransform rectTransform = buttonObj.GetComponent<RectTransform>();
            rectTransform.sizeDelta = new Vector2(100, 100);
            rectTransform.localScale = Vector3.one;
            
            // Add text label
            GameObject textObj = new GameObject("Text");
            textObj.transform.SetParent(buttonObj.transform);
            Text buttonText = textObj.AddComponent<Text>();
            buttonText.text = prefab.name;
            buttonText.font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
            buttonText.fontSize = 12;
            buttonText.color = Color.white;
            buttonText.alignment = TextAnchor.MiddleCenter;
            
            RectTransform textRect = textObj.GetComponent<RectTransform>();
            textRect.anchorMin = Vector2.zero;
            textRect.anchorMax = Vector2.one;
            textRect.sizeDelta = Vector2.zero;
            textRect.anchoredPosition = Vector2.zero;
            textRect.localScale = Vector3.one;
            
            // Add click listener
            GameObject prefabToSpawn = prefab; // Capture for closure
            button.onClick.AddListener(() => SpawnCharacter(prefabToSpawn));
        }
        
        if (enableDebugLogs) Debug.Log($"✅ Created {currentPrefabs.Length} character buttons");
    }
    
