2025-07-28 09:42:00.961 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/Utils/DetailedTextDebug.cs, content: using UnityEngine;
using UnityEngine.UI;

public class DetailedTextDebug
{
    public static void Execute()
    {
        Debug.Log("🔍 Detailed text debugging...");

        GameObject panel = GameObject.Find("TeamDropdownPanel");
        if (panel == null)
        {
            Debug.LogError("❌ TeamDropdownPanel not found!");
            return;
        }

        Debug.Log($"📋 Panel active: {panel.activeInHierarchy}");
        Debug.Log($"📋 Panel position: {panel.transform.position}");

        // Check each team button
        for (int i = 1; i <= 4; i++)
        {
            Transform buttonTransform = panel.transform.Find($"Team{i}Option");
            if (buttonTransform != null)
            {
                GameObject button = buttonTransform.gameObject;
                Text textComponent = button.GetComponentInChildren<Text>();
                
                Debug.Log($"🔧 Team{i}Option:");
                Debug.Log($"   - Button Active: {button.activeInHierarchy}");
                Debug.Log($"   - Button Position: {button.transform.position}");
                Debug.Log($"   - Button Size: {button.GetComponent<RectTransform>().sizeDelta}");
                
                if (textComponent != null)
                {
                    Debug.Log($"   - Text: '{textComponent.text}'");
                    Debug.Log($"   - Text Active: {textComponent.gameObject.activeInHierarchy}");
                    Debug.Log($"   - Text Enabled: {textComponent.enabled}");
                    Debug.Log($"   - Font Size: {textComponent.fontSize}");
                    Debug.Log($"   - Color: {textComponent.color}");
                    Debug.Log($"   - Text Position: {textComponent.transform.position}");
                    Debug.Log($"   - Text Size: {textComponent.GetComponent<RectTransform>().sizeDelta}");
                    
                    // Force visible settings
                    textComponent.text = $"TEAM {i}";
                    textComponent.fontSize = 20;
                    textComponent.color = Color.yellow; // Bright color to make sure it's visible
                    textComponent.alignment = TextAnchor.MiddleCenter;
                    textComponent.enabled = true;
                    textComponent.gameObject.SetActive(true);
                    
                    Debug.Log($"✅ Applied bright yellow text to Team{i}Option");
                }
                else
                {
                    Debug.LogError($"❌ Text component not found in Team{i}Option");
                }
            }
            else
            {
                Debug.LogError($"❌ Team{i}Option not found");
            }
        }

        Debug.Log("🎯 Detailed debug completed!");
    }
}
