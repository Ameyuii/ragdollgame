2025-07-28 09:29:55.587 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/Utils/FindAndFixTeamButtons.cs, content: using UnityEngine;
using UnityEngine.UI;

public class FindAndFixTeamButtons
{
    public static void Execute()
    {
        Debug.Log("🔍 Searching for team buttons in scene...");

        // Find all Text components in scene
        Text[] allTexts = Object.FindObjectsOfType<Text>(true); // true to include inactive
        
        foreach (Text text in allTexts)
        {
            string objName = text.transform.parent?.name;
            
            if (objName == "Team1Option")
            {
                text.text = "TEAM 1";
                text.fontSize = 16;
                text.alignment = TextAnchor.MiddleCenter;
                text.color = Color.white;
                Debug.Log("✅ Fixed Team1Option text");
            }
            else if (objName == "Team2Option")
            {
                text.text = "TEAM 2";
                text.fontSize = 16;
                text.alignment = TextAnchor.MiddleCenter;
                text.color = Color.white;
                Debug.Log("✅ Fixed Team2Option text");
            }
            else if (objName == "Team3Option")
            {
                text.text = "TEAM 3";
                text.fontSize = 16;
                text.alignment = TextAnchor.MiddleCenter;
                text.color = Color.white;
                Debug.Log("✅ Fixed Team3Option text");
            }
            else if (objName == "Team4Option")
            {
                text.text = "TEAM 4";
                text.fontSize = 16;
                text.alignment = TextAnchor.MiddleCenter;
                text.color = Color.white;
                Debug.Log("✅ Fixed Team4Option text");
            }
        }

        Debug.Log("🎯 Team button text search completed!");
    }
}
