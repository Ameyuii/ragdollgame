2025-07-28 21:31:14.577 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/CheckCharacterState.cs, content: using UnityEngine;
using UnityEngine.AI;

public class CheckCharacterState : MonoBehaviour
{
    public static void Execute()
    {
        Debug.Log("=== CHECKING CHARACTER STATE ===");
        
        // Find all RagdollCharacter
        RagdollCharacter[] allCharacters = FindObjectsByType<RagdollCharacter>(FindObjectsSortMode.None);
        Debug.Log($"Found {allCharacters.Length} RagdollCharacter in scene");
        
        foreach (RagdollCharacter character in allCharacters)
        {
            Debug.Log($"\n--- Character: {character.name} ---");
            Debug.Log($"Position: {character.transform.position}");
            Debug.Log($"Team ID: {character.teamId}");
            Debug.Log($"Is Dead: {character.IsDead()}");
            
            // Check SimpleCharacterAI
            SimpleCharacterAI ai = character.GetComponent<SimpleCharacterAI>();
            if (ai != null)
            {
                Debug.Log($"SimpleCharacterAI: EXISTS, Enabled: {ai.enabled}");
                Debug.Log($"Detection Range: {ai.detectionRange}, Attack Range: {ai.attackRange}");
            }
            else
            {
                Debug.Log("SimpleCharacterAI: NOT FOUND");
            }
            
            // Check NavMeshAgent
            NavMeshAgent agent = character.GetComponent<NavMeshAgent>();
            if (agent != null)
            {
                Debug.Log($"NavMeshAgent: EXISTS, Enabled: {agent.enabled}");
                Debug.Log($"IsOnNavMesh: {agent.isOnNavMesh}");
                Debug.Log($"Speed: {agent.speed}");
                if (agent.isOnNavMesh)
                {
                    Debug.Log($"Has Path: {agent.hasPath}, Velocity: {agent.velocity.magnitude:F2}");
                }
            }
            else
            {
                Debug.Log("NavMeshAgent: NOT FOUND");
            }
        }
        
        // Check AutoAIManager
        AutoAIManager aiManager = FindAnyObjectByType<AutoAIManager>();
        if (aiManager != null)
        {
            Debug.Log($"\n--- AutoAIManager ---");
            Debug.Log($"Enable Auto AI: {aiManager.enableAutoAI}");
        }
        else
        {
            Debug.Log("\nAutoAIManager: NOT FOUND");
        }
        
        // Check NavMesh surface
        Debug.Log($"\n--- NavMesh Check ---");
        NavMeshHit hit;
        Vector3 groundPos = new Vector3(0, 0, 0);
        if (NavMesh.SamplePosition(groundPos, out hit, 10f, NavMesh.AllAreas))
        {
            Debug.Log($"NavMesh found at ground position: {hit.position}");
        }
        else
        {
            Debug.Log("NavMesh NOT FOUND at ground position");
        }
    }
}
