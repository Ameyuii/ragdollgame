    void UpdatePreviewPosition(Vector2 screenPosition)
    {
        if (dragPreview == null || mainCamera == null) return;
        
        // Convert screen position to world position
        Ray ray = mainCamera.ScreenPointToRay(screenPosition);
        
        // Raycast to find ground
        RaycastHit hit;
        if (Physics.Raycast(ray, out hit, Mathf.Infinity))
        {
            if (hit.collider.name == "Ground" || hit.collider.CompareTag("Ground"))
            {
                dragPreview.transform.position = hit.point + Vector3.up * 0.5f;
                return;
            }
        }
        
        // If no ground hit, position at fixed distance from camera
        Vector3 worldPos = ray.origin + ray.direction * 10f;
        worldPos.y = 1f; // Keep above ground level
        dragPreview.transform.position = worldPos;
    }
