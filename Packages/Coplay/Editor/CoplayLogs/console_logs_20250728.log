2025-07-28 21:31:58.978 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/ResetAndCheckBattle.cs, content: using UnityEngine;

public class ResetAndCheckBattle : MonoBehaviour
{
    public static void Execute()
    {
        Debug.Log("=== RESET AND CHECK BATTLE ===");
        
        // Find BattleGameManager
        BattleGameManager battleManager = FindAnyObjectByType<BattleGameManager>();
        if (battleManager != null)
        {
            Debug.Log("Found BattleGameManager, resetting...");
            battleManager.ResetBattle();
            
            // Check state after reset
            Debug.Log($"Game Started: {battleManager.gameStarted}");
            Debug.Log($"Setup Mode: {battleManager.setupMode}");
            Debug.Log($"Team 1 Count: {battleManager.team1AliveCount}");
            Debug.Log($"Team 2 Count: {battleManager.team2AliveCount}");
        }
        else
        {
            Debug.LogError("BattleGameManager not found!");
        }
        
        // Check for any characters in scene
        RagdollCharacter[] allCharacters = FindObjectsByType<RagdollCharacter>(FindObjectsSortMode.None);
        Debug.Log($"Found {allCharacters.Length} RagdollCharacter objects in scene");
        
        foreach (RagdollCharacter character in allCharacters)
        {
            Debug.Log($"- {character.name} (Team: {character.teamId}, Position: {character.transform.position})");
        }
        
        // Check for character clones
        GameObject[] allObjects = FindObjectsByType<GameObject>(FindObjectsSortMode.None);
        int cloneCount = 0;
        foreach (GameObject obj in allObjects)
        {
            if (obj.name.Contains("Clone"))
            {
                cloneCount++;
                Debug.Log($"Found clone: {obj.name} at {obj.transform.position}");
            }
        }
        Debug.Log($"Total clone objects found: {cloneCount}");
    }
}
