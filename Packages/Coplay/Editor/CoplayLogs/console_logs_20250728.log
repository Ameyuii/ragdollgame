using UnityEngine.UI;

public class HealthBarController : MonoBehaviour
{
    [Header("Health Settings")]
    public float maxHealth = 100f;
    public float currentHealth = 100f;
    
    [Header("UI References")]
    public Slider healthSlider;
    public Transform healthBarTransform;
    
    private Camera mainCamera;
    private Canvas healthCanvas;
    
    void Start()
    {
        // Tự động tìm và setup HealthBar
        SetupHealthBar();
        
        // Tìm main camera
        mainCamera = Camera.main;
        if (mainCamera == null)
        {
            mainCamera = FindObjectOfType<Camera>();
        }
        
        // Set full health initially
        currentHealth = maxHealth;
        UpdateHealthBar();
    }
    
    void SetupHealthBar()
    {
        // Tìm HealthBar trong children nếu chưa được assign
        if (healthBarTransform == null)
        {
            healthBarTransform = transform.Find("HealthBar");
        }
        
        if (healthBarTransform != null)
        {
            // Tìm Slider component
            if (healthSlider == null)
            {
                healthSlider = healthBarTransform.GetComponent<Slider>();
            }
            
            // Tìm Canvas component
            healthCanvas = healthBarTransform.GetComponent<Canvas>();
            
            // Setup slider if found
            if (healthSlider != null)
            {
                healthSlider.minValue = 0f;
                healthSlider.maxValue = 1f;
                healthSlider.value = 1f;
                
                // Đảm bảo fillRect được assign
                if (healthSlider.fillRect == null)
                {
                    Transform fillTransform = healthBarTransform.Find("HealthBarBG/HealthBarFill");
                    if (fillTransform != null)
                    {
                        healthSlider.fillRect = fillTransform.GetComponent<RectTransform>();
                    }
                }
            }
            
            // Setup Canvas if found
            if (healthCanvas != null)
            {
                healthCanvas.renderMode = RenderMode.WorldSpace;
                healthCanvas.sortingOrder = 10;
            }
        }
        else
        {
            Debug.LogWarning($"HealthBar không tìm thấy trên {gameObject.name}");
        }
    }
    
    void Update()
    {
        // Luôn hướng về camera
        if (mainCamera != null && healthBarTransform != null)
        {
            healthBarTransform.LookAt(healthBarTransform.position + mainCamera.transform.rotation * Vector3.forward,
                                     mainCamera.transform.rotation * Vector3.up);
        }
    }
    
    public void TakeDamage(float damage)
    {
        currentHealth -= damage;
        currentHealth = Mathf.Clamp(currentHealth, 0f, maxHealth);
        
        UpdateHealthBar();
        
        if (currentHealth <= 0f)
        {
            OnDeath();
        }
    }
    
    public void Heal(float healAmount)
    {
        currentHealth += healAmount;
        currentHealth = Mathf.Clamp(currentHealth, 0f, maxHealth);
        
        UpdateHealthBar();
    }
    
    public void SetHealth(float health)
    {
        currentHealth = Mathf.Clamp(health, 0f, maxHealth);
        UpdateHealthBar();
    }
    
    void UpdateHealthBar()
    {
        if (healthSlider != null)
        {
            float healthPercentage = currentHealth / maxHealth;
            healthSlider.value = healthPercentage;
            
            // Thay đổi màu dựa trên health percentage
            if (healthSlider.fillRect != null)
            {
                Image fillImage = healthSlider.fillRect.GetComponent<Image>();
                if (fillImage != null)
                {
                    if (healthPercentage > 0.6f)
                        fillImage.color = Color.green;
                    else if (healthPercentage > 0.3f)
                        fillImage.color = Color.yellow;
                    else
                        fillImage.color = Color.red;
                }
            }
        }
    }
    
    void OnDeath()
    {
        Debug.Log($"{gameObject.name} đã chết!");
        
        // Có thể thêm animation chết hoặc effects ở đây
        // Ví dụ: trigger death animation, spawn death effects, etc.
        
        // Tạm thời ẩn character (có thể thay bằng destroy hoặc death animation)
        // gameObject.SetActive(false);
    }
    
    // Public getter methods
    public float GetCurrentHealth() { return currentHealth; }
    public float GetMaxHealth() { return maxHealth; }
    public float GetHealthPercentage() { return currentHealth / maxHealth; }
    public bool IsAlive() { return currentHealth > 0f; }
    
    // Method to force refresh health bar setup (useful after instantiation)
    public void RefreshHealthBar()
    {
        SetupHealthBar();
        UpdateHealthBar();
    }
}
