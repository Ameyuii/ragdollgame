    private static void FixButtonText(string buttonName, string textContent)
    {
        // Find in TeamDropdownPanel
        GameObject panel = GameObject.Find("TeamDropdownPanel");
        if (panel != null)
        {
            Transform buttonTransform = panel.transform.Find(buttonName);
            if (buttonTransform != null)
            {
                Text textComponent = buttonTransform.GetComponentInChildren<Text>();
                if (textComponent != null)
                {
                    textComponent.text = textContent;
                    textComponent.fontSize = 16;
                    textComponent.alignment = TextAnchor.MiddleCenter;
                    textComponent.color = Color.white;
