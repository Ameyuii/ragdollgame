    void CreateDragPreview()
    {
        if (characterPrefab == null) return;
        
        // Create a small preview of the character
        dragPreview = Instantiate(characterPrefab);
        dragPreview.name = $"DragPreview_{characterPrefab.name}";
        
        // Scale down the preview
        dragPreview.transform.localScale = Vector3.one * previewScale;
        
        // Remove ALL UI components (Canvas, Text, UI elements)
        Canvas[] canvases = dragPreview.GetComponentsInChildren<Canvas>();
        for (int i = 0; i < canvases.Length; i++)
        {
            DestroyImmediate(canvases[i].gameObject);
        }
        
        Text[] texts = dragPreview.GetComponentsInChildren<Text>();
        for (int i = 0; i < texts.Length; i++)
        {
            DestroyImmediate(texts[i].gameObject);
        }
        
        UnityEngine.UI.Image[] images = dragPreview.GetComponentsInChildren<UnityEngine.UI.Image>();
        for (int i = 0; i < images.Length; i++)
        {
            DestroyImmediate(images[i].gameObject);
        }
        
        // Remove any GameObject with "UI" or "Text" in name
        Transform[] allChildren = dragPreview.GetComponentsInChildren<Transform>();
        for (int i = 0; i < allChildren.Length; i++)
        {
            if (allChildren[i].name.ToLower().Contains("ui") || 
                allChildren[i].name.ToLower().Contains("text") ||
                allChildren[i].name.ToLower().Contains("canvas"))
            {
                DestroyImmediate(allChildren[i].gameObject);
            }
        }
        
        // Disable colliders and unnecessary components
        Collider[] colliders = dragPreview.GetComponentsInChildren<Collider>();
        for (int i = 0; i < colliders.Length; i++)
        {
            colliders[i].enabled = false;
        }
        
        // Disable physics components
        Rigidbody[] rigidbodies = dragPreview.GetComponentsInChildren<Rigidbody>();
        for (int i = 0; i < rigidbodies.Length; i++)
        {
            rigidbodies[i].isKinematic = true;
        }
        
        // Make it semi-transparent
        Renderer[] renderers = dragPreview.GetComponentsInChildren<Renderer>();
        for (int i = 0; i < renderers.Length; i++)
        {
            Material[] materials = renderers[i].materials;
            for (int j = 0; j < materials.Length; j++)
            {
                if (materials[j].HasProperty("_Color"))
                {
                    Color color = materials[j].color;
                    color.a = 0.7f;
                    materials[j].color = color;
                }
            }
        }
        
        Debug.Log($"✅ Created drag preview for {characterPrefab.name} (UI components removed)");
    }
