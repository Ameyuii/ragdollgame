public class HideTeamDropdownPanel : MonoBehaviour
{
    void Start()
    {
        // Hide the dropdown panel initially
        GameObject dropdownPanel = GameObject.Find("UI Canvas/BottomCharacterPanel/TeamDropdownPanel");
        if (dropdownPanel != null)
        {
            dropdownPanel.SetActive(false);
            Debug.Log("✅ Hidden TeamDropdownPanel initially");
        }
        
        // Destroy this script after use
        Destroy(this);
    }
}
