2025-07-28 21:37:04.093 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/DirectFixTeamDropdown.cs, content: using UnityEngine;
using UnityEngine.UI;

public class DirectFixTeamDropdown : MonoBehaviour  
{
    public static void Execute()
    {
        Debug.Log("=== DIRECT FIX TEAM DROPDOWN ===");
        
        // Enable BottomCharacterPanel first
        GameObject[] allObjects = Resources.FindObjectsOfTypeAll<GameObject>();
        GameObject bottomPanel = null;
        
        foreach (GameObject obj in allObjects)
        {
            if (obj.name == "BottomCharacterPanel" && obj.transform.parent != null && obj.transform.parent.name == "UI Canvas")
            {
                bottomPanel = obj;
                break;
            }
        }
        
        if (bottomPanel != null)
        {
            bottomPanel.SetActive(true);
            Debug.Log("✅ Activated BottomCharacterPanel using Resources.FindObjectsOfTypeAll");
        }
        else
        {
            Debug.LogError("❌ Could not find BottomCharacterPanel");
            return;
        }
        
        // Wait a frame and then setup references
        var canvas = GameObject.Find("UI Canvas");
        if (canvas != null)
        {
            var teamController = canvas.GetComponent<TeamDropdownController>();
            if (teamController != null)
            {
                // Force find the UI elements after activation
                teamController.teamDropdownButton = GameObject.Find("UI Canvas/BottomCharacterPanel/TeamDropdownButton")?.GetComponent<Button>();
                teamController.teamDropdownPanel = GameObject.Find("UI Canvas/BottomCharacterPanel/TeamDropdownPanel");
                teamController.teamDropdownButtonText = teamController.teamDropdownButton?.GetComponentInChildren<Text>();
                
                // Find team option buttons
                teamController.team1Option = GameObject.Find("UI Canvas/BottomCharacterPanel/TeamDropdownPanel/Team1Option")?.GetComponent<Button>();
                teamController.team2Option = GameObject.Find("UI Canvas/BottomCharacterPanel/TeamDropdownPanel/Team2Option")?.GetComponent<Button>();
                teamController.team3Option = GameObject.Find("UI Canvas/BottomCharacterPanel/TeamDropdownPanel/Team3Option")?.GetComponent<Button>();
                teamController.team4Option = GameObject.Find("UI Canvas/BottomCharacterPanel/TeamDropdownPanel/Team4Option")?.GetComponent<Button>();
                
                Debug.Log($"Button references: {teamController.teamDropdownButton != null}, Panel: {teamController.teamDropdownPanel != null}");
                Debug.Log($"Team options: 1={teamController.team1Option != null}, 2={teamController.team2Option != null}, 3={teamController.team3Option != null}, 4={teamController.team4Option != null}");
                
                // Re-initialize
                teamController.enabled = false;
                teamController.enabled = true;
                
                Debug.Log("✅ TeamDropdownController setup complete");
            }
        }
        
        Debug.Log("=== DIRECT FIX COMPLETE ===");
    }
}
