2025-07-28 09:59:17.150 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/Utils/RecreateTeamButtonTexts.cs, content: using UnityEngine;
using UnityEngine.UI;

public class RecreateTeamButtonTexts
{
    public static void Execute()
    {
        Debug.Log("🔧 Recreating team button texts...");

        GameObject panel = GameObject.Find("TeamDropdownPanel");
        if (panel == null)
        {
            Debug.LogError("❌ TeamDropdownPanel not found!");
            return;
        }

        // Process each team button
        for (int i = 1; i <= 4; i++)
        {
            Transform buttonTransform = panel.transform.Find($"Team{i}Option");
            if (buttonTransform != null)
            {
                // Remove old text
                Text oldText = buttonTransform.GetComponentInChildren<Text>();
                if (oldText != null)
                {
                    Object.DestroyImmediate(oldText.gameObject);
                }

                // Create new text GameObject
                GameObject textObj = new GameObject("Text");
                textObj.transform.SetParent(buttonTransform, false);

                // Add Text component
                Text textComponent = textObj.AddComponent<Text>();
                textComponent.text = $"TEAM {i}";
                textComponent.fontSize = 16;
                textComponent.color = Color.white;
                textComponent.alignment = TextAnchor.MiddleCenter;
                textComponent.font = Resources.GetBuiltinResource<Font>("Arial.ttf");

                // Setup RectTransform to fill parent
                RectTransform textRect = textComponent.GetComponent<RectTransform>();
                textRect.anchorMin = Vector2.zero;
                textRect.anchorMax = Vector2.one;
                textRect.sizeDelta = Vector2.zero;
                textRect.anchoredPosition = Vector2.zero;

                // Update button's target graphic
                Button button = buttonTransform.GetComponent<Button>();
                if (button != null && button.targetGraphic == null)
                {
                    Image buttonImage = buttonTransform.GetComponent<Image>();
                    if (buttonImage != null)
                    {
                        button.targetGraphic = buttonImage;
                    }
                }

                Debug.Log($"✅ Recreated text for Team{i}Option");
            }
        }

        Debug.Log("🎯 Text recreation completed!");
    }
}
