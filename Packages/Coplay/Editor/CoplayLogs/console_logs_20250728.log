    public void OnEndDrag(UnityEngine.EventSystems.PointerEventData eventData)
    {
        if (dragObject)
        {
            Destroy(dragObject);
        }
        
        // Try to spawn character at drop location
        Camera mainCamera = Camera.main;
        if (mainCamera == null) mainCamera = FindObjectOfType<Camera>();
        
        if (mainCamera && characterPrefab)
        {
            // Convert screen position to world position
            Ray ray = mainCamera.ScreenPointToRay(eventData.position);
            RaycastHit hit;
            
            // Raycast to find ground
            if (Physics.Raycast(ray, out hit, 1000f))
            {
                Vector3 spawnPosition = hit.point;
                
                // Spawn character properly with full setup
                GameObject spawnedCharacter = Instantiate(characterPrefab, spawnPosition, Quaternion.identity);
                
                // Force refresh health bar setup
                HealthBarController healthController = spawnedCharacter.GetComponent<HealthBarController>();
                if (healthController != null)
                {
                    healthController.RefreshHealthBar();
                }
                
                Debug.Log($"Spawned character: {characterPrefab.name} at {spawnPosition} with HealthBar setup");
            }
            else
            {
                // Fallback - spawn at a default position
                Vector3 defaultPosition = new Vector3(0, 1, 0);
                GameObject spawnedCharacter = Instantiate(characterPrefab, defaultPosition, Quaternion.identity);
                
                // Force refresh health bar setup
                HealthBarController healthController = spawnedCharacter.GetComponent<HealthBarController>();
                if (healthController != null)
                {
                    healthController.RefreshHealthBar();
                }
                
                Debug.Log($"Spawned character: {characterPrefab.name} at default position with HealthBar setup");
            }
        }
    }
