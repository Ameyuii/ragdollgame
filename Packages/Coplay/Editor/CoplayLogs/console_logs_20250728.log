    private static void FixButtonText(string buttonName, string textContent)
    {
        GameObject button = GameObject.Find(buttonName);
        if (button != null)
        {
            Text textComponent = button.GetComponentInChildren<Text>();
            if (textComponent != null)
            {
                textComponent.text = textContent;
                textComponent.fontSize = 16;
                textComponent.alignment = TextAnchor.MiddleCenter;
                textComponent.color = Color.white;
                Debug.Log($"✅ {buttonName} text set to '{textContent}'");
            }
            else
            {
                Debug.LogError($"❌ Text component not found in {buttonName}");
            }
        }
        else
        {
            Debug.LogError($"❌ {buttonName} not found");
        }
    }
