    void AttackTarget()
    {
        if (target == null) return;
        
        isAttacking = true;
        isMoving = false;
        
        // Face the target
        Vector3 lookDirection = (target.position - transform.position).normalized;
        lookDirection.y = 0;
        if (lookDirection != Vector3.zero)
