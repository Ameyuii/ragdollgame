2025-07-28 21:43:00.450 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/QuickHideDropdown.cs, content: using UnityEngine;

public static class QuickHideDropdown
{
    [UnityEditor.MenuItem("Debug/Hide Team Dropdown Panel")]
    public static void HideDropdownPanel()
    {
        GameObject dropdownPanel = GameObject.Find("UI Canvas/BottomCharacterPanel/TeamDropdownPanel");
        if (dropdownPanel != null)
        {
            dropdownPanel.SetActive(false);
            Debug.Log("✅ Hidden TeamDropdownPanel");
        }
        else
        {
            Debug.LogError("❌ TeamDropdownPanel not found");
        }
    }
}
