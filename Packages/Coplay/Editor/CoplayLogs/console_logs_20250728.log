using UnityEngine.UI;

public class FixTeamDropdown : MonoBehaviour
{
    public static void Execute()
    {
        Debug.Log("=== FIXING TEAM DROPDOWN ===");
        
        // Find and activate BottomCharacterPanel
        GameObject bottomPanel = GameObject.Find("UI Canvas/BottomCharacterPanel");
        if (bottomPanel != null)
        {
            Debug.Log($"Found BottomCharacterPanel, Active: {bottomPanel.activeInHierarchy}");
            bottomPanel.SetActive(true);
            Debug.Log("✅ Activated BottomCharacterPanel");
        }
        else
        {
            Debug.LogError("❌ BottomCharacterPanel not found!");
            return;
        }
        
        // Get TeamDropdownController
        TeamDropdownController controller = FindAnyObjectByType<TeamDropdownController>();
        if (controller == null)
        {
            Debug.LogError("❌ TeamDropdownController not found!");
            return;
        }
        
        // Find and assign UI references
        GameObject teamDropdownButton = GameObject.Find("UI Canvas/BottomCharacterPanel/TeamDropdownButton");
        GameObject teamDropdownPanel = GameObject.Find("UI Canvas/BottomCharacterPanel/TeamDropdownPanel");
        
        if (teamDropdownButton != null)
        {
            controller.teamDropdownButton = teamDropdownButton.GetComponent<Button>();
            controller.teamDropdownButtonText = teamDropdownButton.GetComponentInChildren<Text>();
            Debug.Log("✅ Assigned teamDropdownButton");
        }
        
        if (teamDropdownPanel != null)
        {
            controller.teamDropdownPanel = teamDropdownPanel;
            
            // Find and assign team option buttons
            controller.team1Option = GameObject.Find("UI Canvas/BottomCharacterPanel/TeamDropdownPanel/Team1Option")?.GetComponent<Button>();
            controller.team2Option = GameObject.Find("UI Canvas/BottomCharacterPanel/TeamDropdownPanel/Team2Option")?.GetComponent<Button>();
            controller.team3Option = GameObject.Find("UI Canvas/BottomCharacterPanel/TeamDropdownPanel/Team3Option")?.GetComponent<Button>();
            controller.team4Option = GameObject.Find("UI Canvas/BottomCharacterPanel/TeamDropdownPanel/Team4Option")?.GetComponent<Button>();
            
            Debug.Log("✅ Assigned team option buttons");
            Debug.Log($"Team1Option: {controller.team1Option != null}");
            Debug.Log($"Team2Option: {controller.team2Option != null}");
            Debug.Log($"Team3Option: {controller.team3Option != null}");
            Debug.Log($"Team4Option: {controller.team4Option != null}");
        }
        
        // Re-initialize the controller to setup event listeners
        controller.enabled = false;
        controller.enabled = true;
        
        Debug.Log("=== TEAM DROPDOWN FIX COMPLETE ===");
    }
}
