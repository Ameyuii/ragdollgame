public class TestTeamDropdownFunctionality : MonoBehaviour
{
    public static void Execute()
    {
        Debug.Log("=== TESTING TEAM DROPDOWN FUNCTIONALITY ===");
        
        // Hide dropdown panel first
        GameObject dropdownPanel = GameObject.Find("UI Canvas/BottomCharacterPanel/TeamDropdownPanel");
        if (dropdownPanel != null)
        {
            dropdownPanel.SetActive(false);
            Debug.Log("✅ Hidden dropdown panel");
        }
        
        // Find dropdown button
        GameObject dropdownButton = GameObject.Find("UI Canvas/BottomCharacterPanel/TeamDropdownButton");
        if (dropdownButton != null)
        {
            Button button = dropdownButton.GetComponent<Button>();
            if (button != null)
            {
                Debug.Log("✅ Found team dropdown button");
                
                // Test clicking the button
                button.onClick.Invoke();
                Debug.Log("🔘 Simulated dropdown button click");
                
                // Check if panel becomes visible
                if (dropdownPanel != null && dropdownPanel.activeInHierarchy)
                {
                    Debug.Log("✅ Dropdown panel opened successfully!");
                    
                    // Test clicking team 2 option
                    GameObject team2Option = GameObject.Find("UI Canvas/BottomCharacterPanel/TeamDropdownPanel/Team2Option");
                    if (team2Option != null)
                    {
                        Button team2Button = team2Option.GetComponent<Button>();
                        if (team2Button != null)
                        {
                            Debug.Log("🔘 Simulating Team 2 selection...");
                            team2Button.onClick.Invoke();
                            
                            // Check BattleGameManager selectedTeam
                            BattleGameManager gameManager = FindAnyObjectByType<BattleGameManager>();
                            if (gameManager != null)
                            {
                                Debug.Log($"📋 Selected team in BattleGameManager: {gameManager.selectedTeam}");
                            }
                        }
                    }
                }
                else
                {
                    Debug.LogError("❌ Dropdown panel did not open");
                }
            }
            else
            {
                Debug.LogError("❌ Button component not found on dropdown button");
            }
        }
        else
        {
            Debug.LogError("❌ Team dropdown button not found");
        }
        
        Debug.Log("=== TEST COMPLETE ===");
    }
}
