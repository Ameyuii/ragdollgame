using UnityEngine.UI;
using UnityEngine.EventSystems;

/// <summary>
/// Component để handle drag and drop character từ UI ra map
/// </summary>
public class DraggableCharacterIcon : MonoBehaviour, IBeginDragHandler, IDragHandler, IEndDragHandler
{
    [Header("Settings")]
    public GameObject? characterPrefab;
    public Transform? originalParent;
    
    [Header("Drag Preview")]
    public bool showDragPreview = true;
    public float previewScale = 0.8f;
    
    private Canvas? parentCanvas;
    private GraphicRaycaster? graphicRaycaster;
    private CanvasGroup? canvasGroup;
    private RectTransform? rectTransform;
    private Vector3 originalPosition;
    private GameObject? dragPreview;
    private Camera? mainCamera;
    
    void Start()
    {
        rectTransform = GetComponent<RectTransform>();
        parentCanvas = GetComponentInParent<Canvas>();
        graphicRaycaster = GetComponentInParent<GraphicRaycaster>();
        
        // Add CanvasGroup for transparency control
        canvasGroup = GetComponent<CanvasGroup>();
        if (canvasGroup == null)
            canvasGroup = gameObject.AddComponent<CanvasGroup>();
            
        mainCamera = Camera.main;
        if (mainCamera == null)
            mainCamera = FindObjectOfType<Camera>();
            
        originalPosition = rectTransform.localPosition;
    }
    
    public void OnBeginDrag(PointerEventData eventData)
    {
        Debug.Log($"🎯 Started dragging: {characterPrefab?.name}");
        
        // Make original icon semi-transparent
        if (canvasGroup != null)
            canvasGroup.alpha = 0.6f;
            
        // Create drag preview if enabled
        if (showDragPreview && characterPrefab != null)
        {
            CreateDragPreview();
        }
    }
    
    public void OnDrag(PointerEventData eventData)
    {
        // Move the UI icon with cursor
        if (rectTransform != null && parentCanvas != null)
        {
            Vector2 localPoint;
            RectTransformUtility.ScreenPointToLocalPointInRectangle(
                parentCanvas.transform as RectTransform,
                eventData.position,
                eventData.pressEventCamera,
                out localPoint);
            rectTransform.localPosition = localPoint;
        }
        
        // Update preview position if it exists
        if (dragPreview != null && mainCamera != null)
        {
            UpdatePreviewPosition(eventData.position);
        }
    }
    
    public void OnEndDrag(PointerEventData eventData)
    {
        Debug.Log($"🎯 Ended dragging: {characterPrefab?.name}");
        
        // Restore original transparency
        if (canvasGroup != null)
            canvasGroup.alpha = 1.0f;
            
        // Reset position
        if (rectTransform != null)
            rectTransform.localPosition = originalPosition;
        
        // Check if dropped on valid area (outside UI)
        if (IsDroppedOnMap(eventData))
        {
            SpawnCharacterAtDropPosition(eventData.position);
        }
        
        // Clean up drag preview
        if (dragPreview != null)
        {
            DestroyImmediate(dragPreview);
            dragPreview = null;
        }
    }
    
    void CreateDragPreview()
    {
        if (characterPrefab == null) return;
        
        // Create a small preview of the character
        dragPreview = Instantiate(characterPrefab);
        dragPreview.name = $"DragPreview_{characterPrefab.name}";
        
        // Scale down the preview
        dragPreview.transform.localScale = Vector3.one * previewScale;
        
        // Disable colliders and unnecessary components
        Collider[] colliders = dragPreview.GetComponentsInChildren<Collider>();
        for (int i = 0; i < colliders.Length; i++)
        {
            colliders[i].enabled = false;
        }
        
        // Make it semi-transparent
        Renderer[] renderers = dragPreview.GetComponentsInChildren<Renderer>();
        for (int i = 0; i < renderers.Length; i++)
        {
            Material[] materials = renderers[i].materials;
            for (int j = 0; j < materials.Length; j++)
            {
                if (materials[j].HasProperty("_Color"))
                {
                    Color color = materials[j].color;
                    color.a = 0.7f;
                    materials[j].color = color;
                }
            }
        }
        
        Debug.Log($"✅ Created drag preview for {characterPrefab.name}");
    }
    
    void UpdatePreviewPosition(Vector2 screenPosition)
    {
        if (dragPreview == null || mainCamera == null) return;
        
        // Convert screen position to world position
        Ray ray = mainCamera.ScreenPointToRay(screenPosition);
        
        // Raycast to find ground
        RaycastHit hit;
        if (Physics.Raycast(ray, out hit, Mathf.Infinity))
        {
            if (hit.collider.name == "Ground" || hit.collider.CompareTag("Ground"))
            {
                dragPreview.transform.position = hit.point + Vector3.up * 0.5f;
                return;
            }
        }
        
        // If no ground hit, position at fixed distance from camera
        Vector3 worldPos = ray.origin + ray.direction * 10f;
        worldPos.y = 1f; // Keep above ground level
        dragPreview.transform.position = worldPos;
    }
    
    bool IsDroppedOnMap(PointerEventData eventData)
    {
        // Simple check: if not over UI, consider it dropped on map
        return !IsPointerOverUIElement(eventData);
    }
    
    bool IsPointerOverUIElement(PointerEventData eventData)
    {
        if (graphicRaycaster == null) return false;
        
        // Perform raycast to check if over UI
        var raycastResults = new System.Collections.Generic.List<RaycastResult>();
        graphicRaycaster.Raycast(eventData, raycastResults);
        
        // Filter out our own icon and its children
        foreach (var result in raycastResults)
        {
            if (result.gameObject != gameObject && !result.gameObject.transform.IsChildOf(transform))
            {
                return true; // Over other UI element
            }
        }
        
        return false; // Not over UI (dropped on map)
    }
    
    void SpawnCharacterAtDropPosition(Vector2 screenPosition)
    {
        if (characterPrefab == null || mainCamera == null) return;
        
        Debug.Log($"🚀 Spawning character at drop position: {characterPrefab.name}");
        
        // Convert screen position to world position
        Ray ray = mainCamera.ScreenPointToRay(screenPosition);
        
        Vector3 spawnPosition = Vector3.zero;
        bool foundValidPosition = false;
        
        // Try to raycast to ground
        RaycastHit hit;
        if (Physics.Raycast(ray, out hit, Mathf.Infinity))
        {
            if (hit.collider.name == "Ground" || hit.collider.CompareTag("Ground"))
            {
                spawnPosition = hit.point + Vector3.up * 0.1f;
                foundValidPosition = true;
            }
        }
        
        // If no ground hit, use a default position
        if (!foundValidPosition)
        {
            Vector3 worldPos = ray.origin + ray.direction * 10f;
            spawnPosition = new Vector3(worldPos.x, 1f, worldPos.z);
        }
        
        // Spawn the character
        GameObject spawnedCharacter = Instantiate(characterPrefab, spawnPosition, Quaternion.identity);
        
        // Add CharacterDragDrop component if not present
        if (spawnedCharacter.GetComponent<CharacterDragDrop>() == null)
        {
            spawnedCharacter.AddComponent<CharacterDragDrop>();
            Debug.Log($"✅ Added CharacterDragDrop to {spawnedCharacter.name}");
        }
        
        // Set team (get from TeamSelector or BattleGameManager)
        TeamSelector teamSelector = FindObjectOfType<TeamSelector>();
        if (teamSelector != null)
        {
            int selectedTeam = teamSelector.GetSelectedTeam();
            
            // Try to set team on character
            RagdollCharacter ragdollChar = spawnedCharacter.GetComponent<RagdollCharacter>();
            if (ragdollChar != null)
            {
                ragdollChar.teamNumber = selectedTeam;
                Debug.Log($"✅ Set team {selectedTeam} for {spawnedCharacter.name}");
            }
        }
        
        Debug.Log($"✅ Character {characterPrefab.name} spawned at {spawnPosition}");
    }
}
