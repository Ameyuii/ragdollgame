public class CheckTeamSelection : MonoBehaviour
{
    public static void Execute()
    {
        Debug.Log("=== CHECKING TEAM SELECTION ===");
        
        // Check BattleGameManager
        BattleGameManager gameManager = FindAnyObjectByType<BattleGameManager>();
        if (gameManager != null)
        {
            Debug.Log($"BattleGameManager.selectedTeam (field): {gameManager.selectedTeam}");
            Debug.Log($"BattleGameManager.GetSelectedTeam(): {gameManager.GetSelectedTeam()}");
        }
        else
        {
            Debug.LogError("BattleGameManager not found!");
        }
        
        // Check TeamDropdownController
        TeamDropdownController dropdownController = FindAnyObjectByType<TeamDropdownController>();
        if (dropdownController != null)
        {
            Debug.Log($"TeamDropdownController.GetSelectedTeam(): {dropdownController.GetSelectedTeam()}");
        }
        else
        {
            Debug.LogError("TeamDropdownController not found!");
        }
        
        // Check TeamSelector (fallback)
        TeamSelector teamSelector = FindAnyObjectByType<TeamSelector>();
        if (teamSelector != null)
        {
            Debug.Log($"TeamSelector found (fallback system)");
        }
        else
        {
            Debug.Log("TeamSelector not found (expected if using new dropdown system)");
        }
        
        Debug.Log("=== TEAM SELECTION CHECK COMPLETE ===");
    }
}
