    void UpdatePreviewPosition(Vector2 screenPosition)
    {
        if (dragPreview == null || mainCamera == null) return;
        
        // Convert screen position to world position
        Ray ray = mainCamera.ScreenPointToRay(screenPosition);
        
        // Try to raycast to ground first
        RaycastHit hit;
        LayerMask groundLayerMask = 1 << 8; // Layer 8 for Ground
        
        if (Physics.Raycast(ray, out hit, Mathf.Infinity, groundLayerMask))
        {
            // Hit ground - place preview on ground
            dragPreview.transform.position = hit.point + Vector3.up * 0.5f;
            dragPreview.SetActive(true); // Show preview when over ground
            Debug.Log($"Preview on ground at: {hit.point}");
        }
        else
        {
            // Not over ground - hide preview or position at camera distance
            Vector3 worldPos = ray.origin + ray.direction * 10f;
            worldPos.y = 1f; // Keep above ground level
            dragPreview.transform.position = worldPos;
            
            // Could optionally hide preview when not over valid drop zone
            // dragPreview.SetActive(false);
        }
    }
    
    bool IsDroppedOnMap(PointerEventData eventData)
    {
        // Simple check: if not over UI, consider it dropped on map
        return !IsPointerOverUIElement(eventData);
    }
    
    bool IsPointerOverUIElement(PointerEventData eventData)
    {
        if (graphicRaycaster == null) return false;
        
        // Perform raycast to check if over UI
        var raycastResults = new System.Collections.Generic.List<RaycastResult>();
        graphicRaycaster.Raycast(eventData, raycastResults);
        
        // Filter out our own icon and its children
        foreach (var result in raycastResults)
        {
            if (result.gameObject != gameObject && !result.gameObject.transform.IsChildOf(transform))
            {
                return true; // Over other UI element
            }
        }
        
        return false; // Not over UI (dropped on map)
    }
    
