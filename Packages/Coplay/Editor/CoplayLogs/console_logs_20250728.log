2025-07-28 09:40:47.484 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/Utils/DebugTeamButtonTexts.cs, content: using UnityEngine;
using UnityEngine.UI;

public class DebugTeamButtonTexts
{
    public static void Execute()
    {
        Debug.Log("🔍 Debugging team button texts...");

        // Find all Text components in scene
        Text[] allTexts = Object.FindObjectsOfType<Text>(true); // true to include inactive
        
        foreach (Text text in allTexts)
        {
            string objName = text.transform.parent?.name;
            
            if (objName == "Team1Option" || objName == "Team2Option" || objName == "Team3Option" || objName == "Team4Option")
            {
                Debug.Log($"🔧 Found {objName}:");
                Debug.Log($"   - Text: '{text.text}'");
                Debug.Log($"   - Font Size: {text.fontSize}");
                Debug.Log($"   - Color: {text.color}");
                Debug.Log($"   - Alignment: {text.alignment}");
                Debug.Log($"   - GameObject Active: {text.gameObject.activeInHierarchy}");
                Debug.Log($"   - Enabled: {text.enabled}");
                
                // Force fix the text
                text.text = GetTeamText(objName);
                text.fontSize = 18; // Bigger font
                text.alignment = TextAnchor.MiddleCenter;
                text.color = Color.white;
                text.enabled = true;
                text.gameObject.SetActive(true);
                
                Debug.Log($"✅ Fixed {objName} text to '{text.text}'");
            }
        }

        Debug.Log("🎯 Debug completed!");
    }
    
    private static string GetTeamText(string buttonName)
    {
        switch (buttonName)
        {
            case "Team1Option": return "TEAM 1";
            case "Team2Option": return "TEAM 2";
            case "Team3Option": return "TEAM 3";
            case "Team4Option": return "TEAM 4";
            default: return "TEAM";
        }
    }
}
