using UnityEngine.UI;

public class SetupTeamDropdownEvents
{
    public static void Execute()
    {
        Debug.Log("🔧 Setting up TeamDropdown events...");

        // Find UI Canvas và TeamDropdownController
        GameObject uiCanvas = GameObject.Find("UI Canvas");
        if (uiCanvas == null)
        {
            Debug.LogError("❌ UI Canvas not found!");
            return;
        }

        TeamDropdownController controller = uiCanvas.GetComponent<TeamDropdownController>();
        if (controller == null)
        {
            Debug.LogError("❌ TeamDropdownController not found!");
            return;
        }

        // Assign references
        AssignDropdownReferences(controller);
        
        // Setup button events
        SetupButtonEvents(controller);

        Debug.Log("✅ TeamDropdown events setup completed!");
    }

    private static void AssignDropdownReferences(TeamDropdownController controller)
    {
        // Assign main dropdown button
        GameObject teamDropdownButton = GameObject.Find("TeamDropdownButton");
        if (teamDropdownButton != null)
        {
            controller.teamDropdownButton = teamDropdownButton.GetComponent<Button>();
            controller.teamDropdownButtonText = teamDropdownButton.GetComponentInChildren<Text>();
            Debug.Log("✅ TeamDropdownButton reference assigned");
        }

        // Assign dropdown panel
        GameObject dropdownPanel = GameObject.Find("TeamDropdownPanel");
        if (dropdownPanel != null)
        {
            controller.teamDropdownPanel = dropdownPanel;
            Debug.Log("✅ TeamDropdownPanel reference assigned");
        }

        // Assign team option buttons
        AssignTeamButton(controller, "Team1Option", 1);
        AssignTeamButton(controller, "Team2Option", 2);
        AssignTeamButton(controller, "Team3Option", 3);
        AssignTeamButton(controller, "Team4Option", 4);
    }

    private static void AssignTeamButton(TeamDropdownController controller, string buttonName, int teamNumber)
    {
        GameObject panel = GameObject.Find("TeamDropdownPanel");
        if (panel != null)
        {
            Transform buttonTransform = panel.transform.Find(buttonName);
            if (buttonTransform != null)
            {
                Button button = buttonTransform.GetComponent<Button>();
                if (button != null)
                {
                    switch (teamNumber)
                    {
                        case 1: controller.team1Option = button; break;
                        case 2: controller.team2Option = button; break;
                        case 3: controller.team3Option = button; break;
                        case 4: controller.team4Option = button; break;
                    }
                    Debug.Log($"✅ {buttonName} reference assigned");
                }
            }
        }
    }

    private static void SetupButtonEvents(TeamDropdownController controller)
    {
        // Setup main dropdown button click
        if (controller.teamDropdownButton != null)
        {
            controller.teamDropdownButton.onClick.RemoveAllListeners();
            controller.teamDropdownButton.onClick.AddListener(() => {
                controller.ToggleDropdown();
                Debug.Log("🎯 Dropdown toggled");
            });
        }

        // Setup team option buttons click events
        SetupTeamButtonEvent(controller.team1Option, controller, 1);
        SetupTeamButtonEvent(controller.team2Option, controller, 2);
        SetupTeamButtonEvent(controller.team3Option, controller, 3);
        SetupTeamButtonEvent(controller.team4Option, controller, 4);
    }

    private static void SetupTeamButtonEvent(Button button, TeamDropdownController controller, int teamId)
    {
        if (button != null)
        {
            button.onClick.RemoveAllListeners();
            button.onClick.AddListener(() => {
                controller.SelectTeam(teamId);
                Debug.Log($"🎯 Team {teamId} selected!");
            });
        }
    }
}
