2025-07-28 21:49:21.039 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/TestTeamAssignment.cs, content: using UnityEngine;

public class TestTeamAssignment : MonoBehaviour
{
    public static void Execute()
    {
        Debug.Log("=== TESTING TEAM ASSIGNMENT WORKFLOW ===");
        
        // 1. Check current team selection
        BattleGameManager gameManager = FindAnyObjectByType<BattleGameManager>();
        TeamDropdownController dropdownController = FindAnyObjectByType<TeamDropdownController>();
        
        if (gameManager == null)
        {
            Debug.LogError("❌ BattleGameManager not found!");
            return;
        }
        
        if (dropdownController == null)
        {
            Debug.LogError("❌ TeamDropdownController not found!");
            return;
        }
        
        Debug.Log($"Before team selection:");
        Debug.Log($"  BattleGameManager.selectedTeam: {gameManager.selectedTeam}");
        Debug.Log($"  BattleGameManager.GetSelectedTeam(): {gameManager.GetSelectedTeam()}");
        Debug.Log($"  TeamDropdownController.GetSelectedTeam(): {dropdownController.GetSelectedTeam()}");
        
        // 2. Simulate selecting Team 2
        Debug.Log("🔄 Simulating Team 2 selection...");
        dropdownController.SelectTeam(2);
        
        Debug.Log($"After Team 2 selection:");
        Debug.Log($"  BattleGameManager.selectedTeam: {gameManager.selectedTeam}");
        Debug.Log($"  BattleGameManager.GetSelectedTeam(): {gameManager.GetSelectedTeam()}");
        Debug.Log($"  TeamDropdownController.GetSelectedTeam(): {dropdownController.GetSelectedTeam()}");
        
        // 3. Test spawning a character
        Debug.Log("🚀 Testing character spawn...");
        Vector3 testPosition = new Vector3(0, 0, 0);
        gameManager.SpawnCharacterAtPosition(testPosition);
        
        // 4. Check spawned character
        RagdollCharacter[] allCharacters = FindObjectsByType<RagdollCharacter>(FindObjectsSortMode.None);
        if (allCharacters.Length > 0)
        {
            RagdollCharacter lastChar = allCharacters[allCharacters.Length - 1];
            Debug.Log($"✅ Spawned character: {lastChar.name}");
            Debug.Log($"  Team ID: {lastChar.teamId}");
            
            // Check material
            Renderer renderer = lastChar.GetComponentInChildren<Renderer>();
            if (renderer != null && renderer.material != null)
            {
                Debug.Log($"  Material: {renderer.material.name}");
                Debug.Log($"  Material color: {renderer.material.color}");
            }
        }
        else
        {
            Debug.LogWarning("⚠️ No characters found after spawn attempt");
        }
        
        Debug.Log("=== TEAM ASSIGNMENT TEST COMPLETE ===");
    }
}
