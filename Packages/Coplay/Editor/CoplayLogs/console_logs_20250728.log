using UnityEngine.UI;

public class TeamDropdownFixerScript
{
    public static void Execute()
    {
        Debug.Log("🔧 Starting Team Dropdown References Fix...");
        
        // Find UI Canvas with TeamDropdownController
        GameObject uiCanvas = GameObject.Find("UI Canvas");
        if (uiCanvas == null)
        {
            Debug.LogError("❌ UI Canvas not found!");
            return;
        }
        
        TeamDropdownController controller = uiCanvas.GetComponent<TeamDropdownController>();
        if (controller == null)
        {
            Debug.LogError("❌ TeamDropdownController component not found on UI Canvas!");
            return;
        }
        
        // Debug current state first
        Debug.Log("🔍 Current References State:");
        Debug.Log($"TeamDropdownButton: {(controller.teamDropdownButton != null ? "✅" : "❌ NULL")}");
        Debug.Log($"TeamDropdownPanel: {(controller.teamDropdownPanel != null ? "✅" : "❌ NULL")}");
        Debug.Log($"Team1Option: {(controller.team1Option != null ? "✅" : "❌ NULL")}");
        Debug.Log($"Team2Option: {(controller.team2Option != null ? "✅" : "❌ NULL")}");
        Debug.Log($"ButtonText: {(controller.teamDropdownButtonText != null ? "✅" : "❌ NULL")}");
        
        // Fix references step by step
        bool allFixed = true;
        
        // 1. Find and assign TeamDropdownButton
        GameObject teamDropdownButton = GameObject.Find("TeamDropdownButton");
        if (teamDropdownButton != null)
        {
            Button buttonComponent = teamDropdownButton.GetComponent<Button>();
            if (buttonComponent != null)
            {
                controller.teamDropdownButton = buttonComponent;
                Debug.Log("✅ TeamDropdownButton reference assigned");
                
                // Also assign the target graphic for button
                Image buttonImage = teamDropdownButton.GetComponent<Image>();
                if (buttonImage != null)
                {
                    buttonComponent.targetGraphic = buttonImage;
                    Debug.Log("✅ Button target graphic assigned");
                }
            }
        }
        else
        {
            Debug.LogError("❌ TeamDropdownButton GameObject not found!");
            allFixed = false;
        }
        
        // 2. Find and assign DropdownPanel
        GameObject dropdownPanel = GameObject.Find("DropdownPanel");
        if (dropdownPanel != null)
        {
            controller.teamDropdownPanel = dropdownPanel;
            Debug.Log("✅ DropdownPanel reference assigned");
            
            // Ensure it's initially hidden
            dropdownPanel.SetActive(false);
            Debug.Log("✅ DropdownPanel set to inactive");
        }
        else
        {
            Debug.LogError("❌ DropdownPanel GameObject not found!");
            allFixed = false;
        }
        
        // 3. Find and assign Team Option Buttons
        GameObject teamButton1 = GameObject.Find("TeamButton_1");
        if (teamButton1 != null)
        {
            controller.team1Option = teamButton1.GetComponent<Button>();
            Debug.Log("✅ TeamButton_1 reference assigned");
        }
        else
        {
            Debug.LogError("❌ TeamButton_1 GameObject not found!");
            allFixed = false;
        }
        
        GameObject teamButton2 = GameObject.Find("TeamButton_2");
        if (teamButton2 != null)
        {
            controller.team2Option = teamButton2.GetComponent<Button>();
            Debug.Log("✅ TeamButton_2 reference assigned");
        }
        else
        {
            Debug.LogError("❌ TeamButton_2 GameObject not found!");
            allFixed = false;
        }
        
        // 4. Find and assign Button Text (child of TeamDropdownButton)
        if (teamDropdownButton != null)
        {
            Text buttonText = teamDropdownButton.GetComponentInChildren<Text>();
            if (buttonText != null)
            {
                controller.teamDropdownButtonText = buttonText;
                Debug.Log("✅ TeamDropdownButtonText reference assigned");
            }
            else
            {
                Debug.LogWarning("⚠️ Text component not found in TeamDropdownButton children");
                
                // Create text component if missing
                GameObject textChild = new GameObject("Text");
                textChild.transform.SetParent(teamDropdownButton.transform);
                
                RectTransform textRect = textChild.AddComponent<RectTransform>();
                textRect.anchorMin = Vector2.zero;
                textRect.anchorMax = Vector2.one;
                textRect.sizeDelta = Vector2.zero;
                textRect.anchoredPosition = Vector2.zero;
                
                Text newText = textChild.AddComponent<Text>();
                newText.text = "TEAM 1";
                newText.font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
                newText.fontSize = 14;
                newText.color = Color.white;
                newText.alignment = TextAnchor.MiddleCenter;
                
                controller.teamDropdownButtonText = newText;
                Debug.Log("✅ Created new Text component for TeamDropdownButton");
            }
        }
        
        if (allFixed)
        {
            Debug.Log("🎉 All Team Dropdown references fixed successfully!");
            
            // Manually setup the button listeners since we can't call Start()
            SetupButtonListeners(controller);
            
            Debug.Log("🔄 Button listeners setup completed");
        }
        else
        {
            Debug.LogError("❌ Some references could not be fixed. Check the missing GameObjects.");
        }
    }
    
    private static void SetupButtonListeners(TeamDropdownController controller)
    {
        // Setup main dropdown button
        if (controller.teamDropdownButton != null)
        {
            controller.teamDropdownButton.onClick.RemoveAllListeners();
            controller.teamDropdownButton.onClick.AddListener(controller.ToggleDropdown);
            Debug.Log("✅ Main dropdown button onClick listener added");
        }
        
        // Setup team option buttons
        if (controller.team1Option != null)
        {
            controller.team1Option.onClick.RemoveAllListeners();
            controller.team1Option.onClick.AddListener(() => controller.SelectTeam(1));
            Debug.Log("✅ Team 1 option onClick listener added");
        }
        
        if (controller.team2Option != null)
        {
            controller.team2Option.onClick.RemoveAllListeners();
            controller.team2Option.onClick.AddListener(() => controller.SelectTeam(2));
            Debug.Log("✅ Team 2 option onClick listener added");
        }
        
        // Update initial button text and color
        if (controller.teamDropdownButtonText != null)
        {
            controller.teamDropdownButtonText.text = "TEAM 1";
            Debug.Log("✅ Button text updated to TEAM 1");
        }
        
        // Update button color for Team 1 
        if (controller.teamDropdownButton != null)
        {
            Image buttonImage = controller.teamDropdownButton.GetComponent<Image>();
            if (buttonImage != null)
            {
                buttonImage.color = new Color(0.2f, 0.4f, 0.8f, 1f); // Blue for Team 1
                Debug.Log("✅ Button color updated to Team 1 blue");
            }
        }
    }
    
    public static void TestDropdownClick()
    {
        Debug.Log("🧪 Testing Team Dropdown Click...");
        
        GameObject uiCanvas = GameObject.Find("UI Canvas");
        if (uiCanvas != null)
        {
            TeamDropdownController controller = uiCanvas.GetComponent<TeamDropdownController>();
            if (controller != null)
            {
                controller.ToggleDropdown();
                Debug.Log("✅ ToggleDropdown() method called successfully");
            }
            else
            {
                Debug.LogError("❌ TeamDropdownController not found!");
            }
        }
    }
}
