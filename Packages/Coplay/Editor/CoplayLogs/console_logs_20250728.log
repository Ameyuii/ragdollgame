public class EnableBottomPanel : MonoBehaviour
{
    void Start()
    {
        // This script will run once and enable the BottomCharacterPanel
        GameObject bottomPanel = GameObject.Find("UI Canvas/BottomCharacterPanel");
        if (bottomPanel != null)
        {
            bottomPanel.SetActive(true);
            Debug.Log("✅ Enabled BottomCharacterPanel from EnableBottomPanel script");
            
            // Now let's also setup the TeamDropdownController references
            SetupTeamDropdownReferences();
        }
        
        // Destroy this script after use
        Destroy(this);
    }
    
    void SetupTeamDropdownReferences()
    {
        TeamDropdownController controller = FindAnyObjectByType<TeamDropdownController>();
        if (controller == null) return;
        
        // Find and assign UI references
        GameObject teamDropdownButton = GameObject.Find("UI Canvas/BottomCharacterPanel/TeamDropdownButton");
        GameObject teamDropdownPanel = GameObject.Find("UI Canvas/BottomCharacterPanel/TeamDropdownPanel");
        
        if (teamDropdownButton != null)
        {
            controller.teamDropdownButton = teamDropdownButton.GetComponent<UnityEngine.UI.Button>();
            controller.teamDropdownButtonText = teamDropdownButton.GetComponentInChildren<UnityEngine.UI.Text>();
        }
        
        if (teamDropdownPanel != null)
        {
            controller.teamDropdownPanel = teamDropdownPanel;
            
            // Find and assign team option buttons
            controller.team1Option = GameObject.Find("UI Canvas/BottomCharacterPanel/TeamDropdownPanel/Team1Option")?.GetComponent<UnityEngine.UI.Button>();
            controller.team2Option = GameObject.Find("UI Canvas/BottomCharacterPanel/TeamDropdownPanel/Team2Option")?.GetComponent<UnityEngine.UI.Button>();
            controller.team3Option = GameObject.Find("UI Canvas/BottomCharacterPanel/TeamDropdownPanel/Team3Option")?.GetComponent<UnityEngine.UI.Button>();
            controller.team4Option = GameObject.Find("UI Canvas/BottomCharacterPanel/TeamDropdownPanel/Team4Option")?.GetComponent<UnityEngine.UI.Button>();
        }
        
        // Re-initialize the controller
        controller.enabled = false;
        controller.enabled = true;
        
        Debug.Log("✅ TeamDropdownController references setup complete");
    }
}
