2025-07-28 22:01:25.129 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/AIMovementController.cs, content: using UnityEngine;
using UnityEngine.AI;

public class AIMovementController : MonoBehaviour
{
    private NavMeshAgent agent;
    private Transform target;
    private bool isMoving = false;
    
    [Header("AI Settings")]
    public float detectionRange = 10f;
    public float stopDistance = 2f;
    public LayerMask enemyLayer = -1;
    
    void Start()
    {
        agent = GetComponent<NavMeshAgent>();
        if (agent == null)
        {
            Debug.LogError($"NavMeshAgent không tìm thấy trên {gameObject.name}!");
            return;
        }
        
        // Thiết lập NavMeshAgent
        agent.stoppingDistance = stopDistance;
        agent.updateRotation = true;
        agent.updateUpAxis = false;
        
        Debug.Log($"AIMovementController khởi tạo cho {gameObject.name}");
    }
    
    void Update()
    {
        if (agent == null) return;
        
        // Tìm target gần nhất
        FindNearestTarget();
        
        // Di chuyển đến target nếu có
        if (target != null && !isMoving)
        {
            MoveToTarget();
        }
        
        // Kiểm tra nếu đã đến target
        if (isMoving && (!agent.hasPath || agent.remainingDistance < 0.5f))
        {
            isMoving = false;
            Debug.Log($"{gameObject.name} đã đến target!");
        }
    }
    
    void FindNearestTarget()
    {
        // Tìm tất cả colliders trong phạm vi detection
        Collider[] potentialTargets = Physics.OverlapSphere(transform.position, detectionRange, enemyLayer);
        
        float nearestDistance = Mathf.Infinity;
        Transform nearestTarget = null;
        
        foreach (Collider col in potentialTargets)
        {
            // Bỏ qua chính mình
            if (col.transform == transform) continue;
            
            // Kiểm tra nếu có NavMeshAgent (là AI character)
            if (col.GetComponent<NavMeshAgent>() != null)
            {
                float distance = Vector3.Distance(transform.position, col.transform.position);
                if (distance < nearestDistance)
                {
                    nearestDistance = distance;
                    nearestTarget = col.transform;
                }
            }
        }
        
        // Chỉ cập nhật target nếu tìm thấy target mới hoặc target hiện tại đã biến mất
        if (nearestTarget != null && nearestTarget != target)
        {
            target = nearestTarget;
            Debug.Log($"{gameObject.name} tìm thấy target: {target.name}");
        }
    }
    
    void MoveToTarget()
    {
        if (target == null || agent == null) return;
        
        // Kiểm tra NavMesh path trước khi di chuyển
        NavMeshPath path = new NavMeshPath();
        if (agent.CalculatePath(target.position, path))
        {
            if (path.status == NavMeshPathStatus.PathComplete)
            {
                agent.SetDestination(target.position);
                isMoving = true;
                Debug.Log($"{gameObject.name} bắt đầu di chuyển đến {target.name}");
            }
            else
            {
                Debug.LogWarning($"{gameObject.name}: Không thể tạo path hoàn chỉnh đến {target.name}");
            }
        }
        else
        {
            Debug.LogError($"{gameObject.name}: Không thể tính toán path đến {target.name}");
        }
    }
    
    // Gizmos để debug
    void OnDrawGizmosSelected()
    {
        // Vòng tròn detection range
        Gizmos.color = Color.yellow;
        Gizmos.DrawWiresphere(transform.position, detectionRange);
        
        // Đường thẳng đến target
        if (target != null)
        {
            Gizmos.color = Color.red;
            Gizmos.DrawLine(transform.position, target.position);
        }
        
        // NavMesh path
        if (Application.isPlaying && agent != null && agent.hasPath)
        {
            Gizmos.color = Color.green;
            Vector3[] pathCorners = agent.path.corners;
            for (int i = 0; i < pathCorners.Length - 1; i++)
            {
                Gizmos.DrawLine(pathCorners[i], pathCorners[i + 1]);
            }
        }
    }
    
    public static void Execute()
    {
        // Tìm tất cả BattleCharacter và thêm AIMovementController
        GameObject[] battleCharacters = GameObject.FindGameObjectsWithTag("Untagged");
        
        foreach (GameObject obj in battleCharacters)
        {
            if (obj.name.Contains("BattleCharacter") && obj.GetComponent<NavMeshAgent>() != null)
            {
                if (obj.GetComponent<AIMovementController>() == null)
                {
                    obj.AddComponent<AIMovementController>();
                    Debug.Log($"Đã thêm AIMovementController vào {obj.name}");
                }
            }
        }
        
        Debug.Log("Hoàn tất thêm AIMovementController cho tất cả BattleCharacter!");
    }
}
