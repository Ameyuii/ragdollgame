2025-07-28 21:59:45.177 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/NavMeshBaker.cs, content: using UnityEngine;
using UnityEngine.AI;

public class NavMeshBaker : MonoBehaviour
{
    public static void Execute()
    {
        // Tìm Ground object
        GameObject ground = GameObject.Find("Ground");
        if (ground == null)
        {
            Debug.LogError("Không tìm thấy Ground object!");
            return;
        }

        // Lấy NavMeshSurface component
        NavMeshSurface navMeshSurface = ground.GetComponent<NavMeshSurface>();
        if (navMeshSurface == null)
        {
            Debug.LogError("Ground object không có NavMeshSurface component!");
            return;
        }

        // Bake NavMesh
        navMeshSurface.BuildNavMesh();
        Debug.Log("NavMesh đã được bake thành công cho Ground object!");
    }
}
