2025-07-28 21:38:17.907 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/ManualTeamDropdownFix.cs, content: using UnityEngine;
using UnityEngine.UI;

public class ManualTeamDropdownFix : MonoBehaviour
{
    void Awake()
    {
        // This will run very early
        FixTeamDropdown();
    }
    
    void FixTeamDropdown()
    {
        Debug.Log("🔧 Manual Team Dropdown Fix starting...");
        
        // Find the inactive panel using different method
        Transform uiCanvas = transform.root.Find("UI Canvas");
        if (uiCanvas == null)
        {
            Debug.LogError("UI Canvas not found!");
            return;
        }
        
        Transform bottomPanel = uiCanvas.Find("BottomCharacterPanel");
        if (bottomPanel == null)
        {
            Debug.LogError("BottomCharacterPanel not found!");
            return;
        }
        
        // Activate the panel
        bottomPanel.gameObject.SetActive(true);
        Debug.Log("✅ BottomCharacterPanel activated!");
        
        // Wait for next frame to ensure UI is ready
        StartCoroutine(SetupTeamDropdownDelayed());
    }
    
    System.Collections.IEnumerator SetupTeamDropdownDelayed()
    {
        yield return null; // Wait one frame
        
        TeamDropdownController controller = FindAnyObjectByType<TeamDropdownController>();
        if (controller == null)
        {
            Debug.LogError("TeamDropdownController not found!");
            yield break;
        }
        
        // Now find and assign all references
        controller.teamDropdownButton = GameObject.Find("UI Canvas/BottomCharacterPanel/TeamDropdownButton")?.GetComponent<Button>();
        controller.teamDropdownPanel = GameObject.Find("UI Canvas/BottomCharacterPanel/TeamDropdownPanel");
        
        if (controller.teamDropdownButton != null)
        {
            controller.teamDropdownButtonText = controller.teamDropdownButton.GetComponentInChildren<Text>();
            Debug.Log("✅ Team dropdown button found and assigned");
        }
        
        if (controller.teamDropdownPanel != null)
        {
            // Find team option buttons
            controller.team1Option = controller.teamDropdownPanel.transform.Find("Team1Option")?.GetComponent<Button>();
            controller.team2Option = controller.teamDropdownPanel.transform.Find("Team2Option")?.GetComponent<Button>();
            controller.team3Option = controller.teamDropdownPanel.transform.Find("Team3Option")?.GetComponent<Button>();
            controller.team4Option = controller.teamDropdownPanel.transform.Find("Team4Option")?.GetComponent<Button>();
            
            Debug.Log($"✅ Team options found: 1={controller.team1Option != null}, 2={controller.team2Option != null}, 3={controller.team3Option != null}, 4={controller.team4Option != null}");
        }
        
        // Restart the controller to setup event listeners
        controller.enabled = false;
        yield return null;
        controller.enabled = true;
        
        Debug.Log("✅ TeamDropdownController setup complete with event listeners!");
        
        // Remove this component after successful setup
        Destroy(this);
    }
}
