                // Spawn character via game manager
                BattleGameManager gameManager = FindObjectOfType<BattleGameManager>();
                if (gameManager)
                {
                    // Simple character spawning
                    GameObject spawnedCharacter = Instantiate(characterPrefab, worldPosition, Quaternion.identity);
                    Debug.Log($"Spawned character: {characterPrefab.name} at {worldPosition}");
                }
            }
        }
    }
