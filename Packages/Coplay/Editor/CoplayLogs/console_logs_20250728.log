2025-07-28 21:43:18.995 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/ForceHideDropdown.cs, content: using UnityEngine;

public class ForceHideDropdown : MonoBehaviour
{
    void Awake()
    {
        // Find all GameObjects including inactive ones
        GameObject[] allObjects = Resources.FindObjectsOfTypeAll<GameObject>();
        
        foreach (GameObject obj in allObjects)
        {
            if (obj.name == "TeamDropdownPanel" && obj.transform.parent != null)
            {
                if (obj.transform.parent.name == "BottomCharacterPanel")
                {
                    obj.SetActive(false);
                    Debug.Log("✅ Force hidden TeamDropdownPanel");
                    break;
                }
            }
        }
        
        // Self destruct
        Destroy(this);
    }
}
