using UnityEngine.UI;

public class RuntimeTeamDropdownFix
{
    public static void Execute()
    {
        // Find UI Canvas
        GameObject uiCanvas = GameObject.Find("UI Canvas");
        if (uiCanvas == null)
        {
            Debug.LogError("❌ UI Canvas not found!");
            return;
        }

        // Get TeamDropdownController component
        TeamDropdownController controller = uiCanvas.GetComponent<TeamDropdownController>();
        if (controller == null)
        {
            Debug.LogError("❌ TeamDropdownController component not found!");
            return;
        }

        Debug.Log("🔧 Checking TeamDropdownController references...");

        // Check and assign main dropdown button
        if (controller.teamDropdownButton == null)
        {
            GameObject teamDropdownButton = GameObject.Find("TeamDropdownButton");
            if (teamDropdownButton != null)
            {
                controller.teamDropdownButton = teamDropdownButton.GetComponent<Button>();
                Debug.Log("✅ TeamDropdownButton assigned in runtime");
            }
        }

        // Check and assign dropdown panel
        if (controller.teamDropdownPanel == null)
        {
            GameObject dropdownPanel = GameObject.Find("TeamDropdownPanel");
            if (dropdownPanel != null)
            {
                controller.teamDropdownPanel = dropdownPanel;
                Debug.Log("✅ TeamDropdownPanel assigned in runtime");
            }
        }

        // Check and assign team option buttons
        if (controller.team1Option == null)
        {
            GameObject team1Option = GameObject.Find("Team1Option");
            if (team1Option != null)
            {
                controller.team1Option = team1Option.GetComponent<Button>();
                Debug.Log("✅ Team1Option assigned in runtime");
            }
        }

        if (controller.team2Option == null)
        {
            GameObject team2Option = GameObject.Find("Team2Option");
            if (team2Option != null)
            {
                controller.team2Option = team2Option.GetComponent<Button>();
                Debug.Log("✅ Team2Option assigned in runtime");
            }
        }

        if (controller.team3Option == null)
        {
            GameObject team3Option = GameObject.Find("Team3Option");
            if (team3Option != null)
            {
                controller.team3Option = team3Option.GetComponent<Button>();
                Debug.Log("✅ Team3Option assigned in runtime");
            }
        }

        if (controller.team4Option == null)
        {
            GameObject team4Option = GameObject.Find("Team4Option");
            if (team4Option != null)
            {
                controller.team4Option = team4Option.GetComponent<Button>();
                Debug.Log("✅ Team4Option assigned in runtime");
            }
        }

        // Check and assign button text
        if (controller.teamDropdownButtonText == null)
        {
            GameObject teamDropdownButton = GameObject.Find("TeamDropdownButton");
            if (teamDropdownButton != null)
            {
                controller.teamDropdownButtonText = teamDropdownButton.GetComponentInChildren<Text>();
                Debug.Log("✅ TeamDropdownButtonText assigned in runtime");
            }
        }

        // Force re-setup the button listeners
        SetupButtonListeners(controller);

        Debug.Log("🎯 Runtime fix completed!");
    }

    private static void SetupButtonListeners(TeamDropdownController controller)
    {
        // Setup main dropdown button
        if (controller.teamDropdownButton != null)
        {
            controller.teamDropdownButton.onClick.RemoveAllListeners();
            controller.teamDropdownButton.onClick.AddListener(controller.ToggleDropdown);
            Debug.Log("✅ Main button listener setup");
        }

        // Setup team option buttons
        if (controller.team1Option != null)
        {
            controller.team1Option.onClick.RemoveAllListeners();
            controller.team1Option.onClick.AddListener(() => controller.SelectTeam(1));
            Debug.Log("✅ Team1 button listener setup");
        }

        if (controller.team2Option != null)
        {
            controller.team2Option.onClick.RemoveAllListeners();
            controller.team2Option.onClick.AddListener(() => controller.SelectTeam(2));
            Debug.Log("✅ Team2 button listener setup");
        }

        if (controller.team3Option != null)
        {
            controller.team3Option.onClick.RemoveAllListeners();
            controller.team3Option.onClick.AddListener(() => controller.SelectTeam(3));
            Debug.Log("✅ Team3 button listener setup");
        }

        if (controller.team4Option != null)
        {
            controller.team4Option.onClick.RemoveAllListeners();
            controller.team4Option.onClick.AddListener(() => controller.SelectTeam(4));
            Debug.Log("✅ Team4 button listener setup");
        }
    }
}
