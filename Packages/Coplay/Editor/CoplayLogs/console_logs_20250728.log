using UnityEngine.UI;
using System.Collections.Generic;

/// <summary>
/// Script đơn giản để handle character selection và spawning
/// Thay thế CategoryButtonHandler phức tạp
/// </summary>
public class SimpleCharacterSelection : MonoBehaviour
{
    [Header("UI References")]
    public GameObject? bottomPanel;
    public Text? panelTitle;
    public Transform? modelContentArea;
    public Button? closeButton;
    
    [Header("Character Data")]
    public GameObject[]? robotPrefabs;
    public GameObject[]? monsterPrefabs;
    public GameObject[]? warriorPrefabs;
    public GameObject[]? zombiePrefabs;
    
    [Header("Debug")]
    public bool enableDebugLogs = true;
    
    private string currentCategory = "";
    private GameObject[]? currentPrefabs;
    
    void Start()
    {
        if (enableDebugLogs) Debug.Log("🎯 SimpleCharacterSelection: Starting...");
        
        SetupUI();
        LoadCharacterPrefabs();
        
        if (enableDebugLogs) Debug.Log("✅ SimpleCharacterSelection: Setup complete!");
    }
    
    void SetupUI()
    {
        // Find UI elements if not assigned
        if (bottomPanel == null)
        {
            // Try multiple ways to find BottomCharacterPanel
            bottomPanel = GameObject.Find("BottomCharacterPanel");

            if (bottomPanel == null)
            {
                // Try finding through Canvas
                GameObject canvas = GameObject.Find("UI Canvas");
                if (canvas != null)
                {
                    Transform panelTransform = canvas.transform.Find("BottomCharacterPanel");
                    if (panelTransform != null)
                    {
                        bottomPanel = panelTransform.gameObject;
                    }
                }
            }

            if (enableDebugLogs) Debug.Log($"🔍 BottomCharacterPanel found: {bottomPanel != null}");
            if (bottomPanel != null && enableDebugLogs)
            {
                Debug.Log($"✅ Panel state - Active: {bottomPanel.activeSelf}, Name: {bottomPanel.name}");
            }
        }
        
        if (bottomPanel != null)
        {
            if (panelTitle == null)
                panelTitle = bottomPanel.transform.Find("PanelTitle")?.GetComponent<Text>();
            
            if (modelContentArea == null)
                modelContentArea = bottomPanel.transform.Find("ModelContentArea")?.GetComponent<Transform>();
            
            if (closeButton == null)
                closeButton = bottomPanel.transform.Find("CloseButton")?.GetComponent<Button>();
            
            // Setup close button
            if (closeButton != null)
            {
                closeButton.onClick.RemoveAllListeners();
                closeButton.onClick.AddListener(ClosePanel);
                if (enableDebugLogs) Debug.Log("✅ Close button setup complete");
            }
        }
    }
    
    void LoadCharacterPrefabs()
    {
        // Try to get prefabs from BattleGameManager
        BattleGameManager battleManager = FindAnyObjectByType<BattleGameManager>();
        if (battleManager != null && battleManager.characterPrefabs != null)
        {
            if (enableDebugLogs) Debug.Log($"📦 Loading {battleManager.characterPrefabs.Length} prefabs from BattleGameManager");
            
            // Categorize prefabs by name
            List<GameObject> robots = new List<GameObject>();
            List<GameObject> monsters = new List<GameObject>();
            List<GameObject> warriors = new List<GameObject>();
            List<GameObject> zombies = new List<GameObject>();
            
            foreach (GameObject prefab in battleManager.characterPrefabs)
            {
                if (prefab == null) continue;
                
                string name = prefab.name.ToLower();
                if (name.Contains("robot"))
                    robots.Add(prefab);
                else if (name.Contains("monster") || name.Contains("quái"))
                    monsters.Add(prefab);
                else if (name.Contains("warrior") || name.Contains("chiến"))
                    warriors.Add(prefab);
                else if (name.Contains("zombie"))
                    zombies.Add(prefab);
                else
                    robots.Add(prefab); // Default to robot
            }
            
            robotPrefabs = robots.ToArray();
            monsterPrefabs = monsters.ToArray();
            warriorPrefabs = warriors.ToArray();
            zombiePrefabs = zombies.ToArray();
            
            if (enableDebugLogs)
            {
                Debug.Log($"📦 Categorized: {robotPrefabs.Length} robots, {monsterPrefabs.Length} monsters, {warriorPrefabs.Length} warriors, {zombiePrefabs.Length} zombies");
            }
        }
        else
        {
            Debug.LogWarning("⚠️ BattleGameManager or characterPrefabs not found!");
        }
    }
    
    public void ShowCategory(string categoryName)
    {
        if (enableDebugLogs) Debug.Log($"📂 ShowCategory called: {categoryName}");
        
        currentCategory = categoryName;
        
        // Get prefabs for category
        switch (categoryName.ToUpper())
        {
            case "ROBOT":
                currentPrefabs = robotPrefabs;
                break;
            case "QUÁI VẬT":
            case "MONSTER":
                currentPrefabs = monsterPrefabs;
                break;
            case "CHIẾN BINH":
            case "WARRIOR":
                currentPrefabs = warriorPrefabs;
                break;
            case "ZOMBIE":
                currentPrefabs = zombiePrefabs;
                break;
            default:
                currentPrefabs = robotPrefabs;
                break;
        }
        
        // Show panel
        if (bottomPanel != null)
        {
            bottomPanel.SetActive(true);
            
            // Update title
            if (panelTitle != null)
            {
                panelTitle.text = $"CHỌN NHÂN VẬT - {categoryName}";
            }
            
            // Create character buttons
            CreateCharacterButtons();
            
            if (enableDebugLogs) Debug.Log($"✅ Panel shown for {categoryName} with {currentPrefabs?.Length ?? 0} characters");
        }
        else
        {
            Debug.LogWarning("⚠️ BottomPanel not found!");
        }
    }
    
