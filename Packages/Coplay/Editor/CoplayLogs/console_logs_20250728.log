        for (int i = 0; i < currentPrefabs.Length; i++)
        {
            GameObject prefab = currentPrefabs[i];
            if (prefab == null) continue;
            
            // Create draggable icon
            GameObject iconObj = new GameObject($"CharacterIcon_{i}");
            iconObj.transform.SetParent(modelContentArea);
            
            // Add Image component for icon background
            Image iconImage = iconObj.AddComponent<Image>();
            iconImage.color = new Color(0.2f, 0.3f, 0.8f, 0.8f);
            
            // Add RectTransform
            RectTransform rectTransform = iconObj.GetComponent<RectTransform>();
            rectTransform.sizeDelta = new Vector2(100, 100);
            rectTransform.localScale = Vector3.one;
            
            // Add text label
            GameObject textObj = new GameObject("Text");
            textObj.transform.SetParent(iconObj.transform);
            Text iconText = textObj.AddComponent<Text>();
            iconText.text = prefab.name;
            iconText.font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
            iconText.fontSize = 12;
            iconText.color = Color.white;
            iconText.alignment = TextAnchor.MiddleCenter;
            
            RectTransform textRect = textObj.GetComponent<RectTransform>();
            textRect.anchorMin = Vector2.zero;
            textRect.anchorMax = Vector2.one;
            textRect.sizeDelta = Vector2.zero;
            textRect.anchoredPosition = Vector2.zero;
            textRect.localScale = Vector3.one;
            
            // Add DraggableCharacterIcon component
            DraggableCharacterIcon dragComponent = iconObj.AddComponent<DraggableCharacterIcon>();
            dragComponent.characterPrefab = prefab;
            dragComponent.originalParent = modelContentArea;
        }
        
        if (enableDebugLogs) Debug.Log($"✅ Created {currentPrefabs.Length} draggable character icons");
