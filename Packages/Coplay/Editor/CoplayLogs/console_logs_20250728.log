2025-07-28 21:47:09.557 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/CheckSpawnedCharacterTeams.cs, content: using UnityEngine;

public class CheckSpawnedCharacterTeams : MonoBehaviour
{
    public static void Execute()
    {
        Debug.Log("=== CHECKING SPAWNED CHARACTER TEAMS ===");
        
        // Find all RagdollCharacter (spawned characters)
        RagdollCharacter[] allCharacters = FindObjectsByType<RagdollCharacter>(FindObjectsSortMode.None);
        Debug.Log($"Found {allCharacters.Length} spawned characters");
        
        foreach (RagdollCharacter character in allCharacters)
        {
            Debug.Log($"Character: {character.name}");
            Debug.Log($"  Team ID: {character.teamId}");
            Debug.Log($"  Position: {character.transform.position}");
            
            // Check visual indicators (material color)
            Renderer characterRenderer = character.GetComponent<Renderer>();
            if (characterRenderer != null && characterRenderer.material != null)
            {
                Debug.Log($"  Material color: {characterRenderer.material.color}");
            }
            
            // Check if there are child renderers
            Renderer[] childRenderers = character.GetComponentsInChildren<Renderer>();
            Debug.Log($"  Total renderers (including children): {childRenderers.Length}");
            
            foreach (Renderer renderer in childRenderers)
            {
                if (renderer.material != null)
                {
                    Debug.Log($"    Renderer material: {renderer.material.name}, Color: {renderer.material.color}");
                }
            }
        }
        
        // Check current team selection
        BattleGameManager gameManager = FindAnyObjectByType<BattleGameManager>();
        if (gameManager != null)
        {
            Debug.Log($"Current selected team: {gameManager.GetSelectedTeam()}");
        }
        
        Debug.Log("=== CHARACTER TEAM CHECK COMPLETE ===");
    }
}
