2025-07-28 21:35:50.618 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/ActivateBottomPanel.cs, content: using UnityEngine;

public static class ActivateBottomPanel
{
    [UnityEditor.MenuItem("Tools/Activate Bottom Panel")]
    public static void Execute()
    {
        GameObject bottomPanel = GameObject.Find("UI Canvas/BottomCharacterPanel");
        if (bottomPanel != null)
        {
            bottomPanel.SetActive(true);
            Debug.Log("✅ Activated BottomCharacterPanel");
        }
        else
        {
            Debug.LogError("❌ BottomCharacterPanel not found!");
        }
    }
}
