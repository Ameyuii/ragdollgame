public class TestZombieUI
{
    public static void Execute()
    {
        Debug.Log("🔍 Testing Zombie UI generation...");
        
        // Find AutoUIGenerator
        GameObject autoUIGenObj = GameObject.Find("AutoUIGenerator");
        if (autoUIGenObj == null)
        {
            Debug.LogError("❌ AutoUIGenerator not found!");
            return;
        }
        
        AutoUIGenerator autoUIGen = autoUIGenObj.GetComponent<AutoUIGenerator>();
        if (autoUIGen == null)
        {
            Debug.LogError("❌ AutoUIGenerator component not found!");
            return;
        }
        
        Debug.Log("🔍 Calling SelectCategory('zombie') directly...");
        
        // Call SelectCategory directly
        autoUIGen.SelectCategory("zombie");
        
        // Check if any character buttons were created
        GameObject modelContainer = GameObject.Find("ModelContentArea");
        if (modelContainer != null)
        {
            int buttonCount = 0;
            for (int i = 0; i < modelContainer.transform.childCount; i++)
            {
                GameObject child = modelContainer.transform.GetChild(i).gameObject;
                if (child.name.Contains("CharacterButton"))
                {
                    buttonCount++;
                    Debug.Log($"✅ Found character button: {child.name}");
                }
            }
            Debug.Log($"📊 Total character buttons in UI: {buttonCount}");
        }
        
        Debug.Log("🔍 Zombie UI test completed!");
    }
}
