2025-07-29 09:43:44.461 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/Utils/SimpleButtonTest.cs, content: using UnityEngine;
using System.Linq;

public class SimpleButtonTest : MonoBehaviour
{
    public static void Execute()
    {
        Debug.Log("🧪 Simple Button Test...");
        
        // Count before
        var beforeButtons = FindObjectsOfType<GameObject>()
            .Where(go => go != null && go.name.Contains("CharacterButton"))
            .ToArray();
        
        Debug.Log($"📊 Before: {beforeButtons.Length} CharacterButtons");
        
        // Clear manually
        foreach (var btn in beforeButtons)
        {
            if (btn != null)
            {
                DestroyImmediate(btn);
            }
        }
        
        // Generate new UI
        AutoUIGenerator autoUIGen = FindObjectOfType<AutoUIGenerator>();
        if (autoUIGen != null)
        {
            var categoryField = typeof(AutoUIGenerator).GetField("currentCategory", 
                System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
            if (categoryField != null)
            {
                categoryField.SetValue(autoUIGen, "temp");
            }
            
            autoUIGen.SelectCategory("robot");
        }
        
        // Count after
        var afterButtons = FindObjectsOfType<GameObject>()
            .Where(go => go != null && go.name.Contains("CharacterButton"))
            .ToArray();
        
        Debug.Log($"📊 After: {afterButtons.Length} CharacterButtons");
        
        Debug.Log("✅ Test completed!");
    }
}
