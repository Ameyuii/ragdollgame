2025-07-29 09:43:08.786 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/Utils/TestButtonClearing.cs, content: using UnityEngine;
using System.Linq;

public class TestButtonClearing : MonoBehaviour
{
    public static void Execute()
    {
        Debug.Log("🧪 Testing Button Clearing...");
        
        AutoUIGenerator autoUIGen = FindObjectOfType<AutoUIGenerator>();
        if (autoUIGen == null)
        {
            Debug.LogError("❌ AutoUIGenerator not found!");
            return;
        }
        
        // Clear all existing buttons first
        var allCharacterButtons = FindObjectsOfType<GameObject>()
            .Where(go => go.name.Contains("CharacterButton"))
            .ToArray();
        
        Debug.Log($"🔍 Found {allCharacterButtons.Length} existing CharacterButtons");
        
        foreach (var btn in allCharacterButtons)
        {
            DestroyImmediate(btn);
            Debug.Log($"🗑️ Destroyed: {btn.name}");
        }
        
        // Now test UI generation
        System.Reflection.FieldInfo categoryField = typeof(AutoUIGenerator).GetField("currentCategory", 
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        if (categoryField != null)
        {
            categoryField.SetValue(autoUIGen, "temp");
        }
        
        autoUIGen.SelectCategory("robot");
        
        // Check final count
        var finalButtons = FindObjectsOfType<GameObject>()
            .Where(go => go.name.Contains("CharacterButton"))
            .ToArray();
        
        Debug.Log($"✅ Final CharacterButtons count: {finalButtons.Length}");
        foreach (var btn in finalButtons)
        {
            Debug.Log($"  → {btn.name} (Parent: {btn.transform.parent?.name})");
        }
    }
}
