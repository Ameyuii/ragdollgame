                    Debug.Log($"🔍 Character: {character.CharacterID} ({character.DisplayName})");
                    Debug.Log($"   - Category: {character.CategoryID}");
                    Debug.Log($"   - BasePrefab: {(character.BasePrefab != null ? character.BasePrefab.name : "NULL")}");
                    Debug.Log($"   - UIIcon: {(character.UIIcon != null ? character.UIIcon.name : "NULL")}");
                }
                else
                {
                    Debug.LogWarning("⚠️ Found null character in quaivat category!");
                }
            }
        }
        
        Debug.Log("🔍 Character details test completed!");
    }
}
