2025-07-29 00:08:46.861 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/FixCharacterMaterials.cs, content: using UnityEngine;

public class FixCharacterMaterials : MonoBehaviour
{
    public static void Execute()
    {
        // Tìm nhân vật đã spawn
        GameObject spawnedCharacter = GameObject.Find("SpawnedCharacters/BattleCharacter (Team 1)");
        if (spawnedCharacter == null)
        {
            Debug.LogError("Không tìm thấy nhân vật đã spawn!");
            return;
        }

        // Gán materials cho từng phần của nhân vật
        AssignMaterialToChild(spawnedCharacter, "SK_Military_Backpack1", "Assets/Military/Materials/Backpack1_Skin1.mat");
        AssignMaterialToChild(spawnedCharacter, "SK_Military_Boots3", "Assets/Military/Materials/Boots3_Skin1.mat");
        AssignMaterialToChild(spawnedCharacter, "SK_Military_Cap1", "Assets/Military/Materials/Cap1_Skin1.mat");
        AssignMaterialToChild(spawnedCharacter, "SK_Military_Head1", "Assets/Military/Materials/Head1.mat");
        AssignMaterialToChild(spawnedCharacter, "SK_Military_Male_Arms1", "Assets/Military/Materials/Hands1_Skin1.mat");
        AssignMaterialToChild(spawnedCharacter, "SK_Military_Pants2", "Assets/Military/Materials/Pants2_Skin1.mat");
        AssignMaterialToChild(spawnedCharacter, "SK_Military_Shirt3", "Assets/Military/Materials/Shirt3_Skin1.mat");

        Debug.Log("Đã gán materials cho nhân vật spawn!");
    }

    private static void AssignMaterialToChild(GameObject parent, string childName, string materialPath)
    {
        Transform childTransform = parent.transform.Find(childName);
        if (childTransform == null)
        {
            Debug.LogWarning($"Không tìm thấy child object: {childName}");
            return;
        }

        SkinnedMeshRenderer renderer = childTransform.GetComponent<SkinnedMeshRenderer>();
        if (renderer == null)
        {
            Debug.LogWarning($"Không tìm thấy SkinnedMeshRenderer trên: {childName}");
            return;
        }

        Material material = UnityEditor.AssetDatabase.LoadAssetAtPath<Material>(materialPath);
        if (material == null)
        {
            Debug.LogWarning($"Không tìm thấy material: {materialPath}");
            return;
        }

        renderer.material = material;
        Debug.Log($"Đã gán material {materialPath} cho {childName}");
    }
}
