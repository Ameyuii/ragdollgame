    [ContextMenu("🎨 Generate UI")]
    public void GenerateUI()
    {
        if (!uiInitialized && !ValidateReferences()) return;

        Debug.Log($"🎨 Generating UI for category: {currentCategory} (System: {(useNewSystem ? "New" : "Old")})");

