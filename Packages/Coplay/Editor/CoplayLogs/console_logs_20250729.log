2025-07-29 10:27:35.509 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/TestUIGeneration.cs, content: using UnityEngine;
using System.Reflection;

public class TestUIGeneration
{
    public static void Execute()
    {
        Debug.Log("🔍 Testing UI generation flow...");
        
        // Find AutoUIGenerator
        GameObject autoUIGenObj = GameObject.Find("AutoUIGenerator");
        if (autoUIGenObj == null)
        {
            Debug.LogError("❌ AutoUIGenerator not found!");
            return;
        }
        
        AutoUIGenerator autoUIGen = autoUIGenObj.GetComponent<AutoUIGenerator>();
        if (autoUIGen == null)
        {
            Debug.LogError("❌ AutoUIGenerator component not found!");
            return;
        }
        
        // Get current characters using reflection
        FieldInfo currentCharsField = typeof(AutoUIGenerator).GetField("currentCharacters", 
            BindingFlags.NonPublic | BindingFlags.Instance);
        
        if (currentCharsField != null)
        {
            var currentCharacters = currentCharsField.GetValue(autoUIGen) as System.Collections.Generic.List<CharacterDefinition>;
            Debug.Log($"🔍 Current characters count: {(currentCharacters?.Count ?? 0)}");
            
            if (currentCharacters != null)
            {
                for (int i = 0; i < currentCharacters.Count; i++)
                {
                    var character = currentCharacters[i];
                    Debug.Log($"   {i}: {character?.CharacterID} ({character?.DisplayName}) - Prefab: {(character?.BasePrefab != null ? character.BasePrefab.name : "NULL")}");
                }
            }
        }
        
        // Force call GenerateUI
        Debug.Log("🔍 Calling GenerateUI manually...");
        autoUIGen.GenerateUI();
        
        Debug.Log("🔍 UI generation test completed!");
    }
}
