2025-07-29 10:20:58.979 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/TestQuaiVat.cs, content: using UnityEngine;
using System.Linq;

public class TestQuaiVat
{
    public static void Execute()
    {
        Debug.Log("🔍 Testing QuaiVat characters...");
        
        // Test CharacterDatabase
        GameDatabase gameDB = GameDatabase.Instance;
        if (gameDB?.characterDatabase != null)
        {
            var quaivatChars = gameDB.characterDatabase.GetCharactersByCategory("quaivat");
            Debug.Log($"📊 Found {quaivatChars.Count} characters in 'quaivat' category from CharacterDatabase");
            
            foreach (var character in quaivatChars)
            {
                if (character != null)
                {
                    Debug.Log($"   • {character.CharacterID} ({character.DisplayName}) - Category: {character.CategoryID}");
                }
            }
            
            // List all categories in database
            var allCategories = gameDB.characterDatabase.GetAllCategories();
            Debug.Log($"📋 All categories in CharacterDatabase:");
            foreach (var category in allCategories)
            {
                Debug.Log($"   - {category.categoryID}: {category.displayName}");
            }
        }
        
        // Test CharacterRegistry as fallback
        UnifiedGameManager ugm = UnifiedGameManager.Instance;
        if (ugm != null)
        {
            var registryChars = ugm.GetCharactersByCategory("QUAIVAT");
            Debug.Log($"📊 Found {registryChars.Count} characters in 'QUAIVAT' category from CharacterRegistry");
            
            foreach (var character in registryChars)
            {
                Debug.Log($"   • {character.id} ({character.displayName}) - Category: {character.category}");
            }
        }
        
        Debug.Log("🔍 QuaiVat test completed!");
    }
}
