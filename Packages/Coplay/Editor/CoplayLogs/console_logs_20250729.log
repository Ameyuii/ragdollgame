2025-07-29 09:32:42.779 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/Utils/ForceDirectUIGeneration.cs, content: using UnityEngine;

public class ForceDirectUIGeneration : MonoBehaviour
{
    public static void Execute()
    {
        Debug.Log("🔧 Force Direct UI Generation...");
        
        AutoUIGenerator autoUIGen = FindObjectOfType<AutoUIGenerator>();
        if (autoUIGen == null)
        {
            Debug.LogError("❌ AutoUIGenerator not found!");
            return;
        }
        
        // Set current category to something else first
        System.Reflection.FieldInfo categoryField = typeof(AutoUIGenerator).GetField("currentCategory", 
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        if (categoryField != null)
        {
            categoryField.SetValue(autoUIGen, "other");
        }
        
        // Now select robot category - this will trigger GenerateUI
        autoUIGen.SelectCategory("robot");
        
        Debug.Log("✅ Force direct UI generation completed!");
    }
}
