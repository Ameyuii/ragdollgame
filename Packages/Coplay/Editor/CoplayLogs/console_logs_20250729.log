2025-07-29 09:30:59.770 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/Utils/ForceUIGeneration.cs, content: using UnityEngine;

public class ForceUIGeneration : MonoBehaviour
{
    public static void Execute()
    {
        Debug.Log("🔧 Force UI Generation...");
        
        AutoUIGenerator autoUIGen = FindObjectOfType<AutoUIGenerator>();
        if (autoUIGen == null)
        {
            Debug.LogError("❌ AutoUIGenerator not found!");
            return;
        }
        
        // Set category to robot
        autoUIGen.SelectCategory("robot");
        
        Debug.Log("✅ Force UI generation completed!");
    }
}
