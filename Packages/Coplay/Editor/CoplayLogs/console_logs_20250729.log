2025-07-29 09:30:17.726 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/Utils/CharacterDatabaseDebug.cs, content: using UnityEngine;
using System.Linq;

public class CharacterDatabaseDebug : MonoBehaviour
{
    public static void Execute()
    {
        Debug.Log("🔍 CharacterDatabase Debug:");
        
        // Load CharacterDatabase directly
        CharacterDatabase db = UnityEngine.Resources.Load<CharacterDatabase>("CharacterDatabase");
        if (db == null)
        {
            Debug.LogError("❌ CharacterDatabase not found in Resources!");
            return;
        }
        
        Debug.Log($"📊 Database loaded successfully! Version: {db.databaseVersion}");
        Debug.Log($"📊 Total characters: {db.characters.Count}");
        Debug.Log($"📊 Total categories: {db.categories.Count}");
        
        // List all characters
        foreach (var character in db.characters)
        {
            if (character != null)
            {
                Debug.Log($"  • {character.CharacterID} ({character.DisplayName}) - Category: {character.CategoryID}");
            }
        }
        
        // List all categories
        foreach (var category in db.categories)
        {
            if (category != null)
            {
                Debug.Log($"  📂 {category.categoryID} - {category.displayName}");
            }
        }
        
        // Test specific category
        var robotCharacters = db.GetCharactersByCategory("robot");
        Debug.Log($"🤖 Robot characters found: {robotCharacters.Count}");
        foreach (var character in robotCharacters)
        {
            Debug.Log($"    → {character.CharacterID}: {character.DisplayName}");
        }
        
        // Test GameDatabase
        GameDatabase gameDB = GameDatabase.Instance;
        if (gameDB != null)
        {
            Debug.Log($"🎮 GameDatabase.enableNewSystem: {gameDB.enableNewSystem}");
            Debug.Log($"🎮 GameDatabase.characterDatabase: {(gameDB.characterDatabase != null ? "✅" : "❌")}");
        }
    }
}
