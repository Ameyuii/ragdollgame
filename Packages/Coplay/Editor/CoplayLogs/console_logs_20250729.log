    {
        // Get all characters
        RefreshCharacterList();
        
        // Configure AI systems based on primary choice
        ConfigureAISystems();
        
        // Start coordination monitoring
        InvokeRepeating(nameof(MonitorAISystems), 1f, coordinationUpdateInterval);
    }
    
