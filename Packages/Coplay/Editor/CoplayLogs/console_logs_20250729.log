2025-07-29 09:44:30.724 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/Utils/TestCategorySwitching.cs, content: using UnityEngine;
using System.Linq;

public class TestCategorySwitching : MonoBehaviour
{
    public static void Execute()
    {
        Debug.Log("🔄 Testing Category Switching...");
        
        AutoUIGenerator autoUIGen = FindObjectOfType<AutoUIGenerator>();
        if (autoUIGen == null)
        {
            Debug.LogError("❌ AutoUIGenerator not found!");
            return;
        }
        
        string[] categories = { "robot", "chienbinh", "quaivat", "zombie" };
        
        foreach (string category in categories)
        {
            Debug.Log($"🔍 Testing category: {category}");
            
            // Force change to ensure SelectCategory works
            var categoryField = typeof(AutoUIGenerator).GetField("currentCategory", 
                System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
            if (categoryField != null)
            {
                categoryField.SetValue(autoUIGen, "temp");
            }
            
            // Select category
            autoUIGen.SelectCategory(category);
            
            // Count buttons
            var buttons = FindObjectsOfType<GameObject>()
                .Where(go => go != null && go.name.Contains("CharacterButton"))
                .ToArray();
            
            Debug.Log($"  📊 {category}: {buttons.Length} buttons found");
            
            foreach (var btn in buttons)
            {
                Debug.Log($"    → {btn.name}");
            }
        }
        
        Debug.Log("✅ Category switching test completed!");
    }
}
