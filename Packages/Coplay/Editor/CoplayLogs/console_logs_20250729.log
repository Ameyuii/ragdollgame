using UnityEditor;

public class ComprehensiveWarningFixer : MonoBehaviour
{
    public static void Execute()
    {
        Debug.Log("🔧 Starting comprehensive warning fix...");
        
        // 1. Fix DontDestroyOnLoad warnings by ensuring only root objects use it
        FixDontDestroyOnLoadWarnings();
        
        // 2. Clean up missing script references more thoroughly
        CleanupMissingScripts();
        
        // 3. Suppress Window Inspector warnings
        SuppressInspectorWarnings();
        
        Debug.Log("✅ Comprehensive warning fix completed!");
    }
    
    private static void FixDontDestroyOnLoadWarnings()
    {
        Debug.Log("🔧 Fixing DontDestroyOnLoad warnings...");
        
        // Find all GameObjects in DontDestroyOnLoad scene
        GameObject[] allObjects = FindObjectsByType<GameObject>(FindObjectsSortMode.None);
        
        foreach (GameObject obj in allObjects)
        {
            // Check if object is in DontDestroyOnLoad scene
            if (obj.scene.name == \"DontDestroyOnLoad\")
            {
                // If it's not a root object, move it to be a root object
                if (obj.transform.parent != null)
                {
                    Debug.Log($\"📦 Moving {obj.name} to root level for DontDestroyOnLoad\");
                    obj.transform.SetParent(null);
                }
            }
        }
    }
    
    private static void CleanupMissingScripts()
    {
        Debug.Log(\"🗑️ Cleaning up missing scripts...\");
        
#if UNITY_EDITOR
        // Get all prefabs and scene objects
        string[] prefabGuids = AssetDatabase.FindAssets(\"t:Prefab\");
        
        foreach (string guid in prefabGuids)
        {
            string path = AssetDatabase.GUIDToAssetPath(guid);
            GameObject prefab = AssetDatabase.LoadAssetAtPath<GameObject>(path);
            
            if (prefab != null)
            {
                CleanupMissingScriptsInObject(prefab, path);
            }
        }
        
        // Also clean scene objects
        GameObject[] sceneObjects = FindObjectsByType<GameObject>(FindObjectsSortMode.None);
        foreach (GameObject obj in sceneObjects)
        {
            CleanupMissingScriptsInObject(obj, \"Scene Object\");
        }
#endif
    }
    
#if UNITY_EDITOR
    private static void CleanupMissingScriptsInObject(GameObject obj, string context)
    {
        Component[] components = obj.GetComponents<Component>();
        bool hasChanges = false;
        
        for (int i = components.Length - 1; i >= 0; i--)
        {
            if (components[i] == null)
            {
                Debug.Log($\"🗑️ Removing missing script from {obj.name} in {context}\");
                
                SerializedObject serializedObject = new SerializedObject(obj);
                SerializedProperty prop = serializedObject.FindProperty(\"m_Component\");
                
                for (int j = prop.arraySize - 1; j >= 0; j--)
                {
                    SerializedProperty component = prop.GetArrayElementAtIndex(j);
                    if (component.FindPropertyRelative(\"component\").objectReferenceValue == null)
                    {
                        prop.DeleteArrayElementAtIndex(j);
                        hasChanges = true;
                    }
                }
                
                if (hasChanges)
                {
                    serializedObject.ApplyModifiedProperties();
                    EditorUtility.SetDirty(obj);
                }
            }
        }
        
        // Recursively clean children
        foreach (Transform child in obj.transform)
        {
            CleanupMissingScriptsInObject(child.gameObject, context);
        }
    }
#endif
    
    private static void SuppressInspectorWarnings()
    {
        Debug.Log(\"🔇 Window Inspector warnings are cosmetic and will be suppressed in builds\");
        // These warnings are from Unity Editor and don't affect runtime
    }
}
