public class TestAutoUIRefs
{
    public static void Execute()
    {
        Debug.Log("🔍 Testing AutoUIGenerator references...");
        
        // Find AutoUIGenerator
        GameObject autoUIGenObj = GameObject.Find("AutoUIGenerator");
        if (autoUIGenObj == null)
        {
            Debug.LogError("❌ AutoUIGenerator not found!");
            return;
        }
        
        AutoUIGenerator autoUIGen = autoUIGenObj.GetComponent<AutoUIGenerator>();
        if (autoUIGen == null)
        {
            Debug.LogError("❌ AutoUIGenerator component not found!");
            return;
        }
        
        // Check references
        Debug.Log($"🔍 CharacterDatabase: {(autoUIGen.characterDatabase != null ? "OK" : "NULL")}");
        Debug.Log($"🔍 UnifiedGameManager: {(autoUIGen.unifiedGameManager != null ? "OK" : "NULL")}");
        Debug.Log($"🔍 ModelSelectionPanel: {(autoUIGen.modelSelectionPanel != null ? "OK" : "NULL")}");
        Debug.Log($"🔍 ModelContainer: {(autoUIGen.modelContainer != null ? "OK" : "NULL")}");
        Debug.Log($"🔍 CategoryTitleText: {(autoUIGen.categoryTitleText != null ? "OK" : "NULL")}");
        Debug.Log($"🔍 CharacterButtonPrefab: {(autoUIGen.characterButtonPrefab != null ? "OK" : "NULL")}");
        
        // Try to find missing references
        if (autoUIGen.modelContainer == null)
        {
            GameObject modelContainer = GameObject.Find("ModelContentArea");
            Debug.Log($"🔍 Found ModelContentArea: {(modelContainer != null ? "YES" : "NO")}");
        }
        
        if (autoUIGen.unifiedGameManager == null)
        {
            UnifiedGameManager ugm = UnifiedGameManager.Instance;
            Debug.Log($"🔍 Found UnifiedGameManager.Instance: {(ugm != null ? "YES" : "NO")}");
        }
        
        Debug.Log("🔍 AutoUIGenerator references test completed!");
    }
}
