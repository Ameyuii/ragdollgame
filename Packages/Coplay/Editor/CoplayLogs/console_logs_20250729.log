2025-07-29 10:35:13.422 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/TestZombieChars.cs, content: using UnityEngine;

public class TestZombieChars
{
    public static void Execute()
    {
        Debug.Log("🔍 Testing Zombie characters...");
        
        GameDatabase gameDB = GameDatabase.Instance;
        if (gameDB?.characterDatabase != null)
        {
            var zombieChars = gameDB.characterDatabase.GetCharactersByCategory("zombie");
            Debug.Log($"📊 Found {zombieChars.Count} characters in 'zombie' category from CharacterDatabase");
            
            foreach (var character in zombieChars)
            {
                if (character != null)
                {
                    Debug.Log($"🔍 Character: {character.CharacterID} ({character.DisplayName})");
                    Debug.Log($"   - Category: {character.CategoryID}");
                    Debug.Log($"   - BasePrefab: {(character.BasePrefab != null ? character.BasePrefab.name : "NULL")}");
                    Debug.Log($"   - UIIcon: {(character.UIIcon != null ? character.UIIcon.name : "NULL")}");
                }
                else
                {
                    Debug.LogWarning("⚠️ Found null character in zombie category!");
                }
            }
        }
        
        Debug.Log("🔍 Zombie characters test completed!");
    }
}
