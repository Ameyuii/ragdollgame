2025-07-29 09:41:53.048 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/Utils/DebugCategoryButtons.cs, content: using UnityEngine;
using UnityEngine.UI;
using System.Linq;

public class DebugCategoryButtons : MonoBehaviour
{
    public static void Execute()
    {
        Debug.Log("🔍 Debug Category Buttons:");
        
        // Count all character buttons before any action
        var allCharacterButtons = FindObjectsOfType<GameObject>()
            .Where(go => go.name.Contains("CharacterButton"))
            .ToList();
        
        Debug.Log($"📊 Total CharacterButtons found: {allCharacterButtons.Count}");
        foreach (var btn in allCharacterButtons)
        {
            Debug.Log($"  → {btn.name} (Parent: {btn.transform.parent?.name})");
        }
        
        // Test each category button
        AutoUIGenerator autoUIGen = FindObjectOfType<AutoUIGenerator>();
        if (autoUIGen == null)
        {
            Debug.LogError("❌ AutoUIGenerator not found!");
            return;
        }
        
        // Get current buttons count from AutoUIGenerator
        var currentButtonsField = typeof(AutoUIGenerator).GetField("currentButtons", 
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        
        if (currentButtonsField != null)
        {
            var currentButtons = (System.Collections.Generic.List<GameObject>)currentButtonsField.GetValue(autoUIGen);
            Debug.Log($"📊 AutoUIGenerator.currentButtons count: {currentButtons.Count}");
            
            foreach (var btn in currentButtons)
            {
                if (btn != null)
                    Debug.Log($"  → {btn.name}");
                else
                    Debug.Log($"  → NULL button");
            }
        }
        
        // Test clicking Robot button multiple times
        Debug.Log("🔄 Testing Robot button clicks...");
        
        for (int i = 0; i < 3; i++)
        {
            // Force change category to trigger UI generation
            var categoryField = typeof(AutoUIGenerator).GetField("currentCategory", 
                System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
            if (categoryField != null)
            {
                categoryField.SetValue(autoUIGen, $"temp{i}");
            }
            
            autoUIGen.SelectCategory("robot");
            
            // Count buttons after each click
            var buttonsAfterClick = FindObjectsOfType<GameObject>()
                .Where(go => go.name.Contains("CharacterButton"))
                .ToList();
            
            Debug.Log($"  Click {i + 1}: {buttonsAfterClick.Count} CharacterButtons found");
        }
        
        Debug.Log("✅ Debug completed!");
    }
}
