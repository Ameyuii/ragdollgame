2025-07-29 10:23:13.512 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/TestButtonSetup.cs, content: using UnityEngine;
using UnityEngine.UI;

public class TestButtonSetup
{
    public static void Execute()
    {
        Debug.Log("🔍 Testing button setup...");
        
        // Find AutoUIGenerator
        GameObject autoUIGenObj = GameObject.Find("AutoUIGenerator");
        if (autoUIGenObj == null)
        {
            Debug.LogError("❌ AutoUIGenerator not found!");
            return;
        }
        
        AutoUIGenerator autoUIGen = autoUIGenObj.GetComponent<AutoUIGenerator>();
        if (autoUIGen == null)
        {
            Debug.LogError("❌ AutoUIGenerator component not found!");
            return;
        }
        
        // Find MonsterButton manually and setup listener
        GameObject buttonObj = GameObject.Find("MonsterButton");
        if (buttonObj != null)
        {
            Button button = buttonObj.GetComponent<Button>();
            if (button != null)
            {
                Debug.Log($"🔍 Before setup - listeners count: {button.onClick.GetPersistentEventCount()}");
                
                // Add listener manually
                button.onClick.RemoveAllListeners();
                button.onClick.AddListener(() => {
                    Debug.Log("🖱️ MonsterButton clicked manually!");
                    autoUIGen.SelectCategory("quaivat");
                });
                
                Debug.Log($"🔍 After setup - listeners count: {button.onClick.GetPersistentEventCount()}");
                Debug.Log("✅ MonsterButton listener added manually!");
                
                // Test click
                button.onClick.Invoke();
            }
        }
        
        Debug.Log("🔍 Button setup test completed!");
    }
}
