2025-07-29 09:28:32.193 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/Utils/AutoUIGeneratorFix.cs, content: using UnityEngine;

public class AutoUIGeneratorFix : MonoBehaviour
{
    public static void Execute()
    {
        // Find AutoUIGenerator và force re-initialization
        AutoUIGenerator autoUIGen = FindObjectOfType<AutoUIGenerator>();
        if (autoUIGen != null)
        {
            Debug.Log("🔧 Force re-initializing AutoUIGenerator...");
            
            // Reset initialization flag
            System.Reflection.FieldInfo uiInitializedField = typeof(AutoUIGenerator).GetField("uiInitialized", 
                System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
            if (uiInitializedField != null)
            {
                uiInitializedField.SetValue(autoUIGen, false);
            }
            
            // Call private InitializeUI method
            System.Reflection.MethodInfo initMethod = typeof(AutoUIGenerator).GetMethod("InitializeUI", 
                System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
            if (initMethod != null)
            {
                initMethod.Invoke(autoUIGen, null);
                Debug.Log("✅ AutoUIGenerator re-initialized successfully!");
            }
            
            // Force generate UI
            autoUIGen.GenerateUI();
            Debug.Log("🎨 UI generation triggered!");
        }
        else
        {
            Debug.LogError("❌ AutoUIGenerator not found!");
        }
    }
}
