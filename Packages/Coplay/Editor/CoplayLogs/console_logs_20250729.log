2025-07-29 10:28:55.582 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/TestMonsterButtonFinal.cs, content: using UnityEngine;
using UnityEngine.UI;

public class TestMonsterButtonFinal
{
    public static void Execute()
    {
        Debug.Log("🔍 Testing MonsterButton final...");
        
        // Find MonsterButton
        GameObject buttonObj = GameObject.Find("MonsterButton");
        if (buttonObj == null)
        {
            Debug.LogError("❌ MonsterButton not found!");
            return;
        }
        
        Button button = buttonObj.GetComponent<Button>();
        if (button == null)
        {
            Debug.LogError("❌ Button component not found!");
            return;
        }
        
        Debug.Log($"🔍 MonsterButton listeners: {button.onClick.GetPersistentEventCount()}");
        
        // Click the button
        button.onClick.Invoke();
        
        // Check if UI was generated
        GameObject modelContainer = GameObject.Find("ModelContentArea");
        if (modelContainer != null)
        {
            int buttonCount = 0;
            for (int i = 0; i < modelContainer.transform.childCount; i++)
            {
                GameObject child = modelContainer.transform.GetChild(i).gameObject;
                if (child.name.Contains("CharacterButton"))
                {
                    buttonCount++;
                    Debug.Log($"✅ Found character button: {child.name}");
                }
            }
            Debug.Log($"📊 Total character buttons after click: {buttonCount}");
        }
        
        Debug.Log("🔍 MonsterButton final test completed!");
    }
}
