2025-07-29 09:45:39.403 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/Utils/CheckCharacterPrefabs.cs, content: using UnityEngine;

public class CheckCharacterPrefabs : MonoBehaviour
{
    public static void Execute()
    {
        Debug.Log("🔍 Checking Character Prefabs...");
        
        CharacterDatabase db = UnityEngine.Resources.Load<CharacterDatabase>("CharacterDatabase");
        if (db == null)
        {
            Debug.LogError("❌ CharacterDatabase not found!");
            return;
        }
        
        foreach (var character in db.characters)
        {
            if (character != null)
            {
                Debug.Log($"📊 {character.CharacterID} ({character.DisplayName}):");
                Debug.Log($"  📂 Category: {character.CategoryID}");
                Debug.Log($"  🎮 BasePrefab: {(character.BasePrefab != null ? "✅ Assigned" : "❌ NULL")}");
                
                if (character.BasePrefab != null)
                {
                    Debug.Log($"    → Prefab path: {UnityEditor.AssetDatabase.GetAssetPath(character.BasePrefab)}");
                }
            }
        }
        
        Debug.Log("✅ Prefab check completed!");
    }
}
