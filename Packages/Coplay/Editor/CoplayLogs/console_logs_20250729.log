2025-07-29 09:33:56.132 +07:00 [INF] Func: write_to_file Args: path: Assets/Scripts/Utils/TestAllCategories.cs, content: using UnityEngine;

public class TestAllCategories : MonoBehaviour
{
    public static void Execute()
    {
        Debug.Log("🧪 Testing all categories...");
        
        AutoUIGenerator autoUIGen = FindObjectOfType<AutoUIGenerator>();
        if (autoUIGen == null)
        {
            Debug.LogError("❌ AutoUIGenerator not found!");
            return;
        }
        
        // Test all categories
        string[] categories = { "robot", "chienbinh", "quaivat", "zombie" };
        
        foreach (string category in categories)
        {
            Debug.Log($"🔍 Testing category: {category}");
            
            // Force change category
            System.Reflection.FieldInfo categoryField = typeof(AutoUIGenerator).GetField("currentCategory", 
                System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
            if (categoryField != null)
            {
                categoryField.SetValue(autoUIGen, "temp");
            }
            
            // Select category
            autoUIGen.SelectCategory(category);
            
            // Wait a bit
            System.Threading.Thread.Sleep(500);
        }
        
        Debug.Log("✅ All categories tested!");
    }
}
